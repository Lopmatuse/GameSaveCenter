root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,sln}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,xaml,xml}]
indent_style = space
indent_size = 2

# Windows PowerShell 5.1 interprets a UTF-8 script without a BOM using the
# active ANSI code page.  These scripts contain Chinese diagnostic text, so a
# BOM is required for the documented powershell.exe fallback to parse them.
[*.ps1]
charset = utf-8-bom

[*.cmd]
end_of_line = crlf
