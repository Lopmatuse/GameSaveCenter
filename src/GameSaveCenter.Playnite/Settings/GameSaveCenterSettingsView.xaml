<UserControl x:Class="GameSaveCenter.Playnite.Settings.GameSaveCenterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:GameSaveCenter.Contracts;assembly=GameSaveCenter.Contracts"
             xmlns:settings="clr-namespace:GameSaveCenter.Playnite.Settings"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#20000000" BlurRadius="16" ShadowDepth="2" Opacity="0.3"/></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource GscTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource GscComboBox}"/>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource GscComboBoxItem}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource GscCheckBox}"/>
        <Style x:Key="SettingsActionButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GscAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GscAccentBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource GscBackdropBrush}" ClipToBounds="True">
        <Grid x:Name="SettingsAmbientLayer" IsHitTestVisible="False">
            <Ellipse Width="330" Height="330" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-95,-120,0,0" Fill="#247C5CFC"><Ellipse.Effect><BlurEffect Radius="84"/></Ellipse.Effect></Ellipse>
            <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-120" Fill="#180A84FF"><Ellipse.Effect><BlurEffect Radius="92"/></Ellipse.Effect></Ellipse>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SettingsShell" Opacity="0" Margin="28,22,32,30" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource GscAccentBrush}" Margin="0,0,12,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GameSaveCenter 设置" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="工具路径、版本策略与自动化安全" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Playnite 管理游戏入口，Worker 执行存档、媒体与云端任务。设置会同时保存在 Playnite 与 Worker 本地配置中。"
                       Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,20" TextWrapping="Wrap"/>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border Width="30" Height="30" CornerRadius="10" Background="#247C5CFC" Margin="0,0,9,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Foreground="{StaticResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="核心工具" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Worker" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WorkerExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="Ludusavi" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LudusaviExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" ToolTip="例如 D:\GameSaveCenterTools\Ludusavi\ludusavi.exe"/>
                        <TextBlock Grid.Row="2" Text="存档目录" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LudusaviBackupDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Text="Rclone" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RcloneExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Text="云端目标" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RcloneDestination, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" ToolTip="例如 myremote:GameSaveCenter"/>
                        <TextBlock Grid.Row="5" Text="媒体目录" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MediaArchiveDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="10" Background="#220A84FF" Margin="0,0,9,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="存档格式与历史版本" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock Text="推荐 ZIP + Zstandard。Simple 模式只维护一个当前副本，不适合作为多版本恢复历史。" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,13" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="180"/><ColumnDefinition Width="28"/><ColumnDefinition Width="150"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="备份格式" VerticalAlignment="Center" Margin="0,6"/>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding BackupFormat}" SelectedValuePath="Tag" Margin="0,4">
                            <ComboBoxItem Content="ZIP（多版本）" Tag="{x:Static contracts:BackupStorageFormat.Zip}"/>
                            <ComboBoxItem Content="Simple（单副本）" Tag="{x:Static contracts:BackupStorageFormat.Simple}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="3" Text="压缩方式" VerticalAlignment="Center" Margin="0,6"/>
                        <ComboBox Grid.Column="4" SelectedValue="{Binding Compression}" SelectedValuePath="Tag" Margin="0,4">
                            <ComboBoxItem Content="Zstandard" Tag="zstd"/><ComboBoxItem Content="Deflate" Tag="deflate"/>
                            <ComboBoxItem Content="Bzip2" Tag="bzip2"/><ComboBoxItem Content="不压缩" Tag="none"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="完整版本数" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FullBackupLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="每组差异版本数" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding DifferentialBackupLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Text="压缩等级" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CompressionLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" ToolTip="zstd 推荐 3；范围 -7 到 22"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="30" Height="30" CornerRadius="10" Background="#247C5CFC" Margin="0,0,9,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;" Foreground="{StaticResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="外观与动态效果" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="毛玻璃采用主题自适应的半透明表面和模糊环境光，不会修改 Playnite 外层窗口。系统高对比度或关闭动画时会自动降级。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="界面主题" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding ThemeMode, Mode=TwoWay}" SelectedValuePath="Tag" SelectionChanged="OnThemeModeChanged">
                            <ComboBoxItem Content="跟随 Playnite" Tag="{x:Static settings:GameSaveCenterThemeMode.FollowPlaynite}"/>
                            <ComboBoxItem Content="浅色" Tag="{x:Static settings:GameSaveCenterThemeMode.Light}"/>
                            <ComboBoxItem Content="深色" Tag="{x:Static settings:GameSaveCenterThemeMode.Dark}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="第三方主题可读性不佳时，可固定为浅色或深色。" Foreground="{DynamicResource GscMutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </Grid>
                    <CheckBox Content="启用界面动画（淡入、滑动、悬停与按钮按压反馈）" IsChecked="{Binding EnableUiAnimations}" Margin="0,5" Checked="OnVisualSettingChanged" Unchecked="OnVisualSettingChanged"/>
                    <CheckBox Content="启用毛玻璃与环境光效果" IsChecked="{Binding EnableGlassEffects}" Margin="0,5" Checked="OnVisualSettingChanged" Unchecked="OnVisualSettingChanged"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="毛玻璃强度" VerticalAlignment="Center"/>
                        <Slider x:Name="GlassStrengthSlider" Grid.Column="1" Minimum="20" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False" Value="{Binding GlassEffectStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="OnGlassStrengthChanged" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"><Run Text="{Binding ElementName=GlassStrengthSlider, Path=Value, StringFormat={}{0:0}, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="30" Height="30" CornerRadius="10" Background="#2030D158" Margin="0,0,9,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="自动化与安全" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <CheckBox Content="随 Playnite 启动 Worker" IsChecked="{Binding AutoStartWorker}" Margin="0,5"/>
                    <CheckBox Content="检测从 Steam、Xbox、启动器和 MOD 管理器外部启动的游戏" IsChecked="{Binding EnableProcessDetection}" Margin="0,5"/>
                    <CheckBox Content="对未匹配游戏记录启动前/退出后文件差异，生成存档路径候选" IsChecked="{Binding EnableSessionSavePathDetection}" Margin="0,5"/>
                    <CheckBox Content="同步新增截图和录像（源文件删除不会删除归档）" IsChecked="{Binding EnableMediaSync}" Margin="0,5"/>
                    <WrapPanel Margin="22,1,0,5" IsEnabled="{Binding EnableMediaSync}">
                        <CheckBox Content="Steam 截图" IsChecked="{Binding EnableSteamMedia}" Margin="0,4,14,4"/>
                        <CheckBox Content="Xbox Game Bar" IsChecked="{Binding EnableXboxGameBarMedia}" Margin="0,4,14,4"/>
                        <CheckBox Content="Windows 截图" IsChecked="{Binding EnableWindowsScreenshotMedia}" Margin="0,4,14,4"/>
                        <CheckBox Content="游戏相邻目录" IsChecked="{Binding EnablePlatformAdjacentMedia}" Margin="0,4,14,4"/>
                        <CheckBox Content="自定义来源" IsChecked="{Binding EnableCustomMedia}" Margin="0,4,14,4"/>
                    </WrapPanel>
                    <CheckBox Content="完成本地任务后允许单向云端复制" IsChecked="{Binding EnableCloudUpload}" Margin="0,5"/>
                    <CheckBox Content="管理面板打开时自动刷新任务与状态" IsChecked="{Binding EnableDashboardAutoRefresh}" Margin="0,5"/>
                    <CheckBox Content="任务完成或失败时显示 Playnite 通知（管理面板关闭时也会监测）" IsChecked="{Binding EnableTaskNotifications}" Margin="0,5"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="默认游玩中备份间隔（分钟）" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Column="1" Text="{Binding DefaultBackupIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="进程检测间隔（秒）" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProcessPollingSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Text="管理面板刷新间隔（秒）" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DashboardRefreshSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    </Grid>
                    <Border Background="#14FF9F0A" BorderBrush="#38FF9F0A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,13,0,0">
                        <TextBlock Text="自动恢复始终关闭。恢复必须经过当前快照、游戏关闭确认、预览、恢复后校验和可撤销快照。" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource GscAccentTintBrush}" Margin="0,0,9,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="设置迁移" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="导出文件包含非敏感插件设置、本地路径和云端目标名称，不包含 Rclone 密码。导入后先显示缺失路径报告，点击 Playnite 的保存按钮后才会生效。"
                               Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SettingsActionButton}" MinWidth="112" Content="导出设置" Click="OnExportSettingsClick" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource SettingsActionButton}" MinWidth="112" Content="导入设置" Click="OnImportSettingsClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
