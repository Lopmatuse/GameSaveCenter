<UserControl x:Class="GameSaveCenter.Playnite.Settings.GameSaveCenterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:GameSaveCenter.Contracts;assembly=GameSaveCenter.Contracts"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SettingsAccent" Color="#7C5CFC"/>
        <SolidColorBrush x:Key="SettingsDivider" Color="#268E8E93"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,28,24" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="GameSaveCenter 设置" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Playnite 管理游戏入口，Worker 执行存档、媒体与云端任务。设置会同时保存在 Playnite 与 Worker 本地配置中。"
                       Opacity="0.62" Margin="0,5,0,18" TextWrapping="Wrap"/>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="核心工具" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Worker" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WorkerExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="Ludusavi" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LudusaviExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" ToolTip="例如 D:\GameSaveCenterTools\Ludusavi\ludusavi.exe"/>
                        <TextBlock Grid.Row="2" Text="存档目录" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LudusaviBackupDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Text="Rclone" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RcloneExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Text="云端目标" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RcloneDestination, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" ToolTip="例如 myremote:GameSaveCenter"/>
                        <TextBlock Grid.Row="5" Text="媒体目录" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MediaArchiveDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="存档格式与历史版本" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="推荐 ZIP + Zstandard。Simple 模式只维护一个当前副本，不适合作为多版本恢复历史。" Opacity="0.62" Margin="0,4,0,13" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="180"/><ColumnDefinition Width="28"/><ColumnDefinition Width="150"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="备份格式" VerticalAlignment="Center" Margin="0,6"/>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding BackupFormat}" SelectedValuePath="Tag" Margin="0,4">
                            <ComboBoxItem Content="ZIP（多版本）" Tag="{x:Static contracts:BackupStorageFormat.Zip}"/>
                            <ComboBoxItem Content="Simple（单副本）" Tag="{x:Static contracts:BackupStorageFormat.Simple}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="3" Text="压缩方式" VerticalAlignment="Center" Margin="0,6"/>
                        <ComboBox Grid.Column="4" SelectedValue="{Binding Compression}" SelectedValuePath="Tag" Margin="0,4">
                            <ComboBoxItem Content="Zstandard" Tag="zstd"/><ComboBoxItem Content="Deflate" Tag="deflate"/>
                            <ComboBoxItem Content="Bzip2" Tag="bzip2"/><ComboBoxItem Content="不压缩" Tag="none"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="完整版本数" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FullBackupLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="每组差异版本数" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding DifferentialBackupLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Text="压缩等级" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CompressionLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" ToolTip="zstd 推荐 3；范围 -7 到 22"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="自动化与安全" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <CheckBox Content="随 Playnite 启动 Worker" IsChecked="{Binding AutoStartWorker}" Margin="0,5"/>
                    <CheckBox Content="检测从 Steam、Xbox、启动器和 MOD 管理器外部启动的游戏" IsChecked="{Binding EnableProcessDetection}" Margin="0,5"/>
                    <CheckBox Content="同步新增截图和录像（源文件删除不会删除归档）" IsChecked="{Binding EnableMediaSync}" Margin="0,5"/>
                    <CheckBox Content="完成本地任务后允许单向云端复制" IsChecked="{Binding EnableCloudUpload}" Margin="0,5"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="默认游玩中备份间隔（分钟）" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Column="1" Text="{Binding DefaultBackupIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="进程检测间隔（秒）" VerticalAlignment="Center" Margin="0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProcessPollingSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                    </Grid>
                    <Border Background="#14FF9F0A" BorderBrush="#38FF9F0A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,13,0,0">
                        <TextBlock Text="自动恢复始终关闭。恢复必须经过当前快照、游戏关闭确认、预览、恢复后校验和可撤销快照。" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
