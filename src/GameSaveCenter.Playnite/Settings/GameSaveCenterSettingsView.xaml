<UserControl x:Class="GameSaveCenter.Playnite.Settings.GameSaveCenterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:GameSaveCenter.Contracts;assembly=GameSaveCenter.Contracts"
             xmlns:settings="clr-namespace:GameSaveCenter.Playnite.Settings"
             xmlns:infra="clr-namespace:GameSaveCenter.Playnite.Infrastructure"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="SettingsCard" TargetType="{x:Type ui:Card}" BasedOn="{StaticResource GscWpfUiCard}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Border.CornerRadius" Value="20"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource GscBackdropBrush}" ClipToBounds="True">
        <Grid x:Name="SettingsAmbientLayer" IsHitTestVisible="False">
            <Ellipse Width="330" Height="330" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource GscAccentIconFillBrush}"><Ellipse.RenderTransform><TranslateTransform X="-95" Y="-120"/></Ellipse.RenderTransform><Ellipse.Effect><BlurEffect Radius="84"/></Ellipse.Effect></Ellipse>
            <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource GscAmbientInfoBrush}"><Ellipse.RenderTransform><TranslateTransform X="80" Y="120"/></Ellipse.RenderTransform><Ellipse.Effect><BlurEffect Radius="92"/></Ellipse.Effect></Ellipse>
        </Grid>
        <Border x:Name="SettingsDemoShell" Style="{StaticResource GscShellStyle}" Margin="18" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer x:Name="SettingsScroller" Style="{DynamicResource GscPageScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue">
            <Grid x:Name="SettingsShell" Opacity="0" Margin="0" MaxWidth="1360" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="SettingsHeader" Style="{DynamicResource GscRedesignWorkspaceHeroCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="SettingsHeaderIcon" Width="46" Height="46" CornerRadius="15" Background="{DynamicResource GscAccentBrush}" Margin="0,0,12,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="{DynamicResource GscOnAccentTextBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SETTINGS" Style="{DynamicResource GscRedesignHeroEyebrow}"/>
                        <TextBlock Text="GameSaveCenter 设置" Style="{DynamicResource GscRedesignHeroTitle}"/>
                        <TextBlock x:Name="SettingsHeaderSubtitle" Text="工具路径、版本策略、外观效果与自动化安全" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border x:Name="SettingsSaveHint" Grid.Column="2" Style="{StaticResource GscRedesignContextPill}" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="由 Playnite 的保存按钮提交" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="Playnite 管理游戏入口，Worker 执行存档、媒体与云端任务。切换左侧分类只改变显示内容，不会立即保存或执行任何业务操作。"
                           Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,18" TextWrapping="Wrap"/>
                <TabControl x:Name="SettingsSectionTabs" Grid.Row="2" Style="{StaticResource GscRedesignSettingsTabControl}" ItemContainerStyle="{StaticResource GscRedesignSettingsTabItem}" SelectedIndex="0">
                    <TabItem Style="{StaticResource GscRedesignSettingsTabItem}">
                        <TabItem.Header>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource GscAccentIconFillBrush}" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="核心工具" FontWeight="SemiBold"/><TextBlock Text="工具路径与基础目录" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="工具路径与基础目录" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                        </TabItem.Header>
                        <ui:Card Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource GscAccentIconFillBrush}" Margin="0,0,9,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="核心工具" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <UniformGrid x:Name="CoreToolFields" Columns="2">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="Worker" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding WorkerExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="Worker 可执行文件路径"/></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="Ludusavi" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding LudusaviExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 D:\GameSaveCenterTools\Ludusavi\ludusavi.exe"/></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="存档目录" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding LudusaviBackupDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ludusavi 备份目录"/></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="Rclone" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding RcloneExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rclone 可执行文件路径"/></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="云端目标" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding RcloneDestination, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 myremote:GameSaveCenter"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="媒体目录" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding MediaArchiveDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="媒体归档目录"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </ui:Card>
                    </TabItem>
                    <TabItem Style="{StaticResource GscRedesignSettingsTabItem}">
                        <TabItem.Header>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource GscAccentIconFillBrush}" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="存档格式与历史版本" FontWeight="SemiBold"/><TextBlock Text="备份格式、压缩与版本策略" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="备份格式、压缩与版本策略" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                        </TabItem.Header>
                        <ui:Card Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource GscInfoIconFillBrush}" Margin="0,0,9,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Foreground="{DynamicResource GscInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="存档格式与历史版本" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock Text="推荐 ZIP + Zstandard。Simple 模式只维护一个当前副本，不适合作为多版本恢复历史。" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,13" TextWrapping="Wrap"/>
                    <UniformGrid x:Name="StoragePolicyFields" Columns="2">
                        <StackPanel Margin="0,0,12,10">
                        <TextBlock Text="备份格式" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource GscWpfUiComboBox}" SelectedValue="{Binding BackupFormat}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="ZIP（多版本）" Tag="{x:Static contracts:BackupStorageFormat.Zip}"/>
                            <ComboBoxItem Content="Simple（单副本）" Tag="{x:Static contracts:BackupStorageFormat.Simple}"/>
                        </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                        <TextBlock Text="压缩方式" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource GscWpfUiComboBox}" SelectedValue="{Binding Compression}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Zstandard" Tag="zstd"/><ComboBoxItem Content="Deflate" Tag="deflate"/>
                            <ComboBoxItem Content="Bzip2" Tag="bzip2"/><ComboBoxItem Content="不压缩" Tag="none"/>
                        </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                        <TextBlock Text="完整版本数" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource GscNumericTextBox}" infra:SelectAllOnKeyboardFocus.Enabled="True" ToolTip="允许 1–255；离开输入框后提交。"><TextBox.Text><Binding Path="FullBackupLimit" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" NotifyOnValidationError="True"><Binding.ValidationRules><infra:IntegerRangeValidationRule Minimum="1" Maximum="255"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                        <TextBlock Text="每组差异版本数" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource GscNumericTextBox}" infra:SelectAllOnKeyboardFocus.Enabled="True" ToolTip="允许 0–255；离开输入框后提交。"><TextBox.Text><Binding Path="DifferentialBackupLimit" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" NotifyOnValidationError="True"><Binding.ValidationRules><infra:IntegerRangeValidationRule Minimum="0" Maximum="255"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="压缩等级" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource GscNumericTextBox}" infra:SelectAllOnKeyboardFocus.Enabled="True" ToolTip="zstd 推荐 3；允许 -7 到 22；离开输入框后提交。"><TextBox.Text><Binding Path="CompressionLevel" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" NotifyOnValidationError="True"><Binding.ValidationRules><infra:IntegerRangeValidationRule Minimum="-7" Maximum="22"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </ui:Card>
                    </TabItem>
                    <TabItem Style="{StaticResource GscRedesignSettingsTabItem}">
                        <TabItem.Header>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource GscAccentIconFillBrush}" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="外观与动态效果" FontWeight="SemiBold"/><TextBlock Text="主题、玻璃强度与辅助功能" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="主题、玻璃强度与辅助功能" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                        </TabItem.Header>
                        <ui:Card Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource GscAccentIconFillBrush}" Margin="0,0,9,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE790;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="外观与动态效果" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="毛玻璃采用主题自适应的半透明表面和模糊环境光，不会修改 Playnite 外层窗口。系统高对比度或关闭动画时会自动降级。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <UniformGrid x:Name="AppearanceFields" Columns="2" Margin="0,2,0,10">
                        <StackPanel Margin="0,0,12,10">
                        <TextBlock Text="界面主题" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource GscWpfUiComboBox}" SelectedValue="{Binding ThemeMode, Mode=TwoWay}" SelectedValuePath="Tag" SelectionChanged="OnThemeModeChanged">
                            <ComboBoxItem Content="跟随 Playnite" Tag="{x:Static settings:GameSaveCenterThemeMode.FollowPlaynite}"/>
                            <ComboBoxItem Content="浅色" Tag="{x:Static settings:GameSaveCenterThemeMode.Light}"/>
                            <ComboBoxItem Content="深色" Tag="{x:Static settings:GameSaveCenterThemeMode.Dark}"/>
                        </ComboBox>
                        <TextBlock Text="第三方主题可读性不佳时，可固定为浅色或深色。" Foreground="{DynamicResource GscMutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="毛玻璃强度" Margin="0,0,0,4"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"><Run Text="{Binding ElementName=GlassStrengthSlider, Path=Value, StringFormat={}{0:0}, Mode=OneWay}"/><Run Text="%"/></TextBlock>
                                <Slider x:Name="GlassStrengthSlider" Style="{StaticResource GscSlider}" AutomationProperties.Name="毛玻璃强度" Minimum="20" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False" Value="{Binding GlassEffectStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="OnGlassStrengthChanged" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </UniformGrid>
                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="启用界面动画（淡入、滑动、悬停与按钮按压反馈）" OnContent="开" OffContent="关"
                                     IsChecked="{Binding EnableUiAnimations}" Margin="0,5" Checked="OnVisualSettingChanged" Unchecked="OnVisualSettingChanged"/>
                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="启用毛玻璃与环境光效果" OnContent="开" OffContent="关"
                                     IsChecked="{Binding EnableGlassEffects}" Margin="0,5" Checked="OnVisualSettingChanged" Unchecked="OnVisualSettingChanged"/>
                </StackPanel>
            </ui:Card>
                    </TabItem>
                    <TabItem Style="{StaticResource GscRedesignSettingsTabItem}">
                        <TabItem.Header>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource GscAccentIconFillBrush}" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="自动化与安全" FontWeight="SemiBold"/><TextBlock Text="自动任务、媒体来源与安全边界" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="自动任务、媒体来源与安全边界" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                        </TabItem.Header>
                        <ui:Card Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource GscSuccessIconFillBrush}" Margin="0,0,9,0"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Foreground="{DynamicResource GscSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="自动化与安全" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="随 Playnite 启动 Worker" OnContent="开" OffContent="关" IsChecked="{Binding AutoStartWorker}" Margin="0,5"/>
                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="检测从 Steam、Xbox、启动器和 MOD 管理器外部启动的游戏" OnContent="开" OffContent="关" IsChecked="{Binding EnableProcessDetection}" Margin="0,5"/>
                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="对未匹配游戏记录启动前/退出后文件差异，生成存档路径候选" OnContent="开" OffContent="关" IsChecked="{Binding EnableSessionSavePathDetection}" Margin="0,5"/>
                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="同步新增截图和录像（源文件删除不会删除归档）" OnContent="开" OffContent="关" IsChecked="{Binding EnableMediaSync}" Margin="0,5"/>
                    <WrapPanel Margin="22,1,0,5" IsEnabled="{Binding EnableMediaSync}">
                        <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="Steam 截图" OnContent="开" OffContent="关" IsChecked="{Binding EnableSteamMedia}" Margin="0,4,14,4"/>
                        <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="Xbox Game Bar" OnContent="开" OffContent="关" IsChecked="{Binding EnableXboxGameBarMedia}" Margin="0,4,14,4"/>
                        <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="Windows 截图" OnContent="开" OffContent="关" IsChecked="{Binding EnableWindowsScreenshotMedia}" Margin="0,4,14,4"/>
                        <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="游戏相邻目录" OnContent="开" OffContent="关" IsChecked="{Binding EnablePlatformAdjacentMedia}" Margin="0,4,14,4"/>
                        <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="自定义来源" OnContent="开" OffContent="关" IsChecked="{Binding EnableCustomMedia}" Margin="0,4,14,4"/>
                    </WrapPanel>
                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="完成本地任务后允许单向云端复制" OnContent="开" OffContent="关" IsChecked="{Binding EnableCloudUpload}" Margin="0,5"/>
                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="管理面板打开时自动刷新任务与状态" OnContent="开" OffContent="关" IsChecked="{Binding EnableDashboardAutoRefresh}" Margin="0,5"/>
                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="任务完成或失败时显示 Playnite 通知（管理面板关闭时也会监测）" OnContent="开" OffContent="关" IsChecked="{Binding EnableTaskNotifications}" Margin="0,5"/>
                    <UniformGrid x:Name="AutomationIntervalFields" Columns="3" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="默认游玩中备份间隔（分钟）" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscNumericTextBox}" infra:SelectAllOnKeyboardFocus.Enabled="True" ToolTip="允许 1–1440 分钟；离开输入框后提交。"><TextBox.Text><Binding Path="DefaultBackupIntervalMinutes" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" NotifyOnValidationError="True"><Binding.ValidationRules><infra:IntegerRangeValidationRule Minimum="1" Maximum="1440"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="进程检测间隔（秒）" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscNumericTextBox}" infra:SelectAllOnKeyboardFocus.Enabled="True" ToolTip="允许 2–60 秒；离开输入框后提交。"><TextBox.Text><Binding Path="ProcessPollingSeconds" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" NotifyOnValidationError="True"><Binding.ValidationRules><infra:IntegerRangeValidationRule Minimum="2" Maximum="60"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel>
                        <StackPanel Margin="0,0,12,10"><TextBlock Text="管理面板刷新间隔（秒）" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscNumericTextBox}" infra:SelectAllOnKeyboardFocus.Enabled="True" ToolTip="允许 5–300 秒；离开输入框后提交。"><TextBox.Text><Binding Path="DashboardRefreshSeconds" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" NotifyOnValidationError="True"><Binding.ValidationRules><infra:IntegerRangeValidationRule Minimum="5" Maximum="300"/></Binding.ValidationRules></Binding></TextBox.Text></TextBox></StackPanel>
                    </UniformGrid>
                    <Border Background="{DynamicResource GscSafetyFillBrush}" BorderBrush="{DynamicResource GscSafetyStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,13,0,0">
                        <TextBlock Text="自动恢复始终关闭。恢复必须经过当前快照、游戏关闭确认、预览、恢复后校验和可撤销快照。" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ui:Card>
                    </TabItem>
                    <TabItem Style="{StaticResource GscRedesignSettingsTabItem}">
                        <TabItem.Header>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource GscAccentIconFillBrush}" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="设置迁移" FontWeight="SemiBold"/><TextBlock Text="导入、导出与设备间迁移" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="导入、导出与设备间迁移" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                        </TabItem.Header>
                        <ui:Card Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource GscAccentTintBrush}" Margin="0,0,9,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="设置迁移" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="导出文件包含非敏感插件设置、本地路径和云端目标名称，不包含 Rclone 密码。导入后先显示缺失路径报告，点击 Playnite 的保存按钮后才会生效。"
                               Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource GscWpfUiSecondaryButton}" MinHeight="40" MinWidth="112" Content="导出设置" Click="OnExportSettingsClick" Margin="0,0,10,0"/>
                        <ui:Button Style="{StaticResource GscWpfUiPrimaryButton}" MinHeight="40" MinWidth="112" Content="导入设置" Click="OnImportSettingsClick"/>
                    </WrapPanel>
                </StackPanel>
            </ui:Card>
                    </TabItem>
                </TabControl>
            </Grid>
        </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
