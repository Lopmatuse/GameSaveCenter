<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls">
    <!-- This dictionary is merged only by GameSaveCenter probe/migration views. WpfUiThemeScope
         changes its local ThemesDictionary for each view; GameSaveCenter tokens merged after it
         remain final and the Playnite host stays outside this scope. -->
    <!-- Do not merge WPF-UI's ui:ControlsDictionary or ui:ThemesDictionary into an embedded
         Playnite view.  Both dictionaries contain deferred CornerRadius/material resources
         that are safe in a standalone WPF Window but can resolve to DependencyProperty.UnsetValue
         while Playnite arranges its own main Window.  WpfUiProduction.xaml supplies explicit,
         host-independent templates for the small set of WPF-UI controls used by the plugin. -->

    <!-- Safe local fallbacks for WPF-UI token names.  The adaptive palette replaces these
         brushes at runtime; keeping concrete values here prevents a missing host/theme token
         from flowing into a Border or control template as DependencyProperty.UnsetValue. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#476FE7"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5A80EF"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#365DCB"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#60476FE7"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#171821"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#797E8D"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#969AA8"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#66797E8D"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFF6F6F9"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF0F0F4"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFE9E9EF"/>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFE9E9EF"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#80F6F6F9"/>
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#476FE7"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFE7E8ED"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FFD9DAE1"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFE7E8ED"/>
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#476FE7"/>
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FFFFFFFF"/>
</ResourceDictionary>
