<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- StaticResource resolution happens while this dictionary is parsed. Keep WPF-UI's
             type-keyed defaults in the same resource scope as the production adapters; a
             sibling merge at the UserControl level is too late in Playnite's XAML loader. -->
        <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Production adapters keep WPF-UI templates while applying GameSaveCenter's spacing,
         focus and material tokens. This dictionary is merged only after DesignTokens.xaml
         inside a GameSaveCenter UserControl; it must never enter Playnite application-level resources. -->
    <Style x:Key="GscWpfUiCard"
           TargetType="{x:Type ui:Card}"
           BasedOn="{StaticResource {x:Type ui:Card}}">
        <Setter Property="Padding" Value="16"/>
        <!-- WPF-UI 4.3.0 Card exposes rounded corners through the Border.CornerRadius attached property. -->
        <Setter Property="Border.CornerRadius" Value="18"/>
        <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <!-- GameSaveCenter tokens live in the parent UserControl dictionary. DynamicResource
                     keeps them theme-aware and avoids Playnite resolving a sibling dictionary too early. -->
                <DropShadowEffect Color="{DynamicResource GscSoftShadowColor}"
                                  BlurRadius="14" ShadowDepth="2" Opacity="0.28"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF-UI's type defaults are intentionally kept for the framework controls, but the
         production adapters own the input chrome so a Playnite host theme cannot reintroduce
         square white editors or an unthemed ComboBox popup.  These templates use only shared
         DynamicResource tokens and keep the content host/keyboard behavior of native WPF. -->
    <ControlTemplate x:Key="GscWpfUiTextBoxTemplate" TargetType="TextBox">
        <Border x:Name="Chrome"
                CornerRadius="10"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                          CanContentScroll="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="GscWpfUiComboBoxTemplate" TargetType="ComboBox">
        <Grid>
            <ToggleButton x:Name="DropDownToggle"
                          Focusable="False"
                          ClickMode="Press"
                          OverridesDefaultStyle="True"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                CornerRadius="10"
                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                            <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"/>
                                <Path x:Name="Chevron"
                                      Grid.Column="1"
                                      Data="M 1 2 L 5 6 L 9 2"
                                      Stretch="None"
                                      Stroke="{DynamicResource GscSecondaryTextBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   AllowsTransparency="{DynamicResource GscPopupAllowsTransparency}"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Focusable="False"
                   PopupAnimation="{DynamicResource GscPopupAnimation}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0,6,0,8"
                        Padding="5"
                        Background="{DynamicResource GscPopupBrush}"
                        BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Effect="{DynamicResource GscPopupEffect}">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.46"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Implicit item styling is scoped to the plugin resource dictionaries. It prevents the
         Popup from inheriting a bright host selection surface while preserving keyboard and
         automation semantics of ComboBoxItem. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared Apple-style DataGrid chrome for extracted workspaces. The Dashboard shell has
         its own compatible local styles; keeping this implicit scope here makes Overview,
         Saves, Media, Tasks and Maintenance look identical without duplicating templates. -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Tag"><Setter.Value><CornerRadius>9,9,9,9</CornerRadius></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="CellChrome" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CellChrome" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="RowChrome" Margin="2,2,2,2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <DataGridCellsPresenter x:Name="PART_CellsPresenter"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource GscRowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscWpfUiButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="ui:Button.CornerRadius" Value="11"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
    </Style>

    <Style x:Key="GscWpfUiSecondaryButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiButton}">
        <Setter Property="Appearance" Value="Secondary"/>
    </Style>

    <Style x:Key="GscWpfUiPrimaryButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiButton}">
        <Setter Property="Appearance" Value="Primary"/>
    </Style>

    <Style x:Key="GscWpfUiCompactButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiSecondaryButton}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="GscWpfUiActionButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiSecondaryButton}">
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="GscWpfUiPrimaryActionButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiPrimaryButton}">
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <Style x:Key="GscWpfUiToolbarButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiSecondaryButton}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style x:Key="GscWpfUiToolbarPrimaryButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiPrimaryButton}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style x:Key="GscWpfUiContextButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource GscWpfUiCompactButton}">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GscWpfUiToggleSwitch"
           TargetType="{x:Type ui:ToggleSwitch}"
           BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
    </Style>

    <!-- WPF-UI styles standard TextBox and ComboBox through ControlsDictionary. These keyed
         adapters make production migration explicit without replacing the framework template. -->
    <Style x:Key="GscWpfUiTextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="CaretBrush" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
        <Setter Property="Template" Value="{StaticResource GscWpfUiTextBoxTemplate}"/>
    </Style>

    <Style x:Key="GscWpfUiComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
        <Setter Property="Template" Value="{StaticResource GscWpfUiComboBoxTemplate}"/>
    </Style>
</ResourceDictionary>
