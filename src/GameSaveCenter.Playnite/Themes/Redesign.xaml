<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries>
        <!-- Keep the WPF-UI adapters in this dictionary's parse scope.  The color/material
             tokens remain page-local and are consumed through DynamicResource. -->
        <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Final redesign geometry.  These values intentionally form a small, reusable scale
         rather than page-specific magic numbers. -->
    <CornerRadius x:Key="GscRedesignShellCorner">26</CornerRadius>
    <CornerRadius x:Key="GscRedesignSidebarCorner">24</CornerRadius>
    <CornerRadius x:Key="GscRedesignCardCorner">20</CornerRadius>
    <CornerRadius x:Key="GscRedesignControlCorner">14</CornerRadius>
    <Thickness x:Key="GscRedesignPagePadding">20</Thickness>
    <Thickness x:Key="GscRedesignCardPadding">18</Thickness>

    <Style x:Key="GscRedesignShellSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GscRedesignShellCorner}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="GscRedesignSidebarSurface" TargetType="Border" BasedOn="{StaticResource GscRedesignShellSurface}">
        <Setter Property="Background" Value="{DynamicResource GscSidebarBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource GscRedesignSidebarCorner}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{DynamicResource GscSidebarEffect}"/>
    </Style>

    <Style x:Key="GscRedesignSectionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GscRedesignCardCorner}"/>
        <Setter Property="Padding" Value="{StaticResource GscRedesignCardPadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <Style x:Key="GscRedesignHeroCard" TargetType="Border" BasedOn="{StaticResource GscRedesignSectionCard}">
        <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
        <Setter Property="Effect" Value="{DynamicResource GscSurfaceEffect}"/>
    </Style>

    <Style x:Key="GscRedesignMetricCard" TargetType="{x:Type ui:Card}" BasedOn="{StaticResource GscWpfUiCard}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Border.CornerRadius" Value="18"/>
        <Setter Property="MinHeight" Value="96"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GscRedesignMetricBorder" TargetType="Border" BasedOn="{StaticResource GscRedesignSectionCard}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="MinHeight" Value="96"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <Style x:Key="GscRedesignHeaderButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource GscWpfUiSecondaryButton}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GscRedesignPrimaryHeaderButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource GscWpfUiPrimaryButton}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="MinWidth" Value="42"/>
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GscRedesignGameSelector" TargetType="ComboBox" BasedOn="{StaticResource GscWpfUiComboBox}">
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MaxDropDownHeight" Value="420"/>
        <Setter Property="MinWidth" Value="250"/>
        <Setter Property="ToolTipService.ShowDuration" Value="16000"/>
    </Style>

    <!-- The active-game context is deliberately a button, not a ComboBox. A ComboBox
         materializes a large popup and becomes visibly slow for libraries with hundreds
         of games. Clicking this button opens the existing virtualized search/filter/sort
         browser, so there is only one game-selection surface at every breakpoint. -->
    <Style x:Key="GscRedesignGameContextButton" TargetType="Button">
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="MinWidth" Value="250"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.ShowDuration" Value="16000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscRedesignStatusCard" TargetType="Border">
        <Setter Property="MinHeight" Value="58"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="GscRedesignContextPill" TargetType="Border">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="GscRedesignSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
    </Style>

    <Style x:Key="GscRedesignSectionSubtitle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="GscRedesignSettingsTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel KeyboardNavigation.TabNavigation="Local" LastChildFill="True">
                        <TabPanel x:Name="HeaderPanel" IsItemsHost="True"
                                  DockPanel.Dock="{TemplateBinding TabStripPlacement}"
                                  Margin="0,0,16,0" KeyboardNavigation.TabIndex="1"/>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Top">
                            <Setter TargetName="HeaderPanel" Property="Margin" Value="0,0,0,12"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscRedesignSettingsTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="MinWidth" Value="218"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" MinHeight="66" Padding="14,11" CornerRadius="17"
                            Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscGlassStrokeBrush}" BorderThickness="1">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
