<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <!-- Shared defaults. Runtime palette adaptation replaces the theme-sensitive brushes locally. -->
    <SolidColorBrush x:Key="GscAccentBrush" Color="#7C5CFC"/>
    <SolidColorBrush x:Key="GscAccentHoverBrush" Color="#6A49EE"/>
    <SolidColorBrush x:Key="GscAccentPressedBrush" Color="#5B3EDB"/>
    <SolidColorBrush x:Key="GscAccentTintBrush" Color="#247C5CFC"/>
    <SolidColorBrush x:Key="GscAccentTintStrongBrush" Color="#387C5CFC"/>
    <SolidColorBrush x:Key="GscSuccessBrush" Color="#30D158"/>
    <SolidColorBrush x:Key="GscWarningBrush" Color="#FF9F0A"/>
    <SolidColorBrush x:Key="GscErrorBrush" Color="#FF453A"/>
    <SolidColorBrush x:Key="GscErrorTintBrush" Color="#24FF453A"/>
    <SolidColorBrush x:Key="GscInfoBrush" Color="#0A84FF"/>
    <SolidColorBrush x:Key="GscOnAccentTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GscSelectionTextBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="GscAccentIconFillBrush" Color="#247C5CFC"/>
    <SolidColorBrush x:Key="GscInfoIconFillBrush" Color="#220A84FF"/>
    <SolidColorBrush x:Key="GscSuccessIconFillBrush" Color="#2030D158"/>
    <SolidColorBrush x:Key="GscErrorIconFillBrush" Color="#20FF453A"/>
    <SolidColorBrush x:Key="GscWarningIconFillBrush" Color="#20FF9F0A"/>
    <SolidColorBrush x:Key="GscRestoreInfoFillBrush" Color="#140A84FF"/>
    <SolidColorBrush x:Key="GscRestoreInfoStrokeBrush" Color="#330A84FF"/>
    <SolidColorBrush x:Key="GscSafetyFillBrush" Color="#14FF9F0A"/>
    <SolidColorBrush x:Key="GscSafetyStrokeBrush" Color="#38FF9F0A"/>
    <SolidColorBrush x:Key="GscRowHoverStrongBrush" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="GscAmbientAccentBrush" Color="#267C5CFC"/>
    <SolidColorBrush x:Key="GscAmbientInfoBrush" Color="#1E0A84FF"/>
    <SolidColorBrush x:Key="GscAmbientSuccessBrush" Color="#1830D158"/>
    <SolidColorBrush x:Key="GscPrimaryButtonBorderBrush" Color="#8A72FF"/>
    <SolidColorBrush x:Key="GscMutedStatusBrush" Color="#8E8E93"/>
    <LinearGradientBrush x:Key="GscPrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B6BFF" Offset="0"/>
        <GradientStop Color="#6848EE" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="GscSoftShadowColor">#22000000</Color>
    <Color x:Key="GscPopupShadowColor">#52000000</Color>
    <Color x:Key="GscAccentShadowColor">#487C5CFC</Color>

    <!-- Effects are deliberately null until a page enables its local material palette. This
         keeps initial, high-contrast and reduced-transparency parsing free of effect visuals. -->
    <x:Null x:Key="GscSurfaceEffect"/>
    <x:Null x:Key="GscPrimaryButtonEffect"/>
    <x:Null x:Key="GscSidebarEffect"/>
    <x:Null x:Key="GscPopupEffect"/>
    <x:Null x:Key="GscDialogEffect"/>
    <x:Null x:Key="GscSliderThumbEffect"/>
    <sys:Boolean x:Key="GscPopupAllowsTransparency">False</sys:Boolean>
    <x:Static x:Key="GscPopupAnimation" Member="primitives:PopupAnimation.None"/>

    <SolidColorBrush x:Key="GscGlassFillBrush" Color="#D8FFFFFF"/>
    <SolidColorBrush x:Key="GscGlassStrongBrush" Color="#F0FFFFFF"/>
    <SolidColorBrush x:Key="GscGlassStrokeBrush" Color="#2A000000"/>
    <SolidColorBrush x:Key="GscGlassHighlightBrush" Color="#A8FFFFFF"/>
    <SolidColorBrush x:Key="GscSidebarBrush" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="GscBackdropBrush" Color="#18F1F2F7"/>
    <SolidColorBrush x:Key="GscPrimaryTextBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="GscSecondaryTextBrush" Color="#BFFFFFFF"/>
    <SolidColorBrush x:Key="GscMutedTextBrush" Color="#91FFFFFF"/>
    <SolidColorBrush x:Key="GscDisabledTextBrush" Color="#61FFFFFF"/>
    <SolidColorBrush x:Key="GscControlFillBrush" Color="#CC171A25"/>
    <SolidColorBrush x:Key="GscControlStrokeBrush" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="GscDividerBrush" Color="#2B8E8E93"/>
    <SolidColorBrush x:Key="GscTableDividerBrush" Color="#168E8E93"/>
    <SolidColorBrush x:Key="GscPopupBrush" Color="#FA202330"/>
    <SolidColorBrush x:Key="GscTableHeaderBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="GscTableAlternateRowBrush" Color="#08000000"/>
    <SolidColorBrush x:Key="GscRowHoverBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="GscScrollTrackBrush" Color="#128E8E93"/>
    <SolidColorBrush x:Key="GscScrollThumbBrush" Color="#5A8E8E93"/>
    <SolidColorBrush x:Key="GscScrollThumbHoverBrush" Color="#887C5CFC"/>
    <SolidColorBrush x:Key="GscOverlayBrush" Color="#66000000"/>

    <CornerRadius x:Key="GscCornerSmall">8</CornerRadius>
    <CornerRadius x:Key="GscCornerControl">11</CornerRadius>
    <CornerRadius x:Key="GscCornerCard">18</CornerRadius>
    <CornerRadius x:Key="GscCornerPanel">22</CornerRadius>
    <Thickness x:Key="GscFocusThickness">2</Thickness>

    <!-- Shared table geometry. Each workspace keeps its DataGrid in a finite Grid row, while
         these tokens provide one readable density across light, dark and host themes. -->
    <sys:Double x:Key="GscTableRowHeight">54</sys:Double>
    <sys:Double x:Key="GscTableMinHeight">280</sys:Double>
    <sys:Double x:Key="GscTableHeaderHeight">44</sys:Double>

    <!-- Stable, mostly opaque reading surface. Views may add their own layout-only padding
         but must not recreate a different card material for every settings section. It stays
         effect-free so dense pages do not attach a compositor effect to every small group. -->
    <Style x:Key="GscSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GscCornerCard}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Only primary workspaces use elevation; lists, compact metrics and form groups remain
         on GscSurface so scrolling and repeated content never accumulate DropShadowEffects. -->
    <Style x:Key="GscElevatedSurface" TargetType="Border" BasedOn="{StaticResource GscSurface}">
        <Setter Property="Effect" Value="{DynamicResource GscSurfaceEffect}"/>
    </Style>

    <Style x:Key="GscSharedFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="11" BorderThickness="2"
                            BorderBrush="{DynamicResource GscAccentBrush}" Opacity="0.72"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- This fallback deliberately has no EventSetter. Views may specialize it locally,
         but Settings and future views must not rely on DashboardView code-behind. -->
    <Style x:Key="GscButtonBase" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            CornerRadius="11"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.84"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscPrimaryButton" TargetType="Button" BasedOn="{StaticResource GscButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource GscOnAccentTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscPrimaryButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscPrimaryButtonBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"
                            Effect="{DynamicResource GscPrimaryButtonEffect}">
                        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscDividerBrush}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="0,8">
                        <Track x:Name="PART_Track" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" IsTabStop="False" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbChrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource GscControlStrokeBrush}" BorderThickness="1"
                                                    Effect="{DynamicResource GscSliderThumbEffect}">
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/></Trigger>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource GscAccentBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                    <Thumb.Background>{DynamicResource GscControlFillBrush}</Thumb.Background>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}" IsTabStop="False" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscCheckBox" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{DynamicResource GscControlStrokeBrush}" Background="{DynamicResource GscControlFillBrush}" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 3 8 L 7 12 L 14 4" Stretch="None" Stroke="{DynamicResource GscOnAccentTextBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- Compact checkbox used inside DataGrid cells. It intentionally omits the content column
         so the Apple-style rounded box remains mathematically centered in every cell. -->
    <Style x:Key="GscDataGridCheckBox" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box"
                            Width="18"
                            Height="18"
                            CornerRadius="5"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource GscControlStrokeBrush}"
                            Background="{DynamicResource GscControlFillBrush}">
                        <Path x:Name="Check"
                              Data="M 3.5 8.5 L 7 12 L 14.5 4.5"
                              Stretch="None"
                              Stroke="{DynamicResource GscOnAccentTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscTextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Stretch"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      CanContentScroll="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Numeric editors commit after a complete value is entered, avoiding per-keystroke Int32 conversion. -->
    <Style x:Key="GscNumericTextBox" TargetType="TextBox" BasedOn="{StaticResource GscTextBox}">
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource GscErrorBrush}" BorderThickness="2" CornerRadius="10" IsHitTestVisible="False">
                        <AdornedElementPlaceholder/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscSearchClearButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="26"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="{TemplateBinding Background}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Data="M 6 6 L 14 14 M 14 6 L 6 14"
                              Width="20"
                              Height="20"
                              Stretch="None"
                              Stroke="{DynamicResource GscSecondaryTextBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared controls are deliberately owned by the plugin so Playnite's host theme cannot
         reintroduce bright native scrollbars, progress tracks, or ComboBox popups. -->
    <Style x:Key="GscComboBox" TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" OverridesDefaultStyle="True"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" CornerRadius="10" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                            <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center" TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"/>
                                            <Path x:Name="Chevron" Grid.Column="1" Data="M 1 2 L 5 6 L 9 2" Stretch="None" Stroke="{DynamicResource GscSecondaryTextBrush}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                            <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom"
                               AllowsTransparency="{DynamicResource GscPopupAllowsTransparency}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False"
                               PopupAnimation="{DynamicResource GscPopupAnimation}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,6,0,8" Padding="5"
                                    Background="{DynamicResource GscPopupBrush}" BorderBrush="{DynamicResource GscGlassStrokeBrush}" BorderThickness="1" CornerRadius="11"
                                    Effect="{DynamicResource GscPopupEffect}">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.46"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/><Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Overlay scrollbars use one rounded Rectangle per Thumb. Do not compose the
         capsule from overlapping semi-transparent shapes: overlapping alpha produces
         bright cap artifacts, while a single inset shape keeps both ends symmetric. -->
    <ControlTemplate x:Key="GscVerticalScrollThumbTemplate" TargetType="Thumb">
        <Grid MinWidth="12"
              MinHeight="36"
              Background="Transparent"
              ClipToBounds="True"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
            <Rectangle x:Name="ThumbChrome"
                       Margin="2,1"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Fill="{TemplateBinding Background}"
                       RadiusX="4"
                       RadiusY="4"
                       SnapsToDevicePixels="True"/>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="GscHorizontalScrollThumbTemplate" TargetType="Thumb">
        <Grid MinWidth="36"
              MinHeight="12"
              Background="Transparent"
              ClipToBounds="True"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
            <Rectangle x:Name="ThumbChrome"
                       Margin="1,2"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Fill="{TemplateBinding Background}"
                       RadiusX="4"
                       RadiusY="4"
                       SnapsToDevicePixels="True"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="GscScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource GscScrollThumbBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GscScrollThumbHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource GscAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.34"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root"
                          Background="Transparent"
                          ClipToBounds="True"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <Track x:Name="PART_Track"
                               Margin="0,4"
                               Focusable="False"
                               IsDirectionReversed="True"
                               Orientation="{TemplateBinding Orientation}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.Resources>
                                <!-- WPF Track does not use Thumb.MinHeight/MinWidth as the proportional
                                     scroll-thumb floor. Its minimum is half of these system metrics.
                                     Override them locally so huge collections still render a usable
                                     36-DIP capsule rather than a one-pixel spike. -->
                                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">72</sys:Double>
                                <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">72</sys:Double>
                            </Track.Resources>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton"
                                              Command="ScrollBar.PageUpCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              OverridesDefaultStyle="True"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ScrollThumb"
                                       Style="{StaticResource GscScrollThumb}"
                                       Width="12"
                                       MinHeight="36"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Template="{StaticResource GscVerticalScrollThumbTemplate}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton"
                                              Command="ScrollBar.PageDownCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              OverridesDefaultStyle="True"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="12"/>
                            <Setter Property="MinWidth" Value="12"/>
                            <Setter TargetName="PART_Track" Property="Margin" Value="0,4"/>
                            <Setter TargetName="ScrollThumb" Property="Width" Value="12"/>
                            <Setter TargetName="ScrollThumb" Property="Height" Value="Auto"/>
                            <Setter TargetName="ScrollThumb" Property="MinWidth" Value="12"/>
                            <Setter TargetName="ScrollThumb" Property="MinHeight" Value="36"/>
                            <Setter TargetName="ScrollThumb" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="ScrollThumb" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="ScrollThumb" Property="Template" Value="{StaticResource GscVerticalScrollThumbTemplate}"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="12"/>
                            <Setter Property="MinHeight" Value="12"/>
                            <Setter TargetName="PART_Track" Property="Margin" Value="4,0"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            <Setter TargetName="ScrollThumb" Property="Width" Value="Auto"/>
                            <Setter TargetName="ScrollThumb" Property="Height" Value="12"/>
                            <Setter TargetName="ScrollThumb" Property="MinWidth" Value="36"/>
                            <Setter TargetName="ScrollThumb" Property="MinHeight" Value="12"/>
                            <Setter TargetName="ScrollThumb" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="ScrollThumb" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="ScrollThumb" Property="Template" Value="{StaticResource GscHorizontalScrollThumbTemplate}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscPopupBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MaxWidth" Value="620"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
                <Setter Property="ToolTip" Value="正在进行；完成时间取决于实际任务。"/>
                <Setter Property="Foreground" Value="{DynamicResource GscInfoBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
