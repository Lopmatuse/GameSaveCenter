<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <!-- Shared defaults. Runtime palette adaptation replaces the theme-sensitive brushes locally. -->
    <!-- Deterministic fallback values mirror the standalone demo. Runtime Playnite theme
         adaptation may replace these locally, but parsing must never depend on host resources. -->
    <SolidColorBrush x:Key="GscAccentBrush" Color="#7897FF"/>
    <SolidColorBrush x:Key="GscAccentHoverBrush" Color="#8CA6FF"/>
    <SolidColorBrush x:Key="GscAccentPressedBrush" Color="#5F7DE8"/>
    <SolidColorBrush x:Key="GscAccentTintBrush" Color="#2A7897FF"/>
    <SolidColorBrush x:Key="GscAccentTintStrongBrush" Color="#3A7897FF"/>
    <SolidColorBrush x:Key="GscSuccessBrush" Color="#4BD39B"/>
    <SolidColorBrush x:Key="GscWarningBrush" Color="#F5B24D"/>
    <SolidColorBrush x:Key="GscErrorBrush" Color="#FF6B80"/>
    <SolidColorBrush x:Key="GscErrorTintBrush" Color="#24FF6B80"/>
    <SolidColorBrush x:Key="GscInfoBrush" Color="#78A9FF"/>
    <SolidColorBrush x:Key="GscOnAccentTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="GscSelectionTextBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="GscAccentIconFillBrush" Color="#2A7897FF"/>
    <SolidColorBrush x:Key="GscInfoIconFillBrush" Color="#2478A9FF"/>
    <SolidColorBrush x:Key="GscSuccessIconFillBrush" Color="#244BD39B"/>
    <SolidColorBrush x:Key="GscErrorIconFillBrush" Color="#24FF6B80"/>
    <SolidColorBrush x:Key="GscWarningIconFillBrush" Color="#24F5B24D"/>
    <SolidColorBrush x:Key="GscRestoreInfoFillBrush" Color="#2478A9FF"/>
    <SolidColorBrush x:Key="GscRestoreInfoStrokeBrush" Color="#6678A9FF"/>
    <SolidColorBrush x:Key="GscSafetyFillBrush" Color="#24F5B24D"/>
    <SolidColorBrush x:Key="GscSafetyStrokeBrush" Color="#66F5B24D"/>
    <SolidColorBrush x:Key="GscRowHoverStrongBrush" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="GscAmbientAccentBrush" Color="#2A7897FF"/>
    <SolidColorBrush x:Key="GscAmbientInfoBrush" Color="#2478A9FF"/>
    <SolidColorBrush x:Key="GscAmbientSuccessBrush" Color="#244BD39B"/>
    <SolidColorBrush x:Key="GscPrimaryButtonBorderBrush" Color="#8CA6FF"/>
    <SolidColorBrush x:Key="GscMutedStatusBrush" Color="#7D8EAA"/>
    <LinearGradientBrush x:Key="GscPrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7897FF" Offset="0"/>
        <GradientStop Color="#5F7DE8" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="GscSoftShadowColor">#22000000</Color>
    <Color x:Key="GscPopupShadowColor">#52000000</Color>
    <Color x:Key="GscAccentShadowColor">#507897FF</Color>

    <!-- Effects are deliberately null until a page enables its local material palette. This
         keeps initial, high-contrast and reduced-transparency parsing free of effect visuals. -->
    <x:Null x:Key="GscSurfaceEffect"/>
    <x:Null x:Key="GscPrimaryButtonEffect"/>
    <x:Null x:Key="GscSidebarEffect"/>
    <x:Null x:Key="GscPopupEffect"/>
    <x:Null x:Key="GscDialogEffect"/>
    <x:Null x:Key="GscSliderThumbEffect"/>
    <sys:Boolean x:Key="GscPopupAllowsTransparency">False</sys:Boolean>
    <x:Static x:Key="GscPopupAnimation" Member="primitives:PopupAnimation.None"/>

    <SolidColorBrush x:Key="GscGlassFillBrush" Color="#F0202A3A"/>
    <SolidColorBrush x:Key="GscGlassStrongBrush" Color="#F820293A"/>
    <SolidColorBrush x:Key="GscGlassStrokeBrush" Color="#382D3B52"/>
    <SolidColorBrush x:Key="GscGlassHighlightBrush" Color="#182D3B52"/>
    <SolidColorBrush x:Key="GscSidebarBrush" Color="#FA171F2D"/>
    <SolidColorBrush x:Key="GscBackdropBrush" Color="#FF0F1724"/>
    <SolidColorBrush x:Key="GscPrimaryTextBrush" Color="#FFF4F7FF"/>
    <SolidColorBrush x:Key="GscSecondaryTextBrush" Color="#FFA7B5D0"/>
    <SolidColorBrush x:Key="GscMutedTextBrush" Color="#FF7D8EAA"/>
    <SolidColorBrush x:Key="GscDisabledTextBrush" Color="#FF59677F"/>
    <SolidColorBrush x:Key="GscControlFillBrush" Color="#F5222D3E"/>
    <SolidColorBrush x:Key="GscControlStrokeBrush" Color="#3A34445B"/>
    <SolidColorBrush x:Key="GscDividerBrush" Color="#3A2A3850"/>
    <SolidColorBrush x:Key="GscTableDividerBrush" Color="#302A3850"/>
    <SolidColorBrush x:Key="GscPopupBrush" Color="#FC202B3D"/>
    <SolidColorBrush x:Key="GscTableHeaderBrush" Color="#FF202A39"/>
    <SolidColorBrush x:Key="GscTableAlternateRowBrush" Color="#18152332"/>
    <SolidColorBrush x:Key="GscRowHoverBrush" Color="#282C4360"/>
    <SolidColorBrush x:Key="GscScrollTrackBrush" Color="#24111A29"/>
    <SolidColorBrush x:Key="GscScrollThumbBrush" Color="#995A6A83"/>
    <SolidColorBrush x:Key="GscScrollThumbHoverBrush" Color="#CC7897FF"/>
    <SolidColorBrush x:Key="GscOverlayBrush" Color="#AA060A12"/>
    <SolidColorBrush x:Key="GscPickerScrimBrush" Color="#60060A12"/>

    <CornerRadius x:Key="GscCornerSmall">8</CornerRadius>
    <CornerRadius x:Key="GscCornerControl">11</CornerRadius>
    <CornerRadius x:Key="GscCornerCard">18</CornerRadius>
    <CornerRadius x:Key="GscCornerPanel">22</CornerRadius>
    <Thickness x:Key="GscFocusThickness">2</Thickness>

    <!-- Shared layout geometry. One scale replaces page-specific magic numbers across
         workspaces while preserving each page's existing density and responsiveness. -->
    <sys:Double x:Key="GscSpacing1">4</sys:Double>
    <sys:Double x:Key="GscSpacing2">8</sys:Double>
    <sys:Double x:Key="GscSpacing3">12</sys:Double>
    <sys:Double x:Key="GscSpacing4">16</sys:Double>
    <sys:Double x:Key="GscSpacing5">20</sys:Double>
    <sys:Double x:Key="GscSpacing6">24</sys:Double>
    <sys:Double x:Key="GscSpacing8">32</sys:Double>
    <!-- Vertical rhythm between section cards inside a page scroll channel. -->
    <sys:Double x:Key="GscSectionSpacing">14</sys:Double>
    <!-- Demo-aligned side navigation and workspace inspector channels. The dashboard
         consumes the sidebar width at each breakpoint; workspace inspectors share one
         width so the right-hand detail column stays consistent across pages. -->
    <sys:Double x:Key="GscSidebarWidth">228</sys:Double>
    <sys:Double x:Key="GscCompactSidebarWidth">76</sys:Double>
    <!-- GridLength so the resource binds directly to ColumnDefinition.Width without
         runtime conversion. -->
    <GridLength x:Key="GscInspectorWidth">360</GridLength>
    <!-- Form pages keep a readable content column instead of stretching across the host. -->
    <sys:Double x:Key="GscFormMaxWidth">1120</sys:Double>

    <!-- Shared table geometry. Each workspace keeps its DataGrid in a finite Grid row, while
         these tokens provide one readable density across light, dark and host themes. -->
    <!-- Keep rows comfortably readable instead of collapsing a table to two or three lines.
         The surrounding page owns the overflow channel, while the DataGrid keeps its own
         virtualized scrollbar for the remaining rows. -->
    <sys:Double x:Key="GscTableRowHeight">48</sys:Double>
    <!-- A readable table should expose several rows at normal window sizes. Legacy and
         dashboard-hosted tables can still use the large viewport token below; extracted
         workspaces use the adaptive minimum so the page itself does not need a vertical
         scrollbar and the DataGrid keeps the overflow inside its own virtualized viewer. -->
    <sys:Double x:Key="GscTableMinHeight">0</sys:Double>
    <!-- Workspace tables live in a finite Grid star row.  A non-zero global minimum
         causes the parent TabControl to grow during a resize and leaks the page scroll
         channel outside the rounded frame.  DashboardView supplies a small height-aware
         floor after the host is measured; zero is the safe initial value. -->
    <sys:Double x:Key="GscWorkspaceTableMinHeight">0</sys:Double>
    <!-- Finite viewport used by page-level scroll channels. A fixed viewport keeps
         virtualization active while the page itself can reveal the action/inspector
         sections below a table on short windows. DashboardView updates this token at
         each breakpoint so normal hosts show several readable rows without clipping. -->
    <sys:Double x:Key="GscTableViewportHeight">720</sys:Double>
    <sys:Double x:Key="GscListViewportHeight">720</sys:Double>
    <sys:Double x:Key="GscTableHeaderHeight">42</sys:Double>

    <!-- Page-level scrolling is deliberately keyed instead of implicit.  A page owns one
         vertical scroll channel; tables and lists own their own internal channels.  Keeping
         the contract here prevents a Playnite host theme from turning the outer viewer into a
         focusable square surface or re-enabling horizontal page scrolling. -->
    <Style x:Key="GscPageScrollViewer" TargetType="ScrollViewer">
        <!-- Keep page surfaces visually clean like the demo. Scrolling remains available
             through wheel/keyboard; tables and lists retain their own visible scrollbars. -->
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="CanContentScroll" Value="False"/>
        <Setter Property="PanningMode" Value="VerticalOnly"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding" Value="0,0,4,6"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- Inspectors are finite secondary surfaces.  They may scroll vertically, but never
         create a second page-wide horizontal viewport when a long path or diagnostic wraps. -->
    <Style x:Key="GscInspectorScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource GscPageScrollViewer}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="MaxHeight" Value="280"/>
    </Style>

    <!-- Stable, mostly opaque reading surface. Views may add their own layout-only padding
         but must not recreate a different card material for every settings section. It stays
         effect-free so dense pages do not attach a compositor effect to every small group. -->
    <Style x:Key="GscSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GscCornerCard}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Shared empty-state copy for finite list/table surfaces. Keep the message
         centered and hit-test free so the underlying DataGrid/ListBox retains its
         keyboard and scrolling contract even when there are no rows. -->
    <Style x:Key="GscEmptyStateText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="24"/>
        <Setter Property="MaxWidth" Value="480"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- Only primary workspaces use elevation; lists, compact metrics and form groups remain
         on GscSurface so scrolling and repeated content never accumulate DropShadowEffects. -->
    <Style x:Key="GscElevatedSurface" TargetType="Border" BasedOn="{StaticResource GscSurface}">
        <Setter Property="Effect" Value="{DynamicResource GscSurfaceEffect}"/>
    </Style>

    <!-- Shared diagnostic/advanced-section expander. Keep the header and content on the
         same rounded material surface so the host theme cannot reintroduce a square native
         Expander chrome. The content remains collapsed without taking layout space, while
         long diagnostic text owns its own ScrollViewer in the consuming view. -->
    <Style x:Key="GscExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderSite"
                                      Grid.Row="0"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="12,10"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      FocusVisualStyle="{DynamicResource GscSharedFocusVisual}"
                                      OverridesDefaultStyle="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource GscCornerControl}"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Chevron"
                                                  Data="M 2 1 L 7 6 L 12 1"
                                                  Stretch="None"
                                                  Stroke="{DynamicResource GscSecondaryTextBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter Grid.Column="1"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                                              RecognizesAccessKey="True"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                            <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="HeaderChrome" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="ContentChrome"
                                Grid.Row="1"
                                Margin="0,6,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource GscCornerControl}"
                                Padding="12"
                                Visibility="Collapsed">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentChrome" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscSharedFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="11" BorderThickness="2"
                            BorderBrush="{DynamicResource GscAccentBrush}" Opacity="0.72"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- This fallback deliberately has no EventSetter. Views may specialize it locally,
         but Settings and future views must not rely on DashboardView code-behind. -->
    <Style x:Key="GscButtonBase" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            CornerRadius="11"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
                            </Setter>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.84"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscPrimaryButton" TargetType="Button" BasedOn="{StaticResource GscButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource GscOnAccentTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscPrimaryButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscPrimaryButtonBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"
                            Effect="{DynamicResource GscPrimaryButtonEffect}">
                        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscDividerBrush}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="0,8">
                        <Track x:Name="PART_Track" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" IsTabStop="False" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbChrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource GscControlStrokeBrush}" BorderThickness="1"
                                                    Effect="{DynamicResource GscSliderThumbEffect}">
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/></Trigger>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource GscAccentBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                    <Thumb.Background>{DynamicResource GscControlFillBrush}</Thumb.Background>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}" IsTabStop="False" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscCheckBox" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{DynamicResource GscControlStrokeBrush}" Background="{DynamicResource GscControlFillBrush}" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 3 8 L 7 12 L 14 4" Stretch="None" Stroke="{DynamicResource GscOnAccentTextBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.78"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- Compact checkbox used inside DataGrid cells. It intentionally omits the content column
         so the Apple-style rounded box remains mathematically centered in every cell. -->
    <Style x:Key="GscDataGridCheckBox" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box"
                            Width="18"
                            Height="18"
                            CornerRadius="5"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource GscControlStrokeBrush}"
                            Background="{DynamicResource GscControlFillBrush}">
                        <Path x:Name="Check"
                              Data="M 3.5 8.5 L 7 12 L 14.5 4.5"
                              Stretch="None"
                              Stroke="{DynamicResource GscOnAccentTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscTextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Stretch"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      CanContentScroll="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Numeric editors commit after a complete value is entered, avoiding per-keystroke Int32 conversion. -->
    <Style x:Key="GscNumericTextBox" TargetType="TextBox" BasedOn="{StaticResource GscTextBox}">
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource GscErrorBrush}" BorderThickness="2" CornerRadius="10" IsHitTestVisible="False">
                        <AdornedElementPlaceholder/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscSearchClearButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="26"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="{TemplateBinding Background}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Data="M 6 6 L 14 14 M 14 6 L 6 14"
                              Width="20"
                              Height="20"
                              Stretch="None"
                              Stroke="{DynamicResource GscSecondaryTextBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared controls are deliberately owned by the plugin so Playnite's host theme cannot
         reintroduce bright native scrollbars, progress tracks, or ComboBox popups. -->
    <Style x:Key="GscComboBox" TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" OverridesDefaultStyle="True"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" CornerRadius="10" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                            <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center" TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"/>
                                            <Path x:Name="Chevron" Grid.Column="1" Data="M 1 2 L 5 6 L 9 2" Stretch="None" Stroke="{DynamicResource GscSecondaryTextBrush}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                            <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom"
                               AllowsTransparency="{DynamicResource GscPopupAllowsTransparency}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False"
                               PopupAnimation="{DynamicResource GscPopupAnimation}">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,6,0,8" Padding="5"
                                    Background="{DynamicResource GscPopupBrush}" BorderBrush="{DynamicResource GscGlassStrokeBrush}" BorderThickness="1" CornerRadius="11"
                                    Effect="{DynamicResource GscPopupEffect}">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.46"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GscComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GscSharedFocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/><Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Overlay scrollbars use one rounded Rectangle per Thumb. Do not compose the
         capsule from overlapping semi-transparent shapes: overlapping alpha produces
         bright cap artifacts, while a single inset shape keeps both ends symmetric. -->
    <ControlTemplate x:Key="GscVerticalScrollThumbTemplate" TargetType="Thumb">
        <Grid MinWidth="12"
              MinHeight="36"
              Background="Transparent"
              ClipToBounds="True"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
            <Rectangle x:Name="ThumbChrome"
                       Margin="2,1"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Fill="{TemplateBinding Background}"
                       RadiusX="4"
                       RadiusY="4"
                       SnapsToDevicePixels="True"/>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="GscHorizontalScrollThumbTemplate" TargetType="Thumb">
        <Grid MinWidth="36"
              MinHeight="12"
              Background="Transparent"
              ClipToBounds="True"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True">
            <Rectangle x:Name="ThumbChrome"
                       Margin="1,2"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Fill="{TemplateBinding Background}"
                       RadiusX="4"
                       RadiusY="4"
                       SnapsToDevicePixels="True"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="GscScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource GscScrollThumbBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GscScrollThumbHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource GscAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.34"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root"
                          Background="Transparent"
                          ClipToBounds="True"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <Track x:Name="PART_Track"
                               Margin="0,4"
                               Focusable="False"
                               IsDirectionReversed="True"
                               Orientation="{TemplateBinding Orientation}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.Resources>
                                <!-- WPF Track does not use Thumb.MinHeight/MinWidth as the proportional
                                     scroll-thumb floor. Its minimum is half of these system metrics.
                                     Override them locally so huge collections still render a usable
                                     36-DIP capsule rather than a one-pixel spike. -->
                                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">72</sys:Double>
                                <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">72</sys:Double>
                            </Track.Resources>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton"
                                              Command="ScrollBar.PageUpCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              OverridesDefaultStyle="True"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ScrollThumb"
                                       Style="{StaticResource GscScrollThumb}"
                                       Width="12"
                                       MinHeight="36"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Template="{StaticResource GscVerticalScrollThumbTemplate}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton"
                                              Command="ScrollBar.PageDownCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              OverridesDefaultStyle="True"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="12"/>
                            <Setter Property="MinWidth" Value="12"/>
                            <Setter TargetName="PART_Track" Property="Margin" Value="0,4"/>
                            <Setter TargetName="ScrollThumb" Property="Width" Value="12"/>
                            <Setter TargetName="ScrollThumb" Property="Height" Value="Auto"/>
                            <Setter TargetName="ScrollThumb" Property="MinWidth" Value="12"/>
                            <Setter TargetName="ScrollThumb" Property="MinHeight" Value="36"/>
                            <Setter TargetName="ScrollThumb" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="ScrollThumb" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="ScrollThumb" Property="Template" Value="{StaticResource GscVerticalScrollThumbTemplate}"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="12"/>
                            <Setter Property="MinHeight" Value="12"/>
                            <Setter TargetName="PART_Track" Property="Margin" Value="4,0"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            <Setter TargetName="ScrollThumb" Property="Width" Value="Auto"/>
                            <Setter TargetName="ScrollThumb" Property="Height" Value="12"/>
                            <Setter TargetName="ScrollThumb" Property="MinWidth" Value="36"/>
                            <Setter TargetName="ScrollThumb" Property="MinHeight" Value="12"/>
                            <Setter TargetName="ScrollThumb" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="ScrollThumb" Property="VerticalAlignment" Value="Stretch"/>
                            <Setter TargetName="ScrollThumb" Property="Template" Value="{StaticResource GscHorizontalScrollThumbTemplate}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscPopupBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MaxWidth" Value="620"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource GscAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
                <Setter Property="ToolTip" Value="正在进行；完成时间取决于实际任务。"/>
                <Setter Property="Foreground" Value="{DynamicResource GscInfoBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
