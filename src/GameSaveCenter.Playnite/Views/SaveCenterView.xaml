<UserControl x:Class="GameSaveCenter.Playnite.Views.SaveCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource GscPrimaryTextBrush}" TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="SaveDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/><Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/><Setter Property="MinHeight" Value="{DynamicResource GscTableMinHeight}"/><Setter Property="ColumnHeaderHeight" Value="{DynamicResource GscTableHeaderHeight}"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="CanUserSortColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style>
            <Style x:Key="SaveTableFrame" TargetType="Border"><Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="1"/></Style>
            <Style x:Key="SaveLongText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
            <Style x:Key="SaveFirstHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="SaveLastHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="SaveTabControl" TargetType="TabControl" BasedOn="{StaticResource GscRedesignWorkspaceTabControl}"/>
            <Style x:Key="SaveTabItem" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <TabControl Style="{StaticResource SaveTabControl}"><TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource SaveTabItem}"/></TabControl.Resources>
            <TabItem Header="历史版本"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource SaveTableFrame}"><DataGrid Style="{StaticResource SaveDataGrid}" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"><DataGrid.Columns><DataGridTextColumn HeaderStyle="{StaticResource SaveFirstHeader}" Header="时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/><DataGridTextColumn Header="类型" Binding="{Binding IsPreRestore, Mode=OneWay}" Width="82"/><DataGridTextColumn Header="文件数" Binding="{Binding FileCount, Mode=OneWay}" Width="82"/><DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay, Mode=OneWay}" Width="90"/><DataGridTextColumn Header="设备" Binding="{Binding SourceDevice, Mode=OneWay}" Width="120"/><DataGridTextColumn Header="备注" Binding="{Binding Comment, Mode=OneWay}" Width="*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn HeaderStyle="{StaticResource SaveLastHeader}" Header="状态" Binding="{Binding IsLocked, Mode=OneWay}" Width="90"/></DataGrid.Columns></DataGrid></Border>
                <ScrollViewer x:Name="SaveHistoryActionsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220" Margin="0,10,0,0"><Border Style="{DynamicResource GscSurface}" Padding="12"><WrapPanel><TextBlock Text="备注：" VerticalAlignment="Center"/><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding BackupComment, UpdateSourceTrigger=PropertyChanged}" MinWidth="220" Margin="4,0,8,0"/><CheckBox Style="{DynamicResource GscCheckBox}" Content="锁定" IsChecked="{Binding LockSelectedBackup}" VerticalAlignment="Center" Margin="0,0,10,0"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding UpdateBackupMetadataCommand}" Content="保存元数据"/><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding RestoreCommand}" Content="恢复"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding CompareBackupCommand}" Content="比较"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding UndoRestoreCommand}" Content="撤销恢复"/></WrapPanel></Border></ScrollViewer>
            </Grid></TabItem>
            <TabItem Header="候选路径"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource SaveTableFrame}"><DataGrid Style="{StaticResource SaveDataGrid}" ItemsSource="{Binding SaveCandidates}" SelectedItem="{Binding SelectedCandidate}"><DataGrid.Columns><DataGridTextColumn HeaderStyle="{StaticResource SaveFirstHeader}" Header="可信度" Binding="{Binding Score, Mode=OneWay, StringFormat=P0}" Width="78"/><DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="90"/><DataGridTextColumn Header="路径" Binding="{Binding Path, Mode=OneWay}" Width="*" MinWidth="300"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn HeaderStyle="{StaticResource SaveLastHeader}" Header="依据" Binding="{Binding ReasonsDisplay, Mode=OneWay}" Width="1.2*" MinWidth="250"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource SaveLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Border>
                <ScrollViewer x:Name="SaveCandidateReasonScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="180" Margin="0,10,0,0"><Border Style="{DynamicResource GscSurface}" Padding="12"><TextBlock Text="{Binding SelectedCandidate.ReasonsDisplay, TargetNullValue=选择候选路径后查看判断依据}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}"/></Border></ScrollViewer>
                <ScrollViewer x:Name="SaveCandidateActionsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="140" Margin="0,10,0,0"><WrapPanel><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding DetectPathsCommand}" Content="立即扫描"/><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding AcceptCandidateCommand}" Content="接受并生成规则草案"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding RejectCandidateCommand}" Content="忽略候选"/></WrapPanel></ScrollViewer>
            </Grid></TabItem>
            <TabItem Header="备份策略"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><Border Style="{DynamicResource GscSurface}" Padding="14"><StackPanel><TextBlock Text="当前游戏自动任务" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="存档与媒体自动化可以按当前游戏独立关闭；手动备份和手动同步仍可使用。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/><WrapPanel><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="启用自动任务" IsChecked="{Binding SelectedGame.Policy.Enabled}" Margin="0,0,18,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="退出后备份" IsChecked="{Binding SelectedGame.Policy.BackupOnGameStop}" Margin="0,0,18,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="游玩中备份" IsChecked="{Binding SelectedGame.Policy.BackupDuringPlay}" Margin="0,0,18,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="上传云端" IsChecked="{Binding SelectedGame.Policy.UploadAfterBackup}" Margin="0,0,18,8"/></WrapPanel><WrapPanel Margin="0,8,0,0"><TextBlock Text="游玩间隔（分钟）" VerticalAlignment="Center"/><TextBox Style="{DynamicResource GscNumericTextBox}" Width="90" Text="{Binding SelectedGame.Policy.DuringPlayIntervalMinutes, UpdateSourceTrigger=LostFocus}" Margin="8,0,12,0"/><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SavePolicyCommand}" Content="保存策略"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding PreviewRetentionCommand}" Content="预览保留策略"/></WrapPanel><TextBlock Text="{Binding RetentionSummary}" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border></ScrollViewer></TabItem>
        </TabControl>
    </Grid>
</UserControl>
