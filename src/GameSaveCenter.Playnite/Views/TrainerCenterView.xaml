<UserControl x:Class="GameSaveCenter.Playnite.Views.TrainerCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource GscPrimaryTextBrush}" TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/><ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="TrainerTabControl" TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style>
            <Style x:Key="TrainerTabItem" TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="Padding" Value="14,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style>
            <Style x:Key="TrainerTableFrame" TargetType="Border"><Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="1"/></Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0"><TabControl Style="{StaticResource TrainerTabControl}"><TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource TrainerTabItem}"/></TabControl.Resources>
        <TabItem Header="已安装"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel><TextBlock Text="当前游戏工具" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,8"/><ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding ImportTrainerCommand}" Content="导入修改器" Margin="0,0,8,8"/><ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding ImportToolFolderCommand}" Content="导入目录" Margin="0,0,8,8"/><ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding ImportCheatTableCommand}" Content="导入 CT" Margin="0,0,0,8"/></WrapPanel>
            <Border Grid.Row="1" Style="{StaticResource TrainerTableFrame}"><ListBox ItemsSource="{Binding GameTools}" SelectedItem="{Binding SelectedGameTool}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource GscAccentTintStrongBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,12,0"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"><Run Text="{Binding TypeDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SourceDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ActiveVersion.VersionName, Mode=OneWay}"/></TextBlock></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding FileStateDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding AutoStart, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
            <Border Grid.Row="2" Style="{DynamicResource GscSurface}" Padding="14" Margin="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="工具设置" FontSize="15" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock Text="{Binding SelectedGameTool.DisplayName, TargetNullValue=选择一个工具}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGameTool.DisplayName}"/><WrapPanel Margin="0,8,0,0"><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="启用" IsChecked="{Binding SelectedGameTool.Enabled}" Margin="0,0,18,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="随游戏启动" IsChecked="{Binding SelectedGameTool.AutoStart}" Margin="0,0,18,8"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="退出后关闭" IsChecked="{Binding SelectedGameTool.CloseOnGameExit}" Margin="0,0,18,8"/></WrapPanel></StackPanel><WrapPanel Grid.Row="2" Margin="0,10,0,0"><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding LaunchGameToolCommand}" Content="启动"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding SaveGameToolCommand}" Content="保存设置"/><ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding OpenGameToolDirectoryCommand}" Content="打开目录"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding DeleteGameToolCommand}" Content="解除绑定"/></WrapPanel></Grid></Border>
        </Grid></TabItem>
        <TabItem Header="FLiNG 在线库"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{DynamicResource GscSurface}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding TrainerSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入游戏名称，搜索本地缓存的 FLiNG 目录"/><ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SearchTrainerCatalogCommand}" Content="搜索" Margin="8,0,8,0"/><ui:Button Grid.Column="2" Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding SyncTrainerCatalogCommand}" Content="刷新目录"/></Grid></Border><Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource TrainerTableFrame}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="搜索结果" FontWeight="SemiBold" Margin="12,10"/><ListBox Grid.Row="1" ItemsSource="{Binding TrainerCatalogResults}" SelectedItem="{Binding SelectedTrainerCatalogItem}" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12,7"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"><Run Text="FLiNG · "/><Run Text="{Binding GameVersion, Mode=OneWay, TargetNullValue=版本未标注}"/><Run Text=" · "/><Run Text="{Binding OptionCount, Mode=OneWay}"/><Run Text=" 项功能"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><Border Grid.Column="2" Style="{StaticResource TrainerTableFrame}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="可下载版本" FontWeight="SemiBold" Margin="12,10"/><ListBox Grid.Row="1" ItemsSource="{Binding TrainerReleases}" SelectedItem="{Binding SelectedTrainerRelease}" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Grid Margin="12,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding VersionDisplay}" FontWeight="SemiBold"/><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0"><Run Text="{Binding OptionCountDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PublishedDisplay, Mode=OneWay}"/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="{DynamicResource GscSecondaryTextBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><ui:Button Grid.Row="2" Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding DownloadTrainerCommand}" Content="下载并绑定当前游戏" Margin="12" HorizontalAlignment="Stretch"/></Grid></Border></Grid></Grid></TabItem>
    </TabControl></Grid>
</UserControl>




