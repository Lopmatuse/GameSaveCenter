                                                <Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyText}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedBackup}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TabControl x:Name="SaveHistoryInspectorTabs" Margin="0">
                                            <TabControl.Style>
                                                <Style TargetType="TabControl" BasedOn="{StaticResource GscTabControl}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedBackup}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TabControl.Style>
                                            <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource GscTabItem}"/></TabControl.Resources>

                                            <TabItem Header="版本详情">
                                                <ScrollViewer x:Name="SaveHistoryDetailsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                              PanningMode="VerticalOnly" CanContentScroll="False" Padding="0,10,8,0"
                                                              PreviewMouseWheel="OnInspectorPreviewMouseWheel">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource GscRedesignSectionTitle}" Text="选中版本"/>
                                                        <TextBlock Text="{Binding SelectedBackup.CreatedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                   FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <UniformGrid Columns="2" Margin="0,14,0,0">
                                                            <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel><TextBlock Text="大小" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedBackup.SizeDisplay, Mode=OneWay}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                                            <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,0,8"><StackPanel><TextBlock Text="文件数量" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedBackup.FileCount, Mode=OneWay}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                                            <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,8,8"><StackPanel><TextBlock Text="来源设备" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedBackup.SourceDevice, Mode=OneWay, TargetNullValue=--}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedBackup.SourceDevice, Mode=OneWay}"/></StackPanel></Border>
                                                            <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,0,8"><StackPanel><TextBlock Text="系统" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedBackup.OperatingSystem, Mode=OneWay, TargetNullValue=--}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedBackup.OperatingSystem, Mode=OneWay}"/></StackPanel></Border>
                                                            <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,8,0"><StackPanel><TextBlock Text="恢复前快照" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock FontWeight="SemiBold" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Text" Value="否"/><Style.Triggers><DataTrigger Binding="{Binding SelectedBackup.IsPreRestore}" Value="True"><Setter Property="Text" Value="是"/><Setter Property="Foreground" Value="{DynamicResource GscInfoBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                                                            <Border Style="{StaticResource GscRedesignContextPill}"><StackPanel><TextBlock Text="锁定状态" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock FontWeight="SemiBold" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Text" Value="未锁定"/><Style.Triggers><DataTrigger Binding="{Binding SelectedBackup.IsLocked}" Value="True"><Setter Property="Text" Value="已锁定"/><Setter Property="Foreground" Value="{DynamicResource GscWarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                                                        </UniformGrid>
                                                        <Border Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,14,0,0">
                                                            <StackPanel>
                                                                <TextBlock Text="比较与保留结果" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DiffSummary}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,8,0,0"/>
                                                                <TextBlock Text="{Binding RetentionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>
