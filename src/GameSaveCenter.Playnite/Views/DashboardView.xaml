                                                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="游戏退出后关闭" OnContent="开" OffContent="关" IsChecked="{Binding SelectedGameTool.CloseOnGameExit}" Margin="0,0,0,10"/>
                                                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="管理员权限" OnContent="开" OffContent="关" IsChecked="{Binding SelectedGameTool.RequiresAdmin}" Margin="0,0,0,12"/>
                                                    <DockPanel LastChildFill="False">
