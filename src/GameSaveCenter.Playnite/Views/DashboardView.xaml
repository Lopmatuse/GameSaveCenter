                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding Snapshot.BackupFormat}" Value="{x:Static contracts:BackupStorageFormat.Simple}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
