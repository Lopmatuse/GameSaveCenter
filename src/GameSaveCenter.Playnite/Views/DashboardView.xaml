<UserControl x:Class="GameSaveCenter.Playnite.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:GameSaveCenter.Contracts;assembly=GameSaveCenter.Contracts"
             Foreground="{DynamicResource GscPrimaryTextBrush}" Background="Transparent"
             TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="GscFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" CornerRadius="11" BorderThickness="2"
                                BorderBrush="{StaticResource GscAccentBrush}" Opacity="0.72"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000" BlurRadius="14" ShadowDepth="2" Opacity="0.32"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscMetricCard" TargetType="Border" BasedOn="{StaticResource GscSurface}">
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinHeight" Value="80"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <EventSetter Event="MouseEnter" Handler="OnMetricCardMouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnMetricCardMouseLeave"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource GscAccentTintStrongBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GscButtonBase" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GscAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <EventSetter Event="MouseEnter" Handler="OnButtonMouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnButtonMouseLeave"/>
        </Style>

        <Style x:Key="GscPrimaryButton" TargetType="Button" BasedOn="{StaticResource GscButtonBase}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B6BFF" Offset="0"/>
                        <GradientStop Color="#6848EE" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#8A72FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect><DropShadowEffect Color="#487C5CFC" BlurRadius="12" ShadowDepth="2" Opacity="0.38"/></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscContextButton" TargetType="Button" BasedOn="{StaticResource GscButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GscTextBox" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="CaretBrush" Value="{StaticResource GscAccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GscAccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="5" BorderThickness="1"
                                    BorderBrush="{DynamicResource GscDividerBrush}" Background="{DynamicResource GscControlFillBrush}" VerticalAlignment="Center">
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource GscAccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GscAccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GscAccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" CornerRadius="10"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"/>
                                                <Path x:Name="Chevron" Grid.Column="1" Data="M 1 2 L 5 6 L 9 2" Stretch="None"
                                                      Stroke="{DynamicResource GscSecondaryTextBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GscAccentTintStrongBrush}"/>
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GscAccentBrush}"/>
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320" Margin="0,6,0,8" Padding="5"
                                        Background="{DynamicResource GscPopupBrush}"
                                        BorderBrush="{DynamicResource GscGlassStrokeBrush}" BorderThickness="1" CornerRadius="11">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#52000000" BlurRadius="20" ShadowDepth="5" Opacity="0.42"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource GscAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource GscAccentTintStrongBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GscAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.46"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscTabItem" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TabBackground" Background="Transparent" CornerRadius="9"/>
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                            <Border x:Name="Indicator" Height="2" Background="Transparent" VerticalAlignment="Bottom" CornerRadius="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource GscAccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GscAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="{StaticResource GscAccentTintBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscDataGrid" TargetType="DataGrid">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GscDividerBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#087C5CFC"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,8"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0CFFFFFF"/></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Grid>
                                <Border x:Name="SelectionIndicator" Width="2" Margin="3,8,0,8" CornerRadius="1"
                                        HorizontalAlignment="Left" Background="{StaticResource GscAccentBrush}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#0CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscNavItem" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{StaticResource GscAccentTintStrongBrush}"/>
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{StaticResource GscAccentTintStrongBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource GscAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseEnter" Handler="OnNavigationMouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnNavigationMouseLeave"/>
        </Style>

        <Style x:Key="GscEmptyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="22"/>
        </Style>

        <Style x:Key="GscStatusPill" TargetType="Border">
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootShell" Background="{DynamicResource GscBackdropBrush}" ClipToBounds="True">
        <Grid x:Name="AmbientGlowLayer" IsHitTestVisible="False" Opacity="0.9">
            <Ellipse Width="360" Height="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-95,-130,0,0" Fill="#267C5CFC">
                <Ellipse.Effect><BlurEffect Radius="82"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="320" Height="320" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,35,-105,0" Fill="#1E0A84FF">
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,20,-165" Fill="#1830D158">
                <Ellipse.Effect><BlurEffect Radius="96"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <Grid x:Name="ResponsiveShell" Margin="18,16,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="194"/>
                <ColumnDefinition x:Name="SidebarGutterColumn" Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource GscSidebarBrush}" BorderBrush="{DynamicResource GscGlassStrokeBrush}" BorderThickness="1" CornerRadius="22" Padding="15">
                <Border.Effect><DropShadowEffect Color="#26000000" BlurRadius="24" ShadowDepth="3" Opacity="0.35"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="3,3,3,20">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource GscAccentBrush}" ToolTip="GameSaveCenter">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                            </Border>
                            <StackPanel x:Name="SidebarBrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GameSaveCenter" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="SidebarVersionText" Text="v0.5.7" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource GscDividerBrush}" Margin="0,0,0,15"/>
                    <StackPanel Grid.Row="2">
                        <RadioButton x:Name="NavOverview" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" IsChecked="True" Tag="Overview" Checked="OnNavigationChecked" ToolTip="首页">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="27" FontSize="16"/><TextBlock x:Name="NavOverviewLabel" Text="首页" FontWeight="SemiBold"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSaves" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Saves" Checked="OnNavigationChecked" ToolTip="存档中心">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Width="27" FontSize="16"/><TextBlock x:Name="NavSavesLabel" Text="存档中心"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTrainers" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Trainers" Checked="OnNavigationChecked" ToolTip="修改器中心">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Width="27" FontSize="16"/><TextBlock x:Name="NavTrainersLabel" Text="修改器中心"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMedia" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Media" Checked="OnNavigationChecked" ToolTip="媒体中心">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;" Width="27" FontSize="16"/><TextBlock x:Name="NavMediaLabel" Text="媒体中心"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTasks" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Tasks" Checked="OnNavigationChecked" ToolTip="任务中心">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" Width="27" FontSize="16"/><TextBlock x:Name="NavTasksLabel" Text="任务中心"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMaintenance" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Maintenance" Checked="OnNavigationChecked" ToolTip="维护中心">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Width="27" FontSize="16"/><TextBlock x:Name="NavMaintenanceLabel" Text="维护中心"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <StackPanel x:Name="SidebarStatusPanel" Grid.Row="3" Margin="4,12,4,2" ToolTip="Worker 与 Ludusavi 运行状态">
                        <Border Height="1" Background="{DynamicResource GscDividerBrush}" Margin="0,0,0,13"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="9" Height="9" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource GscErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="True"><Setter Property="Background" Value="{StaticResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            </Border>
                            <StackPanel x:Name="SidebarWorkerStatusText" Orientation="Horizontal">
                                <TextBlock Text="Worker" FontSize="12" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource GscSecondaryTextBrush}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="Text" Value=" 正常"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="False"><Setter Property="Text" Value=" 不可用"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="SidebarLudusaviStatusText" Text="{Binding Snapshot.LudusaviVersion, StringFormat=Ludusavi：{0}}" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MainShell" Grid.Column="2" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleText" Text="首页" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageSubtitleText" Text="存档、修改器、媒体与任务的一体化工作台" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/>
                <ComboBox x:Name="CompactGameSelector" Visibility="Collapsed" Margin="0,8,0,0" Width="230"
                          ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}"
                          ToolTip="在紧凑布局中切换当前游戏">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <WrapPanel x:Name="TopActionsPanel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <!-- Background refresh never inserts an element into this WrapPanel. Keeping the toolbar's
                     measured width stable prevents timer-driven page movement when actions would wrap. -->
                <Button x:Name="TopRefreshButton" Style="{StaticResource GscButtonBase}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,8,0"/><TextBlock Text="刷新"/></StackPanel>
                </Button>
                <Button x:Name="TopBackupAllButton" Style="{StaticResource GscButtonBase}" Command="{Binding BackupAllCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Margin="0,0,8,0"/><TextBlock Text="全部备份"/></StackPanel>
                </Button>
                <Button x:Name="TopMediaSyncButton" Style="{StaticResource GscButtonBase}" Command="{Binding SyncMediaCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" Margin="0,0,8,0"/><TextBlock Text="同步媒体"/></StackPanel>
                </Button>
                <Button x:Name="TopTrainerImportButton" Style="{StaticResource GscButtonBase}" Command="{Binding ImportTrainerCommand}" Visibility="Collapsed" Content="导入修改器"/>
                <Button x:Name="TopTrainerCatalogButton" Style="{StaticResource GscButtonBase}" Command="{Binding SyncTrainerCatalogCommand}" Visibility="Collapsed" Content="刷新目录"/>
                <Button x:Name="TopDiagnosticsButton" Style="{StaticResource GscButtonBase}" Command="{Binding RefreshDiagnosticsCommand}" Visibility="Collapsed" Content="刷新诊断"/>
            </WrapPanel>
        </Grid>

        <UniformGrid x:Name="MetricsPanel" Grid.Row="1" Columns="6" Margin="0,0,0,18">
            <Border Style="{StaticResource GscMetricCard}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#247C5CFC"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" Foreground="{StaticResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="管理游戏" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.ManagedGames}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource GscMetricCard}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#220A84FF"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Foreground="{StaticResource GscInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="已匹配存档" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.MatchedGames}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource GscMetricCard}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#2030D158"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Foreground="{StaticResource GscSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="正在运行" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.RunningGames}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource GscMetricCard}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#20FF453A"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB52;" Foreground="{StaticResource GscErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="需要关注" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.WarningGames}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource GscMetricCard}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#220A84FF"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" Foreground="{StaticResource GscInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="云端任务" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.PendingCloudTasks}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource GscMetricCard}" Margin="0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="#20FF9F0A"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE91B;" Foreground="{StaticResource GscWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="待归类媒体" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.UnassignedMediaCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GameListColumn" Width="0.95*"/>
                <ColumnDefinition x:Name="WorkspaceGutterColumn" Width="16"/>
                <ColumnDefinition x:Name="GameDetailColumn" Width="2.05*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="GameBrowserPanel" Style="{StaticResource GscSurface}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="游戏与状态" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource GscMutedTextBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding FilteredGameCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Snapshot.ManagedGames, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid x:Name="SearchBoxContainer" Margin="0,0,0,8">
                            <TextBox Style="{StaticResource GscTextBox}" Text="{Binding GameSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="搜索游戏名、Ludusavi 名称、平台或状态" Padding="30,7,10,7"/>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="{DynamicResource GscMutedTextBrush}"
                                       Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="搜索游戏…" Foreground="{DynamicResource GscMutedTextBrush}" Margin="30,0,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding GameSearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="2">
                            <ComboBox ItemsSource="{Binding GameStatusFilterOptions}" SelectedItem="{Binding GameStatusFilter}" Margin="0,0,4,0" ToolTip="状态筛选"/>
                            <ComboBox ItemsSource="{Binding GameSortOptions}" SelectedItem="{Binding GameSortMode}" Margin="4,0,0,0" ToolTip="排序"/>
                        </UniformGrid>
                    </Grid>
                    <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="11" Padding="11,9">
                                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <Border x:Name="SelectionIndicator" Width="2" Margin="3,9,0,9" CornerRadius="1"
                                                        HorizontalAlignment="Left" Background="{StaticResource GscAccentBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                                                    <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#0CFFFFFF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#247C5CFC" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" Foreground="{StaticResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PlatformDisplay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="StateDot" Width="8" Height="8" CornerRadius="4" Background="{StaticResource GscWarningBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding HealthStateDisplay}" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HealthState}" Value="Ready"><Setter TargetName="StateDot" Property="Background" Value="{StaticResource GscSuccessBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding HealthState}" Value="Attention"><Setter TargetName="StateDot" Property="Background" Value="{StaticResource GscErrorBrush}"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="没有符合条件的游戏&#x0a;请调整搜索或筛选条件。" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding FilteredGameCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="GameDetailCard" Grid.Column="2" Style="{StaticResource GscSurface}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="SelectedGameHeader">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=请选择游戏}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource GscAccentTintBrush}" CornerRadius="9" Padding="9,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource GscWarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Ready"><Setter Property="Background" Value="{StaticResource GscSuccessBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Attention"><Setter Property="Background" Value="{StaticResource GscErrorBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="LudusaviUnavailable"><Setter Property="Background" Value="{StaticResource GscErrorBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedGame.HealthStateDisplay}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedGame.LudusaviName, StringFormat=Ludusavi：{0}, TargetNullValue=Ludusavi：未匹配}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button x:Name="BackupSelectedButton" Style="{StaticResource GscPrimaryButton}" Command="{Binding BackupSelectedCommand}" Content="立即备份"/>
                            <Button x:Name="ValidateButton" Style="{StaticResource GscButtonBase}" Command="{Binding ValidateCommand}" Content="校验"/>
                            <Button x:Name="DetectPathsButton" Style="{StaticResource GscButtonBase}" Command="{Binding DetectPathsCommand}" Content="侦测路径"/>
                            <Button x:Name="PolicyToggleButton" Style="{StaticResource GscButtonBase}" Click="OnTogglePolicy" Content="策略"/>
                        </WrapPanel>
                    </Grid>

                    <Border x:Name="RestoreSafetyBanner" Grid.Row="1" Background="#140A84FF" BorderBrush="#330A84FF" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,14,0,12">
                        <DockPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="{StaticResource GscInfoBrush}" FontSize="16" Margin="0,0,9,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="自动恢复默认关闭。恢复前会创建并锁定当前快照，恢复后校验，失败时尝试回滚。" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <Border x:Name="BackupPolicyPanel" Grid.Row="2" Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox Content="退出后备份" IsChecked="{Binding SelectedGame.Policy.BackupOnGameStop}" Margin="0,3,18,3"/>
                            <CheckBox Content="游玩中备份" IsChecked="{Binding SelectedGame.Policy.BackupDuringPlay}" Margin="0,3,12,3"/>
                            <TextBlock Text="间隔" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource GscTextBox}" Width="58" Text="{Binding SelectedGame.Policy.DuringPlayIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" ToolTip="允许 1–1440 分钟；Worker 会在到期后 5 秒内开始排队备份。" Margin="7,0,7,0"/>
                            <TextBlock Text="分钟" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <CheckBox Content="上传云端" IsChecked="{Binding SelectedGame.Policy.UploadAfterBackup}" Margin="0,3,12,3"/>
                            <Button Style="{StaticResource GscButtonBase}" Command="{Binding SavePolicyCommand}" Content="保存策略" Margin="0"/>
                        </WrapPanel>
                    </Border>

                    <TabControl x:Name="DetailsTabControl" Grid.Row="3" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                SelectionChanged="OnDetailsTabSelectionChanged">
                        <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource GscTabItem}"/></TabControl.Resources>
                        <TabItem x:Name="OverviewTab" Header="概览">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource GscSurface}" CornerRadius="14" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="需要处理" FontSize="16" FontWeight="SemiBold"/>
                                        <StackPanel Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource GscSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                            <Setter Property="Text" Value="Worker 运行正常"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="False"><Setter Property="Text" Value="Worker 当前不可用"/><Setter Property="Foreground" Value="{StaticResource GscErrorBrush}"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WarningGames}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource GscWarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock><Run Text="{Binding Snapshot.WarningGames, Mode=OneWay}"/><Run Text=" 个游戏需要关注"/></TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Snapshot.UnassignedMediaCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource GscWarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock><Run Text="{Binding Snapshot.UnassignedMediaCount, Mode=OneWay}"/><Run Text=" 个媒体文件等待归类"/></TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Snapshot.WarningGames}" Value="0"/>
                                                                    <Condition Binding="{Binding Snapshot.UnassignedMediaCount}" Value="0"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Foreground="{StaticResource GscSuccessBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="当前没有需要手工处理的问题" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource GscSurface}" CornerRadius="12" Padding="2" Margin="0,12,0,0">
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding OverviewTasks}" SelectedItem="{Binding SelectedTask}" IsReadOnly="True">
                                        <DataGrid.Columns><DataGridTextColumn Header="最近任务（最多 8 条）" Binding="{Binding TaskTypeDisplay, Mode=OneWay}" Width="150"/><DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="100"/></DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="SaveHistoryTab" Header="存档历史">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource GscSurface}" CornerRadius="12" Padding="2">
                                    <Grid>
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="本地时间" Binding="{Binding CreatedLocal, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                                            <DataGridTextColumn Header="文件" Binding="{Binding FileCount}" Width="65"/>
                                            <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="95"/>
                                            <DataGridCheckBoxColumn Header="锁定" Binding="{Binding IsLocked}" Width="60"/>
                                            <DataGridTextColumn Header="备注" Binding="{Binding Comment}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="尚无历史版本&#x0a;完成一次有效备份后会显示在这里。" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyText}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Backups.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <Border Background="#14FF9F0A" BorderBrush="#38FF9F0A" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Snapshot.BackupFormat}" Value="{x:Static contracts:BackupStorageFormat.Simple}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="当前为 Simple 格式，只维护一个当前副本；需要多个恢复点请在设置中选择 ZIP。" TextWrapping="Wrap"/>
                                    </Border>
                                    <WrapPanel>
                                        <Button Style="{StaticResource GscButtonBase}" Command="{Binding RestoreCommand}" Content="安全恢复所选版本"/>
                                        <Button Style="{StaticResource GscButtonBase}" Command="{Binding UndoRestoreCommand}" Content="撤销最近恢复"/>
                                        <Button Style="{StaticResource GscButtonBase}" Command="{Binding CompareBackupCommand}" Content="与上一版本比较"/>
                                        <Button Style="{StaticResource GscButtonBase}" Command="{Binding PreviewRetentionCommand}" Content="保留策略预览"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <CheckBox Content="锁定版本" IsChecked="{Binding LockSelectedBackup}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                        <TextBox Style="{StaticResource GscTextBox}" Width="280" Text="{Binding BackupComment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" ToolTip="版本备注"/>
                                        <Button Style="{StaticResource GscButtonBase}" Command="{Binding UpdateBackupMetadataCommand}" Content="保存备注/锁定"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding DiffSummary}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding RetentionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="TrainerTab" Header="修改器">
                            <TabControl Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource GscTabItem}"/></TabControl.Resources>
                                <TabItem Header="已安装">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                                        <Grid Grid.ColumnSpan="3">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="当前游戏工具" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="每个工具独立决定是否随游戏启动；新导入项目默认关闭自动启动。" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource GscButtonBase}" Command="{Binding ImportTrainerCommand}" Content="导入修改器"/>
                                                <Button Style="{StaticResource GscButtonBase}" Command="{Binding ImportToolFolderCommand}" Content="导入目录"/>
                                                <Button Style="{StaticResource GscButtonBase}" Command="{Binding ImportCheatTableCommand}" Content="导入 CT" Margin="0"/>
                                            </WrapPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                            <ListBox ItemsSource="{Binding GameTools}" SelectedItem="{Binding SelectedGameTool}" BorderThickness="0"
                                                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                                        <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="ToolCard" Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}"
                                                                        BorderThickness="1" CornerRadius="14" Padding="14">
                                                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="ToolCard" Property="BorderBrush" Value="{StaticResource GscAccentBrush}"/>
                                                                        <Setter TargetName="ToolCard" Property="Background" Value="{StaticResource GscAccentTintBrush}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToolCard" Property="BorderBrush" Value="{StaticResource GscAccentTintStrongBrush}"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate></Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource GscAccentTintStrongBrush}">
                                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Foreground="{StaticResource GscAccentBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                                <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0">
                                                                    <Run Text="{Binding TypeDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SourceDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ActiveVersion.VersionName, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileStateDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,3,0,0">
                                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                                        <Setter Property="Text" Value="仅手动启动"/>
                                                                        <Style.Triggers><DataTrigger Binding="{Binding AutoStart}" Value="True"><Setter Property="Text" Value="随游戏启动"/></DataTrigger></Style.Triggers>
                                                                    </Style></TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding GameTools.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" FontSize="28" Foreground="{DynamicResource GscMutedTextBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="尚未绑定修改器或 Cheat Table" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                                <TextBlock Text="可以导入本地文件，或在 FLiNG 在线库中搜索并下载。" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource GscGlassStrongBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="工具设置" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SelectedGameTool.DisplayName, TargetNullValue=选择一个工具以调整启动设置}"
                                                               Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGameTool.DisplayName}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                                    <CheckBox Content="启用" IsChecked="{Binding SelectedGameTool.Enabled}" Margin="0,0,0,10"/>
                                                    <CheckBox Content="随游戏启动" IsChecked="{Binding SelectedGameTool.AutoStart}" Margin="0,0,0,10"/>
                                                    <CheckBox Content="游戏退出后关闭" IsChecked="{Binding SelectedGameTool.CloseOnGameExit}" Margin="0,0,0,10"/>
                                                    <CheckBox Content="管理员权限" IsChecked="{Binding SelectedGameTool.RequiresAdmin}" Margin="0,0,0,12"/>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Text="启动延迟" VerticalAlignment="Center"/>
                                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource GscTextBox}" Width="62"
                                                                 Text="{Binding SelectedGameTool.LaunchDelaySeconds}" ToolTip="启动延迟（秒）"/>
                                                    </DockPanel>
                                                </StackPanel>
                                                <WrapPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,18,0,0">
                                                    <Button Style="{StaticResource GscPrimaryButton}" Command="{Binding LaunchGameToolCommand}" Content="启动"/>
                                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding SaveGameToolCommand}" Content="保存设置"/>
                                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding OpenGameToolDirectoryCommand}" Content="打开目录"/>
                                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding DeleteGameToolCommand}" Content="解除绑定" Margin="0"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="FLiNG 在线库">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource GscTextBox}" Text="{Binding TrainerSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入英文游戏名；留空时使用当前 Playnite 游戏名"/>
                                                <Button Grid.Column="1" Style="{StaticResource GscPrimaryButton}" Command="{Binding SearchTrainerCatalogCommand}" Content="搜索" Margin="10,0"/>
                                                <Button Grid.Column="2" Style="{StaticResource GscButtonBase}" Command="{Binding SyncTrainerCatalogCommand}" Content="刷新目录" Margin="0"/>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource GscSurface}" CornerRadius="14" Padding="12">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock Text="搜索结果" FontWeight="SemiBold" Margin="2,0,0,9"/>
                                                    <ListBox Grid.Row="1" ItemsSource="{Binding TrainerCatalogResults}" SelectedItem="{Binding SelectedTrainerCatalogItem}" Background="Transparent" BorderThickness="0"
                                                             SelectionChanged="OnTrainerCatalogSelectionChanged">
                                                        <ListBox.ItemTemplate><DataTemplate>
                                                            <StackPanel Margin="5,6">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                                <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0">
                                                                    <Run Text="FLiNG · "/><Run Text="{Binding GameVersion, Mode=OneWay, TargetNullValue=版本未标注}"/><Run Text=" · "/><Run Text="{Binding OptionCount, Mode=OneWay}"/><Run Text=" 项功能"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate></ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <Button Grid.Row="2" Style="{StaticResource GscButtonBase}" Command="{Binding LoadTrainerReleasesCommand}" Content="重新读取可下载版本" Margin="0,10,0,0"/>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource GscSurface}" CornerRadius="14" Padding="12">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock Text="可下载版本" FontWeight="SemiBold" Margin="2,0,0,9"/>
                                                    <ListBox Grid.Row="1" ItemsSource="{Binding TrainerReleases}" SelectedItem="{Binding SelectedTrainerRelease}" Background="Transparent" BorderThickness="0">
                                                        <ListBox.ItemTemplate><DataTemplate>
                                                            <Grid Margin="5,7" ToolTip="{Binding DisplayName}">
                                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding VersionDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                    <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,3,0,0">
                                                                        <Run Text="{Binding OptionCountDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PublishedDisplay, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate></ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <Button Grid.Row="2" Style="{StaticResource GscPrimaryButton}" Command="{Binding DownloadTrainerCommand}" Margin="0,10,0,0" HorizontalAlignment="Right">
                                                        <TextBlock><Run Text="下载并绑定到 "/><Run Text="{Binding SelectedGame.Name, Mode=OneWay, TargetNullValue=当前游戏}"/></TextBlock>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="MediaTab" Header="截图与录像">
                            <TabControl Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource GscTabItem}"/></TabControl.Resources>
                                <TabItem Header="待归类">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Background="{DynamicResource GscAccentTintBrush}" CornerRadius="12" Padding="14,11" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="待归类媒体" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="只保留无法唯一判断所属游戏的公共截图和录像，不会静默猜测。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource GscStatusPill}" VerticalAlignment="Center"><TextBlock Text="{Binding Snapshot.UnassignedMediaCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/></Border>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="1" Style="{StaticResource GscSurface}" CornerRadius="12" Padding="2" MinHeight="190">
                                            <Grid>
                                                <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding UnassignedMedia}" SelectedItem="{Binding SelectedInboxMedia}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="拍摄时间" Binding="{Binding CapturedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}" Width="110"/>
                                                        <DataGridTextColumn Header="类型" Binding="{Binding KindDisplay, Mode=OneWay}" Width="72"/>
                                                        <DataGridTextColumn Header="来源" Binding="{Binding SourceDisplay, Mode=OneWay}" Width="115"/>
                                                        <DataGridTextColumn Header="文件" Binding="{Binding FileName, Mode=OneWay}" Width="*">
                                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding OriginalPath}"/></Style></DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="原因" Binding="{Binding ClassificationReason, Mode=OneWay}" Width="1.1*">
                                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding ClassificationReason}"/></Style></DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Text="当前没有等待归类的媒体。" IsHitTestVisible="False">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UnassignedMedia.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                            <TextBlock Text="归类到：" VerticalAlignment="Center"/>
                                            <ComboBox Width="250" ItemsSource="{Binding Games}" SelectedItem="{Binding InboxTargetGame}" Margin="7,0,8,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                            <Button Style="{StaticResource GscPrimaryButton}" Command="{Binding AssignInboxMediaCommand}" Content="确认归类"/>
                                            <Button Style="{StaticResource GscButtonBase}" Command="{Binding IgnoreInboxMediaCommand}" Content="忽略并保留副本"/>
                                        </WrapPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="当前游戏媒体">
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="已确认归类到当前游戏的截图与录像" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="2,0,0,10"/>
                                        <Border Grid.Row="1" Style="{StaticResource GscSurface}" CornerRadius="12" Padding="2" MinHeight="190">
                                            <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedia}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="拍摄时间" Binding="{Binding CapturedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}" Width="110"/>
                                                    <DataGridTextColumn Header="类型" Binding="{Binding KindDisplay, Mode=OneWay}" Width="72"/>
                                                    <DataGridTextColumn Header="来源" Binding="{Binding SourceDisplay, Mode=OneWay}" Width="115"/>
                                                    <DataGridTextColumn Header="云端" Binding="{Binding CloudStateDisplay, Mode=OneWay}" Width="90"/>
                                                    <DataGridTextColumn Header="归档路径" Binding="{Binding ArchivePath, Mode=OneWay}" Width="*">
                                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding ArchivePath}"/></Style></DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                            <TextBlock Text="重新归类到：" VerticalAlignment="Center"/>
                                            <ComboBox Width="240" ItemsSource="{Binding Games}" SelectedItem="{Binding MediaTargetGame}" Margin="7,0,8,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                            <Button Style="{StaticResource GscButtonBase}" Command="{Binding ReassignMediaCommand}" Content="移动并重新归类"/>
                                        </WrapPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="来源与规则">
                                    <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="添加截图或录像来源" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="共享目录中无法唯一判断所属游戏的文件会进入待归类收件箱。" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                            <WrapPanel>
                                                <TextBox Style="{StaticResource GscTextBox}" MinWidth="330" Text="{Binding CustomMediaSourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Epic/Ubisoft/EA/GOG、MOD 或游戏自身截图目录" Margin="0,0,8,8"/>
                                                <TextBox Style="{StaticResource GscTextBox}" Width="100" Text="{Binding CustomMediaPattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 *.png" Margin="0,0,8,8"/>
                                                <CheckBox Content="共享目录" IsChecked="{Binding CustomMediaShared}" Margin="0,8,10,8"/>
                                                <Button Style="{StaticResource GscButtonBase}" Command="{Binding AddMediaSourceCommand}" Content="添加来源"/>
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding MediaSources}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,8,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding SourceKindDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding RootPath, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" MaxWidth="460" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath, Mode=OneWay}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </TabItem>

                        <TabItem x:Name="CandidateTab" Header="候选存档路径">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource GscSurface}" CornerRadius="12" Padding="2">
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding SaveCandidates}" SelectedItem="{Binding SelectedCandidate}" RowHeight="42">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="可信度" Binding="{Binding Score, Mode=OneWay, StringFormat=P0}" Width="78"/>
                                            <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="90"/>
                                            <DataGridTextColumn Header="路径" Binding="{Binding Path, Mode=OneWay}" Width="1.4*">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="依据" Binding="{Binding ReasonsDisplay, Mode=OneWay}" Width="1.2*">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding ReasonsDisplay}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource GscSurface}" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="选中候选的判断依据" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedCandidate.ReasonsDisplay, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding DetectPathsCommand}" Content="立即扫描"/>
                                    <Button Style="{StaticResource GscPrimaryButton}" Command="{Binding AcceptCandidateCommand}" Content="接受并生成规则草案"/>
                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding RejectCandidateCommand}" Content="忽略候选"/>
                                </WrapPanel>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="TaskTab" Header="任务">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,10">
                                    <ComboBox Width="150" ItemsSource="{Binding TaskStatusFilterOptions}" SelectedItem="{Binding TaskStatusFilter}" ToolTip="任务状态" Margin="0,0,8,0"/>
                                    <ComboBox Width="190" ItemsSource="{Binding TaskGameFilterOptions}" SelectedItem="{Binding TaskGameFilter}" ToolTip="游戏筛选" Margin="0,0,8,0"/>
                                    <ComboBox Width="160" ItemsSource="{Binding TaskTypeFilterOptions}" SelectedItem="{Binding TaskTypeFilter}" ToolTip="任务类型" Margin="0"/>
                                </WrapPanel>
                                <Border Grid.Row="1" Style="{StaticResource GscSurface}" CornerRadius="12" Padding="2">
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask}" RowHeight="46" ColumnHeaderHeight="40">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="本地时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="128"/>
                                            <DataGridTextColumn Header="任务" Binding="{Binding TaskTypeDisplay, Mode=OneWay}" Width="110"/>
                                            <DataGridTextColumn Header="游戏" Binding="{Binding GameName, Mode=OneWay}" Width="1.25*"/>
                                            <DataGridTemplateColumn Header="状态" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border x:Name="TaskDot" Width="7" Height="7" CornerRadius="4"
                                                                    Background="{StaticResource GscWarningBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StateDisplay, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Succeeded"><Setter TargetName="TaskDot" Property="Background" Value="{StaticResource GscSuccessBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Failed"><Setter TargetName="TaskDot" Property="Background" Value="{StaticResource GscErrorBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Running"><Setter TargetName="TaskDot" Property="Background" Value="{StaticResource GscInfoBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter TargetName="TaskDot" Property="Background" Value="#8E8E93"/></DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="进度" Width="132">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2,0">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                                            <ProgressBar Height="6" Width="76" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                         Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                                                       Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="详情" Binding="{Binding DetailMessage, Mode=OneWay}" Width="1.6*">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding DetailMessage}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border x:Name="TaskDetailCard" Grid.Row="2" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GscSurface}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding SelectedTask.GameName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedTask.TaskTypeDisplay, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding SelectedTask.DetailMessage}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,12,0"/>
                                            <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,0"><Run Text="耗时 "/><Run Text="{Binding SelectedTask.DurationDisplay, Mode=OneWay}"/><Run Text=" · 任务 ID "/><Run Text="{Binding SelectedTask.TaskId, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GscContextButton}" Command="{Binding CopyTaskErrorCommand}" Content="复制详情" Margin="8,0,0,0"/>
                                            <Button Style="{StaticResource GscContextButton}" Command="{Binding RetryTaskCommand}" Content="安全重试" Margin="8,0,0,0"/>
                                            <Button Style="{StaticResource GscContextButton}" Command="{Binding CancelTaskCommand}" Content="取消任务" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>



                        <TabItem x:Name="DiagnosticTab" Header="诊断">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel>
                                    <Button Style="{StaticResource GscPrimaryButton}" Command="{Binding RefreshDiagnosticsCommand}" Content="刷新诊断"/>
                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding CopyDiagnosticsCommand}" Content="复制诊断"/>
                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding OpenDataDirectoryCommand}" Content="打开数据目录"/>
                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding OpenBackupDirectoryCommand}" Content="打开存档目录"/>
                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding OpenMediaDirectoryCommand}" Content="打开媒体目录"/>
                                    <Button Style="{StaticResource GscButtonBase}" Command="{Binding OpenWorkerLogCommand}" Content="Worker 日志"/>
                                </WrapPanel>
                                <Grid Grid.Row="1" Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource GscSurface}" Padding="14" Margin="0,0,8,0">
                                        <StackPanel><TextBlock Text="Worker" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.WorkerVersion}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding EffectiveSettings.DataDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveSettings.DataDirectory}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource GscSurface}" Padding="14" Margin="0,0,8,0">
                                        <StackPanel><TextBlock Text="Ludusavi" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.LudusaviVersion}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding EffectiveSettings.LudusaviExecutable}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveSettings.LudusaviExecutable}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource GscSurface}" Padding="14">
                                        <StackPanel><TextBlock Text="版本策略" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"><Run Text="{Binding EffectiveSettings.BackupFormat, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding EffectiveSettings.Compression, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"><Run Text="完整 "/><Run Text="{Binding EffectiveSettings.FullBackupLimit, Mode=OneWay}"/><Run Text=" · 差异 "/><Run Text="{Binding EffectiveSettings.DifferentialBackupLimit, Mode=OneWay}"/></TextBlock></StackPanel>
                                    </Border>
                                </Grid>
                                <Expander Grid.Row="2" Header="查看完整诊断信息" Foreground="{DynamicResource GscPrimaryTextBrush}" IsExpanded="False">
                                    <Border Style="{StaticResource GscSurface}" CornerRadius="12" Padding="12" Margin="0,8,0,0">
                                        <TextBox Style="{StaticResource GscTextBox}" Text="{Binding DiagnosticSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                                    </Border>
                                </Expander>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="LogsTab" Header="异常与日志">
                            <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Border Style="{StaticResource GscSurface}" CornerRadius="12" Padding="2">
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding Findings}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="等级" Binding="{Binding Severity}" Width="70"/>
                                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="170"/>
                                            <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource GscSurface}" CornerRadius="12" Padding="2" Margin="0,8,0,0">
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding Audit}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="本地时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="128"/>
                                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100"/>
                                            <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="StatusPill" Background="{DynamicResource GscGlassFillBrush}" BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10,6" HorizontalAlignment="Left" MaxWidth="980">
                <DockPanel LastChildFill="True">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border"><Setter Property="Background" Value="{StaticResource GscErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="True"><Setter Property="Background" Value="{StaticResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage, Mode=OneWay}"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource GscAccentTintBrush}" BorderBrush="{StaticResource GscAccentTintStrongBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="12,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBackgroundRefreshing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="38" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="后台更新" Foreground="{StaticResource GscAccentBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
