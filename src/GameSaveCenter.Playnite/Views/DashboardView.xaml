<UserControl x:Class="GameSaveCenter.Playnite.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF"/>
        <Style x:Key="AppleButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="34"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GameSaveCenter" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="存档历史、媒体同步、MOD/外部启动识别与安全恢复" Opacity="0.62" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource AppleButton}" Command="{Binding RefreshCommand}" Content="刷新"/>
                <Button Style="{StaticResource AppleButton}" Command="{Binding BackupAllCommand}" Content="全部备份"/>
                <Button Style="{StaticResource AppleButton}" Command="{Binding SyncMediaCommand}" Content="同步媒体"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,6">
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="管理游戏" Opacity="0.62"/><TextBlock Text="{Binding Snapshot.ManagedGames}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="已匹配存档" Opacity="0.62"/><TextBlock Text="{Binding Snapshot.MatchedGames}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="正在运行" Opacity="0.62"/><TextBlock Text="{Binding Snapshot.RunningGames}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="需要关注" Opacity="0.62"/><TextBlock Text="{Binding Snapshot.WarningGames}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="云端任务" Opacity="0.62"/><TextBlock Text="{Binding Snapshot.PendingCloudTasks}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="待归类媒体" Opacity="0.62"/><TextBlock Text="{Binding Snapshot.UnassignedMediaCount}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="游戏与状态" FontSize="16" FontWeight="SemiBold" Margin="5,3,5,10"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="游戏" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="80"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding HealthState}" Width="86"/>
                            <DataGridTextColumn Header="版本" Binding="{Binding BackupVersionCount}" Width="52"/>
                            <DataGridTextColumn Header="媒体" Binding="{Binding MediaCount}" Width="52"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=选择一个游戏}" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedGame.LudusaviName, StringFormat=Ludusavi：{0}}" Opacity="0.62" Margin="0,3"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Style="{StaticResource AppleButton}" Command="{Binding BackupSelectedCommand}" Content="立即备份"/>
                            <Button Style="{StaticResource AppleButton}" Command="{Binding ValidateCommand}" Content="校验"/>
                            <Button Style="{StaticResource AppleButton}" Command="{Binding DetectPathsCommand}" Content="侦测路径"/>
                        </WrapPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#120A84FF" CornerRadius="12" Padding="10" Margin="0,10,0,10">
                        <TextBlock Text="自动恢复默认关闭。所有恢复都会先保存并锁定当前状态，再预览、恢复、校验；失败时尝试自动回滚。" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="2" Background="#0DFFFFFF" CornerRadius="12" Padding="10" Margin="0,0,0,10">
                        <WrapPanel>
                            <CheckBox Content="退出后备份" IsChecked="{Binding SelectedGame.Policy.BackupOnGameStop}" Margin="0,0,14,0"/>
                            <CheckBox Content="游玩中备份" IsChecked="{Binding SelectedGame.Policy.BackupDuringPlay}" Margin="0,0,14,0"/>
                            <TextBlock Text="间隔" VerticalAlignment="Center"/>
                            <TextBox Width="46" Text="{Binding SelectedGame.Policy.DuringPlayIntervalMinutes}" Margin="6,0,5,0"/>
                            <TextBlock Text="分钟" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox Content="上传云端" IsChecked="{Binding SelectedGame.Policy.UploadAfterBackup}" Margin="0,0,14,0"/>
                            <Button Style="{StaticResource AppleButton}" Command="{Binding SavePolicyCommand}" Content="保存策略"/>
                        </WrapPanel>
                    </Border>
                    <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0">
                        <TabItem Header="存档历史">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding CreatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145"/>
                                        <DataGridTextColumn Header="文件" Binding="{Binding FileCount}" Width="55"/>
                                        <DataGridTextColumn Header="大小" Binding="{Binding TotalBytes}" Width="90"/>
                                        <DataGridCheckBoxColumn Header="锁定" Binding="{Binding IsLocked}" Width="55"/>
                                        <DataGridTextColumn Header="备注" Binding="{Binding Comment}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <WrapPanel>
                                        <Button Style="{StaticResource AppleButton}" Command="{Binding RestoreCommand}" Content="安全恢复所选版本"/>
                                        <Button Style="{StaticResource AppleButton}" Command="{Binding UndoRestoreCommand}" Content="撤销最近恢复"/>
                                        <Button Style="{StaticResource AppleButton}" Command="{Binding CompareBackupCommand}" Content="与上一版本比较"/>
                                        <Button Style="{StaticResource AppleButton}" Command="{Binding PreviewRetentionCommand}" Content="保留策略预览"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <CheckBox Content="锁定版本" IsChecked="{Binding LockSelectedBackup}" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                        <TextBox Width="260" Text="{Binding BackupComment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" ToolTip="版本备注"/>
                                        <Button Style="{StaticResource AppleButton}" Command="{Binding UpdateBackupMetadataCommand}" Content="保存备注/锁定"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding DiffSummary}" TextWrapping="Wrap" Opacity="0.72"/>
                                    <TextBlock Text="{Binding RetentionSummary}" TextWrapping="Wrap" Opacity="0.72"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="截图与录像">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <WrapPanel>
                                    <TextBox Width="315" Text="{Binding CustomMediaSourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Epic/Ubisoft/EA/GOG、MOD 或游戏自身截图目录" Margin="0,0,8,8"/>
                                    <TextBox Width="90" Text="{Binding CustomMediaPattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="文件匹配，例如 *.png；默认 *" Margin="0,0,8,8"/>
                                    <CheckBox Content="共享目录" IsChecked="{Binding CustomMediaShared}" ToolTip="公共 Captures 目录：只有文件名匹配当前游戏时才归类" Margin="0,4,8,8"/>
                                    <Button Style="{StaticResource AppleButton}" Command="{Binding AddMediaSourceCommand}" Content="添加来源"/>
                                </WrapPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding MediaSources}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0DFFFFFF" CornerRadius="9" Padding="8,5" Margin="0,0,6,4">
                                                <TextBlock><Run Text="{Binding SourceKind}"/><Run Text=" · "/><Run Text="{Binding RootPath}"/></TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedia}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="拍摄时间" Binding="{Binding CapturedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145"/>
                                        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="75"/>
                                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="110"/>
                                        <DataGridTextColumn Header="云端" Binding="{Binding CloudState}" Width="80"/>
                                        <DataGridTextColumn Header="归档路径" Binding="{Binding ArchivePath}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                    <TextBlock Text="错误归类：" VerticalAlignment="Center"/>
                                    <ComboBox Width="240" ItemsSource="{Binding Games}" SelectedItem="{Binding MediaTargetGame}" DisplayMemberPath="Name" Margin="6,0,8,8"/>
                                    <Button Style="{StaticResource AppleButton}" Command="{Binding ReassignMediaCommand}" Content="重新归类所选媒体"/>
                                </WrapPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="候选存档路径">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding SaveCandidates}" SelectedItem="{Binding SelectedCandidate}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="可信度" Binding="{Binding Score, StringFormat=P0}" Width="70"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                                <Button Grid.Row="1" HorizontalAlignment="Left" Style="{StaticResource AppleButton}" Command="{Binding AcceptCandidateCommand}" Content="接受并生成规则草案" Margin="0,10,0,0"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="任务">
                            <DataGrid Margin="0,10,0,0" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding CreatedUtc, StringFormat={}{0:MM-dd HH:mm}}" Width="95"/>
                                    <DataGridTextColumn Header="任务" Binding="{Binding TaskType}" Width="90"/>
                                    <DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="85"/>
                                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="异常与日志">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <DataGrid ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="等级" Binding="{Binding Severity}" Width="65"/>
                                        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="150"/>
                                        <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Audit}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding CreatedUtc, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="115"/>
                                        <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="90"/>
                                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#10000000" CornerRadius="10" Padding="10" Margin="0,12,0,0">
            <DockPanel>
                <ProgressBar Width="120" Height="5" IsIndeterminate="{Binding IsBusy}" DockPanel.Dock="Right"/>
                <TextBlock Text="{Binding StatusMessage}" Opacity="0.72"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
