                                                               Margin="11,0,0,0"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"/>
                                                    <TextBlock Text="搜索 FLiNG 修改器…"
                                                               Foreground="{DynamicResource GscMutedTextBrush}"
                                                               Margin="32,0,38,0"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                                <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
