                                                            <TextBox.Text><Binding Path="SelectedGameTool.LaunchDelaySeconds" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" NotifyOnValidationError="True"><Binding.ValidationRules><infra:IntegerRangeValidationRule Minimum="0" Maximum="300"/></Binding.ValidationRules></Binding></TextBox.Text>
                                                        </TextBox>
                                                    </DockPanel>
                                                </StackPanel>
                                                <WrapPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,18,0,0">
                                                    <ui:Button Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding LaunchGameToolCommand}" Content="启动"/>
