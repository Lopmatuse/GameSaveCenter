                                                    <TextBlock Text="{Binding SelectedGameToolVersion.EntryPath, Mode=OneWay}"
                                                               Foreground="{DynamicResource GscMutedTextBrush}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding SelectedGameToolVersion.EntryPath}"
                                                               Margin="1,0,0,12"/>
