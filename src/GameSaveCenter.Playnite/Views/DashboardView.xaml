                                                <Border Style="{StaticResource GscSurface}" CornerRadius="11" Padding="11,7" Margin="0,0,8,8"><TextBlock><Run Text="媒体 "/><Run Text="{Binding MediaSummary.TotalCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                                                <Border Style="{StaticResource GscSurface}" CornerRadius="11" Padding="11,7" Margin="0,0,8,8"><TextBlock><Run Text="截图 "/><Run Text="{Binding MediaSummary.ScreenshotCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                                                <Border Style="{StaticResource GscSurface}" CornerRadius="11" Padding="11,7" Margin="0,0,8,8"><TextBlock><Run Text="录像 "/><Run Text="{Binding MediaSummary.VideoCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                                                <Border Style="{StaticResource GscSurface}" CornerRadius="11" Padding="11,7" Margin="0,0,8,8"><TextBlock><Run Text="收藏 "/><Run Text="{Binding MediaSummary.FavoriteCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                                                <Border Style="{StaticResource GscSurface}" CornerRadius="11" Padding="11,7" Margin="0,0,0,8"><TextBlock><Run Text="占用 "/><Run Text="{Binding MediaSummary.TotalSizeDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                                            </WrapPanel>
                                            <WrapPanel>
                                                <TextBox Style="{StaticResource GscWpfUiTextBox}" MinWidth="260" Text="{Binding MediaSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按文件名、备注或来源搜索" Margin="0,0,8,0"/>
                                                <ComboBox Style="{StaticResource GscWpfUiComboBox}" Width="130" ItemsSource="{Binding MediaFilterOptions}" SelectedItem="{Binding MediaFilter}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <Border Grid.Row="1" Style="{StaticResource GscTableFrame}" MinHeight="190">
                                            <DataGrid x:Name="MediaGrid" Style="{StaticResource GscDataGrid}" ItemsSource="{Binding MediaView}" SelectedItem="{Binding SelectedMedia}"
                                                      SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn HeaderStyle="{StaticResource GscFirstColumnHeader}" Header="预览" Width="82">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid Width="64" Height="38" Margin="2" ToolTip="{Binding FileName}">
                                                                    <Border CornerRadius="6" Background="{DynamicResource GscControlFillBrush}" ClipToBounds="True">
                                                                        <Image Source="{Binding ArchivePath, Converter={StaticResource MediaThumbnailConverter}, ConverterParameter=96}" Stretch="UniformToFill"/>
                                                                    </Border>
                                                                    <TextBlock Text="视频" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource GscSecondaryTextBrush}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static contracts:MediaKind.VideoClip}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="拍摄时间" Binding="{Binding CapturedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}" Width="110"/>
                                                    <DataGridTextColumn Header="类型" Binding="{Binding KindDisplay, Mode=OneWay}" Width="72"/>
                                                    <DataGridTextColumn Header="来源" Binding="{Binding SourceDisplay, Mode=OneWay}" Width="115"/>
                                                    <DataGridCheckBoxColumn Header="收藏" Binding="{Binding IsFavorite, Mode=OneWay}" Width="68"/>
                                                    <DataGridTextColumn Header="云端" Binding="{Binding CloudStateDisplay, Mode=OneWay}" Width="90"/>
                                                    <DataGridTextColumn Header="备注" Binding="{Binding Comment, Mode=OneWay}" Width="150" CellStyle="{StaticResource GscLeftDataGridCell}">
                                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Comment}"/></Style></DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn HeaderStyle="{StaticResource GscLastColumnHeader}" Header="归档路径" Binding="{Binding ArchivePath, Mode=OneWay}" Width="*" MinWidth="360" CellStyle="{StaticResource GscLeftDataGridCell}">
                                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding ArchivePath}"/></Style></DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                        <Border Grid.Row="2" Style="{StaticResource GscSurface}" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                            <Grid x:Name="MediaInspectorPanel">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="MediaInspectorCompactRow" Height="0"/></Grid.RowDefinitions>
                                                <Border x:Name="MediaPreviewPanel" Grid.Row="0" Grid.Column="0" Height="104" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource GscControlFillBrush}" Margin="0,0,12,0">
                                                    <Grid>
                                                        <TextBlock Text="选择截图或录像可在此预览" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="14" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                                        <Image Source="{Binding SelectedMedia.ArchivePath, Converter={StaticResource MediaThumbnailConverter}}" Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedMedia.Kind}" Value="{x:Static contracts:MediaKind.Screenshot}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <MediaElement Source="{Binding SelectedMedia.ArchivePath, Converter={StaticResource MediaVideoSourceConverter}}"
                                                                      LoadedBehavior="Play" UnloadedBehavior="Stop" IsMuted="True" Stretch="UniformToFill" ScrubbingEnabled="True">
                                                            <MediaElement.Style>
                                                                <Style TargetType="MediaElement">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedMedia.Kind}" Value="{x:Static contracts:MediaKind.VideoClip}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MediaElement.Style>
                                                        </MediaElement>
                                                    </Grid>
                                                </Border>
                                                <StackPanel x:Name="MediaMetadataPanel" Grid.Row="0" Grid.Column="1">
                                                    <WrapPanel>
                                                        <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="收藏" OnContent="开" OffContent="关" IsChecked="{Binding MediaFavorite}" Margin="0,8,12,8"/>
                                                        <TextBox Style="{StaticResource GscWpfUiTextBox}" MinWidth="280" MaxWidth="520" Text="{Binding MediaComment, UpdateSourceTrigger=PropertyChanged}" ToolTip="为选中媒体添加备注" Margin="0,0,8,8"/>
                                                        <ui:Button Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding UpdateMediaMetadataCommand}" Content="保存元数据"/>
                                                        <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding OpenSelectedMediaCommand}" Content="打开媒体"/>
                                                        <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding RevealSelectedMediaCommand}" Content="在目录中显示"/>
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,2,0,0">
                                                        <TextBlock Text="重新归类到：" VerticalAlignment="Center"/>
                                                        <ComboBox Style="{StaticResource GscWpfUiComboBox}" Width="240" ItemsSource="{Binding Games}" SelectedItem="{Binding MediaTargetGame}" Margin="7,0,8,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource GscComboBoxLongText}" Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                                        <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding ReassignMediaCommand}" Content="移动并重新归类"/>
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,2,0,0">
                                                        <TextBlock Text="批量操作：" VerticalAlignment="Center"/>
                                                        <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding FavoriteSelectedMediaCommand}" CommandParameter="{Binding SelectedItems, ElementName=MediaGrid}" Content="收藏所选"/>
                                                        <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding UnfavoriteSelectedMediaCommand}" CommandParameter="{Binding SelectedItems, ElementName=MediaGrid}" Content="取消收藏"/>
                                                        <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding CommentSelectedMediaCommand}" CommandParameter="{Binding SelectedItems, ElementName=MediaGrid}" Content="将当前备注应用到所选"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="来源与规则">
                                    <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="添加截图或录像来源" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="共享目录中无法唯一判断所属游戏的文件会进入待归类收件箱。" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                            <UniformGrid x:Name="MediaSourceFields" Columns="2">
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="截图或录像目录" Margin="0,0,0,4"/>
                                                    <TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding CustomMediaSourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Epic/Ubisoft/EA/GOG、MOD 或游戏自身截图目录"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="文件模式" Margin="0,0,0,4"/>
                                                    <TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding CustomMediaPattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 *.png"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="目录类型" Margin="0,0,0,4"/>
                                                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="共享目录" OnContent="开" OffContent="关" IsChecked="{Binding CustomMediaShared}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,10">
                                                    <TextBlock Text="操作" Margin="0,0,0,4"/>
                                                    <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding AddMediaSourceCommand}" Content="添加来源" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </UniformGrid>
                                            <ItemsControl ItemsSource="{Binding MediaSources}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                                <WrapPanel>
                                                                    <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="启用" IsChecked="{Binding Enabled, Mode=TwoWay}" Command="{Binding DataContext.UpdateMediaSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="{Binding SourceKindDisplay, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="共享" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SharedDirectory}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                    </TextBlock>
                                                                    <ui:Button Style="{StaticResource GscWpfUiContextButton}" Command="{Binding DataContext.DeleteMediaSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="移除" Margin="10,0,0,0"/>
                                                                </WrapPanel>
                                                                <TextBlock Grid.Row="1" Text="{Binding RootPath, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath, Mode=OneWay}" Margin="0,5,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="CandidateTab" Header="候选存档路径">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource GscTableFrame}">
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding SaveCandidates}" SelectedItem="{Binding SelectedCandidate}" RowHeight="42">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscFirstColumnHeader}" Header="可信度" Binding="{Binding Score, Mode=OneWay, StringFormat=P0}" Width="78"/>
                                            <DataGridTextColumn Header="状态" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="90"/>
                                            <DataGridTextColumn Header="路径" Binding="{Binding Path, Mode=OneWay}" Width="1.4*" MinWidth="360" CellStyle="{StaticResource GscLeftDataGridCell}">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscLastColumnHeader}" Header="依据" Binding="{Binding ReasonsDisplay, Mode=OneWay}" Width="1.2*" MinWidth="260" CellStyle="{StaticResource GscLeftDataGridCell}">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding ReasonsDisplay}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource GscSurface}" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="选中候选的判断依据" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedCandidate.ReasonsDisplay, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                    <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding DetectPathsCommand}" Content="立即扫描"/>
                                    <ui:Button Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding AcceptCandidateCommand}" Content="接受并生成规则草案"/>
                                    <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding RejectCandidateCommand}" Content="忽略候选"/>
                                </WrapPanel>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="TaskWorkspaceTab" Header="任务工作台">
                            <views:TaskCenterView x:Name="TaskWorkspaceView"/>
                        </TabItem>
                        <TabItem x:Name="TaskTab" Header="任务工作台">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <UniformGrid x:Name="TaskSummaryPanel" Grid.Row="0" Columns="3" Margin="0,0,0,12">
                                    <Border Style="{StaticResource GscRedesignMetricBorder}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource GscInfoIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" Foreground="{DynamicResource GscInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="任务总数" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Tasks.Count, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource GscRedesignMetricBorder}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource GscAccentIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="云端待处理" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.PendingCloudTasks, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource GscRedesignMetricBorder}" Margin="0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource GscSuccessIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Foreground="{DynamicResource GscSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="当前选中" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding SelectedTask.StateDisplay, Mode=OneWay, TargetNullValue=未选择}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.StateDisplay, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                                <Border Grid.Row="1" Style="{StaticResource GscRedesignSectionCard}" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="任务队列" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="筛选不会取消、重排或重新执行后台任务；选择一项可查看真实错误与可恢复操作。"
                                                       Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <WrapPanel x:Name="TaskFiltersPanel" Grid.Row="1" Margin="0,12,0,0">
                                            <ComboBox Style="{StaticResource GscWpfUiComboBox}" Width="150" ItemsSource="{Binding TaskStatusFilterOptions}" SelectedItem="{Binding TaskStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="任务状态" Margin="0,0,8,8"/>
                                            <ComboBox Style="{StaticResource GscWpfUiComboBox}" Width="190" ItemsSource="{Binding TaskGameFilterOptions}" SelectedItem="{Binding TaskGameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="游戏筛选" Margin="0,0,8,8"/>
                                            <ComboBox Style="{StaticResource GscWpfUiComboBox}" Width="160" ItemsSource="{Binding TaskTypeFilterOptions}" SelectedItem="{Binding TaskTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="任务类型" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource GscTableFrame}">
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask}" RowHeight="46" ColumnHeaderHeight="40">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscFirstColumnHeader}" Header="本地时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="128"/>
                                            <DataGridTextColumn Header="任务" Binding="{Binding TaskTypeDisplay, Mode=OneWay}" Width="110"/>
                                            <DataGridTextColumn Header="游戏" Binding="{Binding GameName, Mode=OneWay}" Width="1.25*" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLongTextCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                            <DataGridTemplateColumn Header="状态" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border x:Name="TaskDot" Width="7" Height="7" CornerRadius="4"
                                                                    Background="{DynamicResource GscWarningBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StateDisplay, Mode=OneWay}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Succeeded"><Setter TargetName="TaskDot" Property="Background" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Failed"><Setter TargetName="TaskDot" Property="Background" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Running"><Setter TargetName="TaskDot" Property="Background" Value="{DynamicResource GscInfoBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter TargetName="TaskDot" Property="Background" Value="{StaticResource GscMutedStatusBrush}"/></DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="进度" Width="170" MinWidth="150" CellStyle="{StaticResource GscStretchDataGridCell}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="68"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                            <ProgressBar Height="8" MinWidth="68" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                                         Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11"
                                                                       Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscLastColumnHeader}" Header="详情" Binding="{Binding DetailMessage, Mode=OneWay}" Width="1.6*" MinWidth="320" CellStyle="{StaticResource GscLeftDataGridCell}">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding DetailMessage}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border x:Name="TaskDetailCard" Grid.Row="3" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GscSurface}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding SelectedTask.GameName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedTask.TaskTypeDisplay, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding SelectedTask.DetailMessage}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,12,0"/>
                                            <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,0"><Run Text="耗时 "/><Run Text="{Binding SelectedTask.DurationDisplay, Mode=OneWay}"/><Run Text=" · 任务 ID "/><Run Text="{Binding SelectedTask.TaskId, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                        <!-- A wrapping action band keeps recovery actions keyboard reachable
                                             when long technical details or high DPI consume horizontal space. -->
                                        <WrapPanel x:Name="TaskDetailActions" Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
                                            <ui:Button Style="{StaticResource GscWpfUiContextButton}" Command="{Binding CopyTaskErrorCommand}" Content="复制详情" Margin="0,0,8,0"/>
                                            <ui:Button Style="{StaticResource GscWpfUiContextButton}" Command="{Binding RetryTaskCommand}" Content="安全重试" Margin="0,0,8,0"/>
                                            <ui:Button Style="{StaticResource GscWpfUiContextButton}" Command="{Binding CancelTaskCommand}" Content="取消任务" Margin="0"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>



                        <TabItem x:Name="DiagnosticTab" Header="健康诊断">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel>
                                    <ui:Button Style="{StaticResource GscWpfUiToolbarPrimaryButton}" Command="{Binding RefreshDiagnosticsCommand}" Content="刷新诊断" Margin="0,0,8,8"/>
                                    <ui:Button Style="{StaticResource GscWpfUiToolbarButton}" Command="{Binding CopyDiagnosticsCommand}" Content="复制诊断" Margin="0,0,8,8"/>
                                    <ui:Button Style="{StaticResource GscWpfUiToolbarButton}" Command="{Binding OpenDataDirectoryCommand}" Content="打开数据目录" Margin="0,0,8,8"/>
                                    <ui:Button Style="{StaticResource GscWpfUiToolbarButton}" Command="{Binding OpenBackupDirectoryCommand}" Content="打开存档目录" Margin="0,0,8,8"/>
                                    <ui:Button Style="{StaticResource GscWpfUiToolbarButton}" Command="{Binding OpenMediaDirectoryCommand}" Content="打开媒体目录" Margin="0,0,8,8"/>
                                    <ui:Button Style="{StaticResource GscWpfUiToolbarButton}" Command="{Binding OpenWorkerLogCommand}" Content="Worker 日志" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <UniformGrid x:Name="DiagnosticHealthPanel" Grid.Row="1" Columns="4" Margin="0,4,0,10">
                                    <Border Style="{StaticResource GscRedesignMetricBorder}" Padding="14" Margin="0,0,8,8">
                                        <StackPanel><TextBlock Text="Worker" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.WorkerVersion}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding EffectiveSettings.DataDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveSettings.DataDirectory}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GscRedesignMetricBorder}" Padding="14" Margin="0,0,8,8">
                                        <StackPanel><TextBlock Text="Ludusavi" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.LudusaviVersion}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding EffectiveSettings.LudusaviExecutable}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveSettings.LudusaviExecutable}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GscRedesignMetricBorder}" Padding="14" Margin="0,0,8,8">
                                        <StackPanel><TextBlock Text="版本策略" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"><Run Text="{Binding EffectiveSettings.BackupFormat, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding EffectiveSettings.Compression, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"><Run Text="完整 "/><Run Text="{Binding EffectiveSettings.FullBackupLimit, Mode=OneWay}"/><Run Text=" · 差异 "/><Run Text="{Binding EffectiveSettings.DifferentialBackupLimit, Mode=OneWay}"/></TextBlock></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource GscRedesignMetricBorder}" Padding="14" Margin="0,0,0,8">
                                        <StackPanel><TextBlock Text="需要关注" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.WarningGames, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="路径、工具或校验建议" TextTrimming="CharacterEllipsis" ToolTip="路径、工具或校验建议" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Border Grid.Row="2" Style="{StaticResource GscRedesignSectionCard}" Padding="14" Margin="0,0,0,8">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/></Grid.RowDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="学习未知进程 / MOD 启动器"/>
                                        <WrapPanel x:Name="ProcessMappingEditor" Grid.Row="1" Margin="0,8,0,8">
                                            <TextBox Style="{StaticResource GscWpfUiTextBox}" MinWidth="220" MaxWidth="360" Text="{Binding ProcessMappingExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入 EXE 文件名，例如 skse64.exe；不要填写完整路径" Margin="0,0,8,8"/>
                                            <ComboBox Style="{StaticResource GscWpfUiComboBox}" MinWidth="220" MaxWidth="360" ItemsSource="{Binding Games}" SelectedItem="{Binding ProcessMappingTargetGame}" Margin="0,0,8,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource GscComboBoxLongText}" Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                            <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding SaveProcessMappingCommand}" Content="绑定" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                        <DataGrid Grid.Row="2" Style="{StaticResource GscDataGrid}" ItemsSource="{Binding ProcessMappings}" SelectedItem="{Binding SelectedProcessMapping}">
                                            <DataGrid.Columns><DataGridTextColumn HeaderStyle="{StaticResource GscFirstColumnHeader}" Header="EXE" Binding="{Binding ExecutableName}" Width="180" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLongTextCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="目标游戏" Binding="{Binding GameName}" Width="*" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLongTextCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTemplateColumn HeaderStyle="{StaticResource GscLastColumnHeader}" Header="操作" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Button Style="{StaticResource GscWpfUiContextButton}" Command="{Binding DataContext.DeleteProcessMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="删除"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                                <Expander Grid.Row="3" Header="查看完整诊断信息" Foreground="{DynamicResource GscPrimaryTextBrush}" IsExpanded="False">
                                    <Border Style="{StaticResource GscSurface}" CornerRadius="12" Padding="12" Margin="0,8,0,0">
                                        <TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding DiagnosticSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                                    </Border>
                                </Expander>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="DeviceStatusTab" Header="设备状态">
                            <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <WrapPanel>
                                    <ui:Button Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding SyncDeviceStatesCommand}" Content="刷新设备状态"/>
                                </WrapPanel>
                                <Border Grid.Row="1" Style="{StaticResource GscSurface}" Padding="12" Margin="0,8,0,8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="只读多设备摘要"/>
                                        <TextBlock Text="{Binding DeviceStateMessage}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource GscTableFrame}">
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding DeviceComparisons}" SelectedItem="{Binding SelectedDeviceComparison}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscFirstColumnHeader}" Header="状态" Binding="{Binding StateDisplay}" Width="150"/>
                                            <DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="*" MinWidth="180" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLongTextCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                            <DataGridTextColumn Header="其他设备" Binding="{Binding RemoteDevice}" Width="130" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLongTextCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                            <DataGridTextColumn Header="原因" Binding="{Binding ReasonDisplay}" Width="240" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLongTextCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                            <DataGridTextColumn Header="人工决策" Binding="{Binding DecisionDisplay}" Width="130" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLongTextCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscLastColumnHeader}" Header="建议" Binding="{Binding SuggestedBackupId}" Width="180">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding SuggestedBackupId}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="3" Style="{StaticResource GscSurface}" Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="记录人工决策" FontWeight="SemiBold"/>
                                        <TextBlock Text="只保存判断依据，不会执行远端操作或删除远端内容。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                        <UniformGrid x:Name="DeviceDecisionFields" Columns="3">
                                            <StackPanel Margin="0,0,12,10"><TextBlock Text="决策" Margin="0,0,0,4"/><ComboBox Style="{StaticResource GscWpfUiComboBox}" ItemsSource="{Binding DeviceDecisionOptions}" SelectedItem="{Binding DeviceDecision}"/></StackPanel>
                                            <StackPanel Margin="0,0,12,10"><TextBlock Text="判断依据" Margin="0,0,0,4"/><TextBox Style="{StaticResource GscWpfUiTextBox}" Text="{Binding DeviceDecisionComment, UpdateSourceTrigger=PropertyChanged}" ToolTip="仅记录判断依据，不会执行远端操作"/></StackPanel>
                                            <StackPanel Margin="0,0,12,10"><TextBlock Text="操作" Margin="0,0,0,4"/><ui:Button Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding SaveDeviceDecisionCommand}" Content="保存人工决策" HorizontalAlignment="Left"/></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="4" Style="{StaticResource GscSurface}" Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="受保护的远端恢复"/>
                                        <TextBlock Text="{Binding StagedRemoteBackupStatus}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,10"/>
                                        <WrapPanel>
                                            <ui:Button Style="{StaticResource GscWpfUiContextButton}" Command="{Binding StageRemoteBackupCommand}" Content="1. 下载并校验"/>
                                            <ui:Button Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding RestoreStagedRemoteBackupCommand}" Content="2. 创建快照并恢复"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="LogsTab" Header="异常与日志">
                            <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Border Style="{StaticResource GscTableFrame}">
                                    <DataGrid x:Name="FindingsGrid" Style="{StaticResource GscDataGrid}" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscFirstColumnHeader}" Header="等级" Binding="{Binding Severity}" Width="70"/>
                                            <DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="150">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding GameName}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="170" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLongTextCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                            <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" MinWidth="320" CellStyle="{StaticResource GscLeftDataGridCell}">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscLastColumnHeader}" Header="建议处理" Binding="{Binding SuggestedAction}" Width="1.1*" MinWidth="240" CellStyle="{StaticResource GscLeftDataGridCell}">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding SuggestedAction}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource GscTableFrame}" Margin="0,8,0,0">
                                    <DataGrid Style="{StaticResource GscDataGrid}" ItemsSource="{Binding Audit}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscFirstColumnHeader}" Header="本地时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="128"/>
                                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100"/>
                                            <DataGridTextColumn HeaderStyle="{StaticResource GscLastColumnHeader}" Header="消息" Binding="{Binding Message}" Width="*" MinWidth="360" CellStyle="{StaticResource GscLeftDataGridCell}">
                                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="UiFrameworkProbeTab" Header="界面探针">
                            <Grid Margin="0,12,0,0">
                                <ContentControl x:Name="UiFrameworkProbeHost" Visibility="Collapsed"/>
                                <Border x:Name="UiFrameworkProbeRecoveryPanel" Style="{StaticResource GscSurface}">
                                    <StackPanel MaxWidth="760">
                                        <TextBlock Text="界面兼容性探针" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource GscSecondaryTextBrush}"
                                                   Text="此可选诊断页仅在你主动加载时才解析 WPF-UI 资源；不会执行备份、恢复、云端或媒体操作。加载失败不会影响维护中心，可查看错误后重试或切换到其他诊断页。"/>
                                        <ui:Button x:Name="LoadUiFrameworkProbeButton" Margin="0,14,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource GscWpfUiActionButton}" Content="加载界面探针"
                                                Click="OnLoadUiFrameworkProbeClick"/>
                                        <Border x:Name="UiFrameworkProbeLoadFailurePanel" Margin="0,12,0,0" Padding="12"
                                                Background="{DynamicResource GscErrorTintBrush}" CornerRadius="10" Visibility="Collapsed">
                                            <TextBlock x:Name="UiFrameworkProbeLoadFailureText" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource GscPrimaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="StatusPill" Background="{DynamicResource GscGlassFillBrush}" BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10,6" HorizontalAlignment="Left" MaxWidth="980">
                <DockPanel LastChildFill="True">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource GscErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="True"><Setter Property="Background" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger></Style.Triggers></Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage, Mode=OneWay}"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource GscAccentTintBrush}" BorderBrush="{DynamicResource GscAccentTintStrongBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="12,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBackgroundRefreshing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="38" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="后台更新" Foreground="{DynamicResource GscAccentBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
            </Grid>
        </Grid>

        <!-- Snackbar is safe as a page-local floating surface. ContentDialogHost is deliberately
             excluded: WPF-UI permits only one host per Playnite Window. -->
        <ui:SnackbarPresenter x:Name="SnackbarHost" Panel.ZIndex="88"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,22"/>

        <!-- Confirmation feedback stays inside the Playnite content host and never steals focus with a new Window. -->
        <StackPanel x:Name="ToastHost"
                    Panel.ZIndex="90"
                    Width="360"
                    MaxWidth="360"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,78,22,0"/>

        <Grid x:Name="DialogOverlay"
              Panel.ZIndex="100"
              Visibility="Collapsed"
              Background="{DynamicResource GscOverlayBrush}">
            <Border x:Name="DialogCard"
                    Width="480"
                    MaxWidth="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GscGlassStrongBrush}"
                    BorderBrush="{DynamicResource GscGlassStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="22"
                    Opacity="0"
                    Effect="{DynamicResource GscDialogEffect}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DialogTitleText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DialogMessageText" Margin="0,10,0,0" Foreground="{DynamicResource GscSecondaryTextBrush}"
                                   TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource GscDividerBrush}" Margin="0,18,0,16"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancelButton" Style="{StaticResource GscButtonBase}" Click="OnDialogCancelClick" Content="取消"/>
                        <Button x:Name="DialogConfirmButton" Style="{StaticResource GscPrimaryButton}" Click="OnDialogConfirmClick" Content="确认" Margin="0,0,0,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
