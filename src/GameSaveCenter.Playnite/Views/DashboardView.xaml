                                                <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,0,8"><StackPanel><TextBlock Text="已匹配存档" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.MatchedGames, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                                <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,8,0"><StackPanel><TextBlock Text="云端队列" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.PendingCloudTasks, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                                <Border Style="{StaticResource GscRedesignContextPill}"><StackPanel><TextBlock Text="待归类媒体" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.UnassignedMediaCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Style="{StaticResource GscRedesignSectionCard}" Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource GscRedesignSectionTitle}" Text="风险与提醒"/>
                                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                <Border Background="{DynamicResource GscSafetyFillBrush}" BorderBrush="{DynamicResource GscSafetyStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,10">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="{DynamicResource GscWarningBrush}" FontSize="17"/><StackPanel Grid.Column="1"><TextBlock Text="安全恢复提示" FontWeight="SemiBold"/><TextBlock Text="恢复始终需要人工确认，并会先创建当前快照。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid>
                                                </Border>
                                                <Border Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,0,0,10">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" Foreground="{DynamicResource GscWarningBrush}" FontSize="17"/><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold"><Run Text="{Binding Snapshot.WarningGames, Mode=OneWay}"/><Run Text=" 个游戏需要关注"/></TextBlock><TextBlock Text="以下是当前缓存中的具体原因：" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/><ItemsControl ItemsSource="{Binding AttentionFindings}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><ui:Button Style="{StaticResource GscWpfUiCompactButton}" Command="{Binding DataContext.OpenAttentionFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="0" Margin="0,2,0,0" AutomationProperties.Name="查看关注原因"><TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"><Run Text="• "/><Run Text="{Binding GameName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="："/><Run Text="{Binding Title, Mode=OneWay}"/></TextBlock></ui:Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="点击“打开维护中心”查看完整详情与建议处理方式。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid>
                                                </Border>
                                                <Border Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="13">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" Foreground="{DynamicResource GscInfoBrush}" FontSize="17"/><StackPanel Grid.Column="1"><TextBlock Text="云端失败不会撤销本地备份" FontWeight="SemiBold"/><TextBlock Text="本地副本始终为主副本，失败任务可在任务中心诊断和重试。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid>
                                                </Border>
                                            </StackPanel>
                                            <ui:Button Grid.Row="2" Style="{StaticResource GscWpfUiPrimaryButton}" Command="{Binding OpenAttentionCenterCommand}" Content="打开维护中心" HorizontalAlignment="Stretch" Margin="0,14,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="SaveHistoryTab" Header="版本时间线">
                            <Grid x:Name="SaveHistoryLayoutGrid" Margin="0,12,0,0" MinHeight="0">
