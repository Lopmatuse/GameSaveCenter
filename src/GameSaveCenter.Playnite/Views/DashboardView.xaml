                                        <Border x:Name="TrainerToolsInspectorPanel" Grid.Row="2" Grid.Column="2" Background="{DynamicResource GscGlassStrongBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,12,0,0">
                                            <Grid>
