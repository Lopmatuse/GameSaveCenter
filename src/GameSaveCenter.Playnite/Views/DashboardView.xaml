                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=TrainerSearchTextBox}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                    <ui:Button Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding SearchTrainerCatalogCommand}" Content="搜索" Margin="0,0,8,0"/>
                                                    <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding SyncTrainerCatalogCommand}" Content="刷新目录" Margin="0"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
