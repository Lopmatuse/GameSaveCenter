                                                                    <Run Text="FLiNG · "/><Run Text="{Binding GameVersion, Mode=OneWay, TargetNullValue=版本未标注}"/><Run Text=" · "/><Run Text="{Binding OptionCount, Mode=OneWay}"/><Run Text=" 项功能"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate></ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <ui:Button Grid.Row="2" Style="{StaticResource GscWpfUiActionButton}" Command="{Binding LoadTrainerReleasesCommand}" Content="重新读取可下载版本" Margin="0,10,0,0"/>
                                                </Grid>
                                            </Border>
