                                                    <ui:Button Grid.Row="2" Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding DownloadTrainerCommand}" Margin="0,10,0,0" HorizontalAlignment="Right">
                                                        <TextBlock><Run Text="下载并绑定到 "/><Run Text="{Binding SelectedGame.Name, Mode=OneWay, TargetNullValue=当前游戏}"/></TextBlock>
                                                    </ui:Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                            </Grid>
                        </TabItem>

