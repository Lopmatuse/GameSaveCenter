                                                        <DataGridTextColumn Header="来源设备" Binding="{Binding SourceDevice, Mode=OneWay}" Width="120" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLongTextCell}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                                        <DataGridCheckBoxColumn Header="锁定" Binding="{Binding IsLocked, Mode=OneWay}" Width="60" ElementStyle="{StaticResource GscDataGridCheckBox}" EditingElementStyle="{StaticResource GscDataGridCheckBox}"/>
                                                        <DataGridTextColumn HeaderStyle="{StaticResource GscLastColumnHeader}" Header="备注" Binding="{Binding Comment, Mode=OneWay}" Width="*" MinWidth="170" CellStyle="{StaticResource GscLeftDataGridCell}"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource GscLeftCellText}"><Setter Property="ToolTip" Value="{Binding Comment, Mode=OneWay}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Text="尚无历史版本&#x0a;完成一次有效备份后会显示在这里。" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyText}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding Backups.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="2" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="当前格式："/><Run Text="{Binding Snapshot.BackupFormat, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" · 本地历史由 Ludusavi 提供"/>
                                            </TextBlock>
                                            <ui:Button Grid.Column="1" Style="{StaticResource GscWpfUiCompactButton}" Command="{Binding PreviewRetentionCommand}" Content="保留策略预览"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="SaveHistoryInspectorPanel" Grid.Row="0" Grid.Column="2" Style="{StaticResource GscRedesignSectionCard}" MinWidth="0">
                                    <Grid MinHeight="0">
