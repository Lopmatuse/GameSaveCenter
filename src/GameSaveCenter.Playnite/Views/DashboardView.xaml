                                                        <Border Background="{DynamicResource GscSafetyFillBrush}" BorderBrush="{DynamicResource GscSafetyStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="13">
                                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="{DynamicResource GscInfoBrush}" FontSize="17"/><StackPanel Grid.Column="1"><TextBlock Text="安全恢复" FontWeight="SemiBold"/><TextBlock Text="恢复前会创建并锁定当前快照，恢复后校验；失败时尝试回滚。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid>
                                                        </Border>
                                                        <WrapPanel Margin="0,14,0,0">
                                                            <ui:Button Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding RestoreCommand}" Content="安全恢复所选版本"/>
                                                            <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding UndoRestoreCommand}" Content="撤销最近恢复"/>
                                                            <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding CompareBackupCommand}" Content="与上一版本比较" Margin="0"/>
                                                        </WrapPanel>
                                                        <Border Background="{DynamicResource GscSafetyFillBrush}" BorderBrush="{DynamicResource GscSafetyStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,14,0,0">
