                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="TrainerCatalogCompactRow" Height="0"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="TrainerCatalogResultsColumn"/><ColumnDefinition x:Name="TrainerCatalogGutterColumn" Width="14"/><ColumnDefinition x:Name="TrainerCatalogReleasesColumn"/></Grid.ColumnDefinitions>
                                            <Border x:Name="TrainerCatalogResultsPanel" Style="{StaticResource GscSurface}" CornerRadius="14" Padding="12">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock Text="搜索结果" FontWeight="SemiBold" Margin="2,0,0,9"/>
