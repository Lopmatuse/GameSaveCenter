<UserControl x:Class="GameSaveCenter.Playnite.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:GameSaveCenter.Contracts;assembly=GameSaveCenter.Contracts"
             xmlns:converters="clr-namespace:GameSaveCenter.Playnite.Converters"
             xmlns:infra="clr-namespace:GameSaveCenter.Playnite.Infrastructure"
             xmlns:views="clr-namespace:GameSaveCenter.Playnite.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource GscPrimaryTextBrush}" TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}" Background="Transparent"
             TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled"
             ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="18000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <converters:MediaThumbnailConverter x:Key="MediaThumbnailConverter"/>
        <converters:MediaVideoSourceConverter x:Key="MediaVideoSourceConverter"/>

        <!-- A compact vector mark shared by the expanded and icon-only sidebars. -->
        <Geometry x:Key="GscBrandIconGeometry">M 5,17 C 5,11 10,7 16,7 L 32,7 C 38,7 43,11 43,17 L 43,26 C 43,31 39,35 35,35 C 31,35 29,32 27,29 L 21,29 C 19,32 17,35 13,35 C 9,35 5,31 5,26 Z</Geometry>
        <Geometry x:Key="GscBrandDpadGeometry">M 14,17 L 14,25 M 10,21 L 18,21</Geometry>
        <Geometry x:Key="GscBrandSaveGeometry">M 24,29 L 24,39 M 19,35 L 24,40 L 29,35 M 16,43 L 32,43</Geometry>

        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="GscFocusVisual" TargetType="Control" BasedOn="{StaticResource GscSharedFocusVisual}"/>

        <Style x:Key="GscSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>

        <!-- This page uses elevation only for the two permanent work areas. Repeated cards,
             table frames and form groups stay flat so their content remains inexpensive while
             scrolling or switching modules. -->
        <Style x:Key="GscElevatedSurface" TargetType="Border" BasedOn="{StaticResource GscSurface}">
            <Setter Property="Effect" Value="{DynamicResource GscSurfaceEffect}"/>
        </Style>

        <Style x:Key="GscTableFrame" TargetType="Border" BasedOn="{StaticResource GscSurface}">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
        </Style>

        <Style x:Key="GscMetricCard" TargetType="{x:Type ui:Card}" BasedOn="{StaticResource GscWpfUiCard}">
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinHeight" Value="80"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <EventSetter Event="MouseEnter" Handler="OnMetricCardMouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnMetricCardMouseLeave"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GscButtonBase" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <EventSetter Event="MouseEnter" Handler="OnButtonMouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnButtonMouseLeave"/>
        </Style>

        <Style x:Key="GscPrimaryButton" TargetType="Button" BasedOn="{StaticResource GscButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource GscOnAccentTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GscPrimaryButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscPrimaryButtonBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"
                                Effect="{DynamicResource GscPrimaryButtonEffect}">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscContextButton" TargetType="Button" BasedOn="{StaticResource GscButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button rows use an explicit zero-margin style so every item shares the same
             measured height and vertical center. Spacing is owned by the parent layout. -->
        <Style x:Key="GscToolbarButton" TargetType="Button" BasedOn="{StaticResource GscButtonBase}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GscToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource GscPrimaryButton}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>


        <!-- The header and selected content are deliberately separated.  In 0.5.9 the
             TabItem content-alignment values were set to Center, and those inheritable
             properties pulled complete page layouts into the middle of the available area.
             The header remains centered by its own presenter while tab content always stretches. -->
        <Style x:Key="GscTabControl" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                              SnapsToDevicePixels="True"
                              ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Keep enough space below the header viewport so the lower two
                                 rounded corners are never clipped.  The scrollbar is hidden;
                                 the small number of module tabs does not need a visible track. -->
                            <Border Grid.Row="0"
                                    Padding="1,1,1,10"
                                    Background="Transparent"
                                    ClipToBounds="False">
                                <ScrollViewer x:Name="HeaderScrollViewer"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              PanningMode="HorizontalOnly"
                                              Focusable="False"
                                              ClipToBounds="False">
                                    <TabPanel x:Name="HeaderPanel"
                                              IsItemsHost="True"
                                              Background="Transparent"
                                              ClipToBounds="False"
                                              KeyboardNavigation.TabIndex="1"/>
                                </ScrollViewer>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <!-- TabPanel may clip the right edge of a child that uses an external Margin.
                 Keep all inter-tab spacing inside the template so the complete Border,
                 including both right corners, stays inside the arranged TabItem slot. -->
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- These properties are inherited by the selected TabItem content.  They must
                 remain Stretch; only the header presenter below is centered. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- The fixed spacer column replaces TabItem.Margin.  WPF TabPanel can
                             clip a template at the arranged slot boundary; keeping 8 DIP of
                             transparent space inside that slot prevents the right rounded edge
                             from being cut into a straight vertical line. -->
                        <Grid Background="Transparent"
                              ClipToBounds="False"
                              UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TabChrome"
                                    Grid.Column="0"
                                    Margin="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="False"
                                    UseLayoutRounding="True"
                                    ClipToBounds="False">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabChrome" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscCenteredCellText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="GscLeftCellText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- A DataGridTextColumn does not inherit a useful ToolTip from its binding. Reuse this
             only for names and diagnostic text that can be truncated in compact layouts. -->
        <Style x:Key="GscLongTextCell" TargetType="TextBlock" BasedOn="{StaticResource GscLeftCellText}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <!-- Keep finite-width combo boxes readable without expanding their Popup or toolbar. -->
        <Style x:Key="GscComboBoxLongText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <!-- Column-resize hit areas remain available, but the host theme must not draw a
             bright native Thumb over the header on light themes. -->
        <Style x:Key="GscColumnHeaderGripper" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscDataGrid" TargetType="DataGrid">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GscDividerBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="RowHeight" Value="46"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="MinColumnWidth" Value="64"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Tag">
                <Setter.Value><CornerRadius>0</CornerRadius></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="HeaderChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                                <Path x:Name="SortArrow" Data="M 0 5 L 5 0 L 10 5" Stretch="None"
                                      Stroke="{DynamicResource GscAccentBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,9,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                </Path>
                                <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource GscColumnHeaderGripper}"
                                       Width="8" HorizontalAlignment="Left" Cursor="SizeWE"/>
                                <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource GscColumnHeaderGripper}"
                                       Width="8" HorizontalAlignment="Right" Cursor="SizeWE"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource GscRowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Tag">
                <Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Tag">
                <Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscOnlyColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Tag">
                <Setter.Value><CornerRadius>11,11,0,0</CornerRadius></Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CellChrome" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscLeftDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GscStretchDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter x:Name="PART_CellsPresenter"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource GscRowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Grid>
                                <Border x:Name="SelectionIndicator" Width="2" Margin="3,8,0,8" CornerRadius="1"
                                        HorizontalAlignment="Left" Background="{DynamicResource GscAccentBrush}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource GscRowHoverStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GscNavItem" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GscSelectionTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseEnter" Handler="OnNavigationMouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnNavigationMouseLeave"/>
        </Style>

        <Style x:Key="GscEmptyText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="22"/>
        </Style>

        <Style x:Key="GscStatusPill" TargetType="Border">
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootShell" Background="{DynamicResource GscBackdropBrush}" ClipToBounds="True">
        <Grid x:Name="AmbientGlowLayer" IsHitTestVisible="False" Opacity="0.9">
            <Ellipse Width="360" Height="360" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource GscAmbientAccentBrush}">
                <Ellipse.RenderTransform><TranslateTransform X="-95" Y="-130"/></Ellipse.RenderTransform>
                <Ellipse.Effect><BlurEffect Radius="82"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="320" Height="320" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,35,0,0" Fill="{DynamicResource GscAmbientInfoBrush}">
                <Ellipse.RenderTransform><TranslateTransform X="105" Y="0"/></Ellipse.RenderTransform>
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,20,0" Fill="{DynamicResource GscAmbientSuccessBrush}">
                <Ellipse.RenderTransform><TranslateTransform X="0" Y="165"/></Ellipse.RenderTransform>
                <Ellipse.Effect><BlurEffect Radius="96"/></Ellipse.Effect>
            </Ellipse>
        </Grid>

        <Grid x:Name="ResponsiveShell" Margin="18,16,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="194"/>
                <ColumnDefinition x:Name="SidebarGutterColumn" Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarChrome" Grid.Column="0" Style="{StaticResource GscRedesignSidebarSurface}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="SidebarBrandContainer" Margin="0,2,0,20" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border x:Name="SidebarBrandIcon" Width="42" Height="42" CornerRadius="13" Background="{DynamicResource GscAccentBrush}" ToolTip="GameSaveCenter" ClipToBounds="False">
                                <Viewbox Margin="7" Stretch="Uniform">
                                    <Grid Width="48" Height="48">
                                        <Path Data="{StaticResource GscBrandIconGeometry}" Fill="{DynamicResource GscOnAccentTextBrush}" Stretch="None"/>
                                        <Path Data="{StaticResource GscBrandDpadGeometry}" Stroke="{DynamicResource GscAccentBrush}" StrokeThickness="3.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource GscInfoBrush}" Margin="30,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource GscAccentBrush}" Margin="35,21,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Path Data="{StaticResource GscBrandSaveGeometry}" Stroke="{DynamicResource GscOnAccentTextBrush}" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <StackPanel x:Name="SidebarBrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GameSaveCenter" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="SidebarVersionText" Text="v0.6.22" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource GscDividerBrush}" Margin="0,0,0,15"/>
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  KeyboardNavigation.TabNavigation="Local">
                    <StackPanel>
                        <RadioButton x:Name="NavOverview" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" IsChecked="True" Tag="Overview" Checked="OnNavigationChecked" ToolTip="首页">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Width="27" FontSize="16"/><TextBlock x:Name="NavOverviewLabel" Text="首页" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSaves" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Saves" Checked="OnNavigationChecked" ToolTip="存档中心">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Width="27" FontSize="16"/><TextBlock x:Name="NavSavesLabel" Text="存档中心" VerticalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTrainers" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Trainers" Checked="OnNavigationChecked" ToolTip="修改器中心">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" Width="27" FontSize="16"/><TextBlock x:Name="NavTrainersLabel" Text="修改器中心" VerticalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMedia" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Media" Checked="OnNavigationChecked" ToolTip="媒体中心">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;" Width="27" FontSize="16"/><TextBlock x:Name="NavMediaLabel" Text="媒体中心" VerticalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTasks" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Tasks" Checked="OnNavigationChecked" ToolTip="任务中心">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" Width="27" FontSize="16"/><TextBlock x:Name="NavTasksLabel" Text="任务中心" VerticalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMaintenance" GroupName="WorkspaceNavigation" Style="{StaticResource GscNavItem}" Tag="Maintenance" Checked="OnNavigationChecked" ToolTip="维护中心">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Width="27" FontSize="16"/><TextBlock x:Name="NavMaintenanceLabel" Text="维护中心" VerticalAlignment="Center"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="SidebarStatusPanel" Grid.Row="3" Margin="0,12,0,0" ToolTip="Worker 与 Ludusavi 运行状态">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Height="1" Background="{DynamicResource GscDividerBrush}" Margin="0,0,0,12"/>
                        <Border x:Name="SidebarWorkerStatusCard" Grid.Row="1" Style="{StaticResource GscRedesignStatusCard}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SidebarWorkerStatusDot" Width="9" Height="9" CornerRadius="5" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource GscErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource GscSuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock x:Name="SidebarWorkerCompactLabel" Grid.Column="1" Text="W" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <StackPanel x:Name="SidebarWorkerStatusText" Grid.Column="1">
                                    <TextBlock Text="Worker" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                                <Setter Property="Text" Value="运行中"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Snapshot.WorkerHealthy}" Value="False">
                                                        <Setter Property="Text" Value="不可用"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="SidebarLudusaviStatusCard" Grid.Row="2" Style="{StaticResource GscRedesignStatusCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SidebarLudusaviStatusDot" Width="9" Height="9" CornerRadius="5" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource GscErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Snapshot.LudusaviAvailable}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource GscSuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock x:Name="SidebarLudusaviCompactLabel" Grid.Column="1" Text="L" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <StackPanel x:Name="SidebarLudusaviStatusText" Grid.Column="1">
                                    <TextBlock Text="Ludusavi" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Snapshot.LudusaviVersion}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource GscSuccessBrush}"/>
                                                <Setter Property="Text" Value="已连接"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Snapshot.LudusaviAvailable}" Value="False">
                                                        <Setter Property="Text" Value="未连接"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource GscErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="MainShell" Grid.Column="2" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="4,0,0,16" MinWidth="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="HeaderCompactActionsRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="TopChromeSafetyColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" MinWidth="0">
                <TextBlock x:Name="PageTitleText" Text="首页" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PageSubtitleText" Text="存档、修改器、媒体与任务的一体化工作台"
                           Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>

            <ScrollViewer x:Name="TopActionsScroller" Grid.Row="0" Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0"
                          CanContentScroll="False" Focusable="False">
                <StackPanel x:Name="TopActionsPanel" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ui:Button x:Name="TopRefreshButton" Style="{StaticResource GscRedesignHeaderButton}" AutomationProperties.Name="刷新全部状态" ToolTip="刷新全部状态" Command="{Binding RefreshCommand}">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="TopRefreshLabel" Grid.Column="1" Text="刷新" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>
                    </ui:Button>
                    <ui:Button x:Name="TopBackupAllButton" Style="{StaticResource GscRedesignPrimaryHeaderButton}" AutomationProperties.Name="备份全部游戏" ToolTip="备份全部游戏" Command="{Binding BackupAllCommand}">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="TopBackupAllLabel" Grid.Column="1" Text="全部备份" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>
                    </ui:Button>
                    <ui:Button x:Name="TopMediaSyncButton" Style="{StaticResource GscRedesignHeaderButton}" AutomationProperties.Name="同步媒体" ToolTip="同步媒体" Command="{Binding SyncMediaCommand}">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="TopMediaSyncLabel" Grid.Column="1" Text="同步媒体" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>
                    </ui:Button>
                    <ui:Button x:Name="TopTrainerImportButton" Style="{StaticResource GscRedesignHeaderButton}" AutomationProperties.Name="导入修改器" ToolTip="导入修改器" Command="{Binding ImportTrainerCommand}" Visibility="Collapsed">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B5;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="TopTrainerImportLabel" Grid.Column="1" Text="导入修改器" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>
                    </ui:Button>
                    <ui:Button x:Name="TopTrainerCatalogButton" Style="{StaticResource GscRedesignHeaderButton}" AutomationProperties.Name="刷新目录" ToolTip="刷新目录" Command="{Binding SyncTrainerCatalogCommand}" Visibility="Collapsed">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="TopTrainerCatalogLabel" Grid.Column="1" Text="刷新目录" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>
                    </ui:Button>
                    <ui:Button x:Name="TopDiagnosticsButton" Style="{StaticResource GscRedesignHeaderButton}" AutomationProperties.Name="刷新诊断" ToolTip="刷新诊断" Command="{Binding RefreshDiagnosticsCommand}" Visibility="Collapsed">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="TopDiagnosticsLabel" Grid.Column="1" Text="刷新诊断" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>
                    </ui:Button>
                    <ui:Button x:Name="ToggleGameBrowserButton" Style="{StaticResource GscRedesignHeaderButton}"
                               AutomationProperties.Name="打开游戏库" ToolTip="打开游戏搜索、状态筛选和排序" Click="OnToggleGameBrowserClick" Visibility="Collapsed">
                        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="ToggleGameBrowserLabel" Grid.Column="1" Text="游戏库" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>
                    </ui:Button>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="GameSwitcherHost" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,12,0,0" MaxWidth="640" HorizontalAlignment="Left"
                    Style="{StaticResource GscRedesignSectionCard}" Padding="7" Visibility="Collapsed">
                <Button x:Name="CompactGameSelector" Style="{StaticResource GscRedesignGameContextButton}"
                        HorizontalAlignment="Stretch" Click="OnToggleGameBrowserClick"
                        AutomationProperties.Name="选择当前游戏"
                        ToolTip="打开游戏搜索、状态筛选和排序">
                    <Grid MinWidth="0" Margin="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource GscAccentTintBrush}" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,12,0" MinWidth="0">
                            <TextBlock Style="{StaticResource GscComboBoxLongText}" Text="{Binding SelectedGame.Name, TargetNullValue=请选择游戏}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource GscComboBoxLongText}" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}">
                                <Run Text="{Binding SelectedGame.PlatformDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedGame.InstallStateDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedGame.MatchStateDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedGame.HealthStateDisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GscInfoBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding SelectedGame.BackupVersionCount, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource GscInfoBrush}"/>
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GscWarningBrush}" Margin="10,0,4,0"/>
                            <TextBlock Text="{Binding SelectedGame.MediaCount, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource GscWarningBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding SelectedGame.CloudStateDisplay, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource GscInfoBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="4" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" Foreground="{DynamicResource GscSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Border>
        </Grid>
        <UniformGrid x:Name="MetricsPanel" Grid.Row="1" Columns="6" Margin="0,0,0,18">
            <ui:Card Style="{StaticResource GscRedesignMetricCard}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource GscAccentIconFillBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="管理游戏" TextAlignment="Center" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.ManagedGames}" TextAlignment="Center" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </ui:Card>
            <ui:Card Style="{StaticResource GscRedesignMetricCard}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource GscInfoIconFillBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Foreground="{DynamicResource GscInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="已匹配存档" TextAlignment="Center" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.MatchedGames}" TextAlignment="Center" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </ui:Card>
            <ui:Card Style="{StaticResource GscRedesignMetricCard}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource GscSuccessIconFillBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Foreground="{DynamicResource GscSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="正在运行" TextAlignment="Center" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.RunningGames}" TextAlignment="Center" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </ui:Card>
            <ui:Card Style="{StaticResource GscRedesignMetricCard}">
                <Button Style="{StaticResource GscButtonBase}"
                        Command="{Binding OpenAttentionCenterCommand}"
                        ToolTip="查看需要关注的游戏、原因和建议处理方式"
                        HorizontalContentAlignment="Stretch"
                        Padding="0" Margin="0" Background="Transparent" BorderBrush="Transparent">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource GscErrorIconFillBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB52;" Foreground="{DynamicResource GscErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="需要关注" TextAlignment="Center" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.WarningGames}" TextAlignment="Center" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                </Button>
            </ui:Card>
            <ui:Card Style="{StaticResource GscRedesignMetricCard}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource GscInfoIconFillBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" Foreground="{DynamicResource GscInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="云端任务" TextAlignment="Center" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.PendingCloudTasks}" TextAlignment="Center" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </ui:Card>
            <ui:Card Style="{StaticResource GscRedesignMetricCard}" Margin="0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource GscWarningIconFillBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE91B;" Foreground="{DynamicResource GscWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/></Border>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="待归类媒体" TextAlignment="Center" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.UnassignedMediaCount}" TextAlignment="Center" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </ui:Card>
        </UniformGrid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="WorkspaceCompactBrowserRow" Height="0"/>
                <RowDefinition x:Name="WorkspaceDetailRow" Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GameListColumn" Width="0.95*"/>
                <ColumnDefinition x:Name="WorkspaceGutterColumn" Width="16"/>
                <ColumnDefinition x:Name="GameDetailColumn" Width="2.05*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="GameBrowserPanel" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource GscRedesignSectionCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="游戏与状态" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource GscMutedTextBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding GamePicker.FilteredCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Snapshot.ManagedGames, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid x:Name="SearchBoxContainer" Margin="0,0,0,8">
                            <TextBox x:Name="GameSearchTextBox"
                                     Style="{StaticResource GscWpfUiTextBox}"
                                     Text="{Binding GamePicker.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="搜索游戏名、Ludusavi 名称、平台或状态"
                                     Padding="32,7,38,7"/>
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE721;"
                                       Foreground="{DynamicResource GscMutedTextBrush}"
                                       Margin="11,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="搜索游戏…"
                                       Foreground="{DynamicResource GscMutedTextBrush}"
                                       Margin="32,0,38,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=GameSearchTextBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=GameSearchTextBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,7,0"
                                    Tag="{Binding ElementName=GameSearchTextBox}"
                                    ToolTip="清除搜索"
                                    Click="OnClearTextBoxClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GscSearchClearButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=GameSearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=GameSearchTextBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="3">
                            <ComboBox Style="{StaticResource GscWpfUiComboBox}" ItemsSource="{Binding GamePicker.StatusFilterOptions}" SelectedItem="{Binding GamePicker.StatusFilter}" Margin="0,0,4,0" ToolTip="状态筛选"/>
                            <ComboBox Style="{StaticResource GscWpfUiComboBox}" ItemsSource="{Binding GamePicker.PlatformFilterOptions}" SelectedItem="{Binding GamePicker.PlatformFilter}" Margin="4,0,4,0" ToolTip="平台筛选"/>
                            <ComboBox Style="{StaticResource GscWpfUiComboBox}" ItemsSource="{Binding GamePicker.SortOptions}" SelectedItem="{Binding GamePicker.SortMode}" Margin="4,0,0,0" ToolTip="排序"/>
                        </UniformGrid>
                    </Grid>
                    <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding GamePicker.ItemsView}" SelectedItem="{Binding GamePicker.SelectedItem, Mode=TwoWay}" SelectionChanged="OnGameSelectionChanged"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource GscFocusVisual}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="11" Padding="11,9">
                                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <Border x:Name="SelectionIndicator" Width="2" Margin="3,9,0,9" CornerRadius="1"
                                                        HorizontalAlignment="Left" Background="{DynamicResource GscAccentBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/>
                                                    <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource GscRowHoverStrongBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource GscAccentIconFillBrush}" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding PlatformDisplay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="StateDot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource GscWarningBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding HealthStateDisplay}" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HealthState}" Value="Ready"><Setter TargetName="StateDot" Property="Background" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding HealthState}" Value="Attention"><Setter TargetName="StateDot" Property="Background" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="没有符合条件的游戏&#x0a;请调整搜索或筛选条件。" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding FilteredGameCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="GameDetailCard" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource GscRedesignHeroCard}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="SelectedGameHeader" Style="{StaticResource GscRedesignSectionCard}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource GscAccentTintBrush}" VerticalAlignment="Top">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" FontSize="22" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" MinWidth="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=请选择游戏}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.Name}"/>
                                        <Border Style="{StaticResource GscRedesignContextPill}" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource GscWarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Ready"><Setter Property="Background" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="Attention"><Setter Property="Background" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedGame.HealthState}" Value="LudusaviUnavailable"><Setter Property="Background" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="{Binding SelectedGame.HealthStateDisplay, Mode=OneWay}" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding SelectedGame.PlatformDisplay, Mode=OneWay}"/><Run Text=" · Ludusavi："/><Run Text="{Binding SelectedGame.LudusaviName, Mode=OneWay, TargetNullValue=未匹配}"/>
                                    </TextBlock>
                                </StackPanel>
                                <UniformGrid x:Name="SelectedGameMetricPanel" Grid.Column="2" Columns="3" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,8,0"><StackPanel><TextBlock Text="版本" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedGame.BackupVersionCount, Mode=OneWay}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,8,0"><StackPanel><TextBlock Text="媒体" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedGame.MediaCount, Mode=OneWay}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource GscRedesignContextPill}"><StackPanel><TextBlock Text="云端" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding SelectedGame.CloudStateDisplay, Mode=OneWay}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                                </UniformGrid>
                            </Grid>
                            <WrapPanel x:Name="GameHeaderActions" Grid.Row="1" VerticalAlignment="Center" Margin="62,12,0,0">
                                <ui:Button x:Name="BackupSelectedButton" Style="{StaticResource GscWpfUiToolbarPrimaryButton}" Command="{Binding BackupSelectedCommand}" Content="立即备份" Margin="0,0,8,0"/>
                                <ui:Button x:Name="ValidateButton" Style="{StaticResource GscWpfUiToolbarButton}" Command="{Binding ValidateCommand}" Content="校验" Margin="0,0,8,0"/>
                                <ui:Button x:Name="DetectPathsButton" Style="{StaticResource GscWpfUiToolbarButton}" Command="{Binding DetectPathsCommand}" Content="侦测路径" Margin="0,0,8,0"/>
                                <ui:Button Style="{StaticResource GscWpfUiToolbarButton}" Command="{Binding LoadDetailsCommand}" Content="刷新详情" ToolTip="重新读取当前游戏的备份、媒体和策略详情" Margin="0,0,8,0"/>
                                <ui:Button x:Name="PolicyToggleButton" Style="{StaticResource GscWpfUiToolbarButton}" Click="OnTogglePolicy" Content="策略"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="RestoreSafetyBanner" Grid.Row="1" Background="{DynamicResource GscRestoreInfoFillBrush}" BorderBrush="{DynamicResource GscRestoreInfoStrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,14,0,12">
                        <DockPanel>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="{DynamicResource GscInfoBrush}" FontSize="16" Margin="0,0,9,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="自动恢复默认关闭。恢复前会创建并锁定当前快照，恢复后校验，失败时尝试回滚。" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <Border x:Name="BackupPolicyPanel" Grid.Row="2" Background="{DynamicResource GscControlFillBrush}" BorderBrush="{DynamicResource GscDividerBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <WrapPanel VerticalAlignment="Center">
                            <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="启用当前游戏自动任务" OnContent="开" OffContent="关" IsChecked="{Binding SelectedGame.Policy.Enabled}" Margin="0,3,18,3" ToolTip="关闭后不会因启动、退出或游玩间隔自动备份或归档媒体；手动操作仍可使用。"/>
                            <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="退出后备份" OnContent="开" OffContent="关" IsChecked="{Binding SelectedGame.Policy.BackupOnGameStop}" Margin="0,3,18,3"/>
                            <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="游玩中备份" OnContent="开" OffContent="关" IsChecked="{Binding SelectedGame.Policy.BackupDuringPlay}" Margin="0,3,12,3"/>
                            <TextBlock Text="间隔" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource GscNumericTextBox}" Width="88" infra:SelectAllOnKeyboardFocus.Enabled="True"
                                     ToolTip="允许 1–1440 分钟；输入完成后离开输入框或点击“保存策略”提交。" Margin="7,0,7,0">
                                <TextBox.Text><Binding Path="SelectedGame.Policy.DuringPlayIntervalMinutes" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" NotifyOnValidationError="True"><Binding.ValidationRules><infra:IntegerRangeValidationRule Minimum="1" Maximum="1440"/></Binding.ValidationRules></Binding></TextBox.Text>
                            </TextBox>
                            <TextBlock Text="分钟" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="退出后归档媒体" OnContent="开" OffContent="关" IsChecked="{Binding SelectedGame.Policy.SyncMediaOnGameStop}" Margin="0,3,18,3"/>
                            <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="游玩中归档媒体" OnContent="开" OffContent="关" IsChecked="{Binding SelectedGame.Policy.SyncMediaDuringPlay}" Margin="0,3,18,3"/>
                            <ui:ToggleSwitch Style="{StaticResource GscWpfUiToggleSwitch}" Content="上传云端" OnContent="开" OffContent="关" IsChecked="{Binding SelectedGame.Policy.UploadAfterBackup}" Margin="0,3,12,3"/>
                            <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding SavePolicyCommand}" Content="保存策略" Margin="0"/>
                        </WrapPanel>
                    </Border>

                    <TabControl x:Name="DetailsTabControl" Grid.Row="3" MinHeight="0"
                                Style="{StaticResource GscTabControl}"
                                SelectionChanged="OnDetailsTabSelectionChanged">
                        <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource GscTabItem}"/></TabControl.Resources>
                        <TabItem x:Name="OverviewWorkspaceTab" Header="首页概览">
                            <views:OverviewView x:Name="OverviewWorkspaceView"/>
                        </TabItem>
                        <TabItem x:Name="OverviewTab" Header="首页概览">
                            <Grid x:Name="OverviewLayoutGrid" Margin="0,12,0,0" MinHeight="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition x:Name="OverviewCompactSecondaryRow" Height="0"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="OverviewPrimaryColumn" Width="1.2*"/>
                                    <ColumnDefinition x:Name="OverviewGutterColumn" Width="14"/>
                                    <ColumnDefinition x:Name="OverviewSecondaryColumn" Width="0.8*"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="OverviewPrimaryPanel" Grid.Row="0" Grid.Column="0" MinWidth="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border Style="{StaticResource GscRedesignHeroCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="68" Height="68" CornerRadius="20" Background="{DynamicResource GscAccentTintBrush}"
                                                    VerticalAlignment="Top" HorizontalAlignment="Left">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" FontSize="27"
                                                           Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Grid Grid.Column="1" MinWidth="0">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel MinWidth="0">
                                                        <TextBlock Text="当前游戏" Foreground="{DynamicResource GscAccentBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=请选择游戏}" FontSize="24" FontWeight="SemiBold"
                                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.Name}"/>
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding SelectedGame.PlatformDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedGame.HealthStateDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                                <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,0">
                                                    <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,8,0"><StackPanel><TextBlock Text="最新备份" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedGame.LastBackupLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}, TargetNullValue=暂无}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                                    <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,8,0"><StackPanel><TextBlock Text="版本数量" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock FontWeight="SemiBold" Margin="0,4,0,0"><Run Text="{Binding SelectedGame.BackupVersionCount, Mode=OneWay}"/><Run Text=" 个"/></TextBlock></StackPanel></Border>
                                                    <Border Style="{StaticResource GscRedesignContextPill}" Margin="0,0,8,0"><StackPanel><TextBlock Text="媒体" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock FontWeight="SemiBold" Margin="0,4,0,0"><Run Text="{Binding SelectedGame.MediaCount, Mode=OneWay}"/><Run Text=" 项"/></TextBlock></StackPanel></Border>
                                                    <Border Style="{StaticResource GscRedesignContextPill}"><StackPanel><TextBlock Text="云端" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedGame.CloudStateDisplay, Mode=OneWay}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                                </UniformGrid>
                                                <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                                                    <ui:Button Style="{StaticResource GscWpfUiPrimaryActionButton}" Command="{Binding BackupSelectedCommand}" Content="立即备份"/>
                                                    <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding LoadDetailsCommand}" Content="刷新详情"/>
                                                    <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding OpenAttentionCenterCommand}" Content="查看需关注项" Margin="0"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Style="{StaticResource GscRedesignSectionCard}" Margin="0,14,0,0" MinHeight="0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Style="{StaticResource GscRedesignSectionTitle}" Text="最近活动"/><TextBlock Style="{StaticResource GscRedesignSectionSubtitle}" Text="最多显示最近 8 条真实任务记录" Margin="0,4,0,0"/></StackPanel>
