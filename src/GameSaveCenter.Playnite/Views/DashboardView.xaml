                                    <RowDefinition x:Name="SaveHistoryCompactInspectorRow" Height="0"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SaveHistoryListColumn" Width="1.25*"/>
                                    <ColumnDefinition x:Name="SaveHistoryGutterColumn" Width="14"/>
                                    <ColumnDefinition x:Name="SaveHistoryInspectorColumn" Width="0.75*"/>
