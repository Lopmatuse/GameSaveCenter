                                                    <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding OpenGameToolDirectoryCommand}" Content="打开目录"/>
                                                    <ui:Button Style="{StaticResource GscWpfUiActionButton}" Command="{Binding DeleteGameToolCommand}" Content="解除绑定" Margin="0"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="FLiNG 在线库">
