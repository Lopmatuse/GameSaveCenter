                                    </Border>
                                    <Border Style="{StaticResource GscRedesignSectionCard}" Padding="14">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource GscSuccessIconFillBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" Foreground="{DynamicResource GscSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="安全默认" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="自动启动关闭" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
