<UserControl x:Class="GameSaveCenter.Playnite.Views.MediaCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:GameSaveCenter.Contracts;assembly=GameSaveCenter.Contracts"
             xmlns:converters="clr-namespace:GameSaveCenter.Playnite.Converters"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MediaInboxColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MediaInboxStableRowStyle" TargetType="DataGridRow">
                <Setter Property="MinHeight" Value="{DynamicResource GscTableRowHeight}"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <converters:MediaThumbnailConverter x:Key="MediaThumbnailConverter"/>
            <converters:MediaVideoSourceConverter x:Key="MediaVideoSourceConverter"/>
            <Style x:Key="MediaDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="RowStyle" Value="{StaticResource MediaInboxStableRowStyle}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/>
                <Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/>
                <Setter Property="MinHeight" Value="{DynamicResource GscWorkspaceTableMinHeight}"/>
                <Setter Property="ColumnHeaderHeight" Value="{DynamicResource GscTableHeaderHeight}"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <!-- The inbox is the only remaining DataGrid that combines a large,
                     recycled item set with star-sized text columns.  Keep scrolling on
                     whole rows and let the table surface own the inner background; this
                     prevents WPF's virtualized presenter from exposing a white phantom
                     viewport after the thumb is dragged. -->
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource MediaInboxColumnHeaderStyle}"/>
            </Style>
            <Style x:Key="MediaLongText" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="MediaTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <Style x:Key="MediaEmptyText" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource GscMutedTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="22"/></Style>
            <Style x:Key="MediaStatusPill" TargetType="Border"><Setter Property="MinWidth" Value="48"/><Setter Property="Padding" Value="12,8"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{DynamicResource GscGlassStrongBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
            <Style x:Key="MediaFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaInboxColumnHeaderStyle}"><Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="MediaMiddleColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaInboxColumnHeaderStyle}"/>
            <Style x:Key="MediaLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaInboxColumnHeaderStyle}"><Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="MediaTabControl" TargetType="TabControl" BasedOn="{StaticResource GscRedesignWorkspaceTabControl}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="MediaTabItem" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="GscTableFrame" TargetType="Border" BasedOn="{StaticResource MediaTableFrame}"/>
            <Style x:Key="GscFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaFirstColumnHeader}"/>
            <Style x:Key="GscLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MediaLastColumnHeader}"/>
            <Style x:Key="GscTabControl" TargetType="TabControl" BasedOn="{StaticResource MediaTabControl}"/>
            <Style x:Key="GscTabItem" TargetType="TabItem" BasedOn="{StaticResource MediaTabItem}"/>
            <Style x:Key="GscEmptyText" TargetType="TextBlock" BasedOn="{StaticResource MediaEmptyText}"/>
            <Style x:Key="GscStatusPill" TargetType="Border" BasedOn="{StaticResource MediaStatusPill}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <UniformGrid x:Name="MediaSummaryPanel" Grid.Row="0" Columns="4" Margin="0,0,0,12">
            <Border Style="{DynamicResource GscRedesignSectionCard}" Padding="13" Margin="0,0,10,0"><StackPanel><TextBlock Text="媒体总数" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding MediaSummary.TotalCount, Mode=OneWay}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{DynamicResource GscRedesignSectionCard}" Padding="13" Margin="0,0,10,0"><StackPanel><TextBlock Text="截图 / 录像" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"><Run Text="{Binding MediaSummary.ScreenshotCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding MediaSummary.VideoCount, Mode=OneWay}"/></TextBlock></StackPanel></Border>
            <Border Style="{DynamicResource GscRedesignSectionCard}" Padding="13" Margin="0,0,10,0"><StackPanel><TextBlock Text="收藏" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding MediaSummary.FavoriteCount, Mode=OneWay}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{DynamicResource GscRedesignSectionCard}" Padding="13"><StackPanel><TextBlock Text="待归类" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding Snapshot.UnassignedMediaCount, Mode=OneWay}" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
        </UniformGrid>
        <TabControl Grid.Row="1" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Style="{StaticResource MediaTabControl}">
            <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource MediaTabItem}"/></TabControl.Resources>
            <TabItem Header="待归类">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{DynamicResource GscRedesignInfoBand}" Margin="0,0,0,10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="待归类媒体" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="只保留无法唯一判断所属游戏的公共截图和录像，不会静默猜测。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource MediaStatusPill}" VerticalAlignment="Center"><TextBlock Text="{Binding Snapshot.UnassignedMediaCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/></Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource MediaTableFrame}" MinHeight="0" ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="MediaInboxGrid" Style="{StaticResource MediaDataGrid}" MinHeight="0" ItemsSource="{Binding UnassignedMedia}" SelectedItem="{Binding SelectedInboxMedia}"
                                      RowStyle="{StaticResource MediaInboxStableRowStyle}"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Standard"
                                      VerticalContentAlignment="Top"
                                      HorizontalContentAlignment="Stretch"
                                      VirtualizingPanel.ScrollUnit="Item"
                                      EnableColumnVirtualization="False"
                                      ClipToBounds="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaFirstColumnHeader}" Header="拍摄时间" Binding="{Binding CapturedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm}}" Width="110"/>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaMiddleColumnHeader}" Header="类型" Binding="{Binding KindDisplay, Mode=OneWay}" Width="72"/>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaMiddleColumnHeader}" Header="来源" Binding="{Binding SourceDisplay, Mode=OneWay}" Width="115"/>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaMiddleColumnHeader}" Header="文件" Binding="{Binding FileName, Mode=OneWay}" Width="*" MinWidth="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MediaLongText}"><Setter Property="ToolTip" Value="{Binding OriginalPath}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                    <DataGridTextColumn HeaderStyle="{StaticResource MediaLastColumnHeader}" Header="原因" Binding="{Binding ClassificationReason, Mode=OneWay}" Width="1.1*" MinWidth="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MediaLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="当前没有等待归类的媒体。" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnassignedMedia.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="归类到：" VerticalAlignment="Center"/>
                        <ComboBox Style="{DynamicResource GscWpfUiComboBox}" MinWidth="180" MaxWidth="320" ItemsSource="{Binding Games}" SelectedItem="{Binding InboxTargetGame}" Margin="7,0,8,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding AssignInboxMediaCommand}" Content="确认归类"/>
                        <ui:Button Style="{DynamicResource GscWpfUiActionButton}" Command="{Binding IgnoreInboxMediaCommand}" Content="忽略并保留副本"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="当前游戏媒体">
                <Grid x:Name="MediaCurrentLayout" Margin="0,12,0,0" ClipToBounds="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <WrapPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
                        <Border Style="{DynamicResource GscRedesignCounterPill}" Margin="0,0,8,8"><TextBlock><Run Text="媒体 "/><Run Text="{Binding MediaSummary.TotalCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                        <Border Style="{DynamicResource GscRedesignCounterPill}" Margin="0,0,8,8"><TextBlock><Run Text="截图 "/><Run Text="{Binding MediaSummary.ScreenshotCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                        <Border Style="{DynamicResource GscRedesignCounterPill}" Margin="0,0,8,8"><TextBlock><Run Text="录像 "/><Run Text="{Binding MediaSummary.VideoCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                        <Border Style="{DynamicResource GscRedesignCounterPill}" Margin="0,0,0,8"><TextBlock><Run Text="占用 "/><Run Text="{Binding MediaSummary.TotalSizeDisplay, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                    </WrapPanel>
                    <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource GscSurface}" Padding="8" Margin="0,0,0,10" ClipToBounds="True">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding MediaSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按文件名、备注或来源搜索当前游戏媒体"/>
                            <ComboBox Grid.Column="1" Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding MediaFilterOptions}" SelectedIndex="0" SelectedItem="{Binding MediaFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" ToolTip="媒体类型筛选"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MediaTableFrame}" MinHeight="{DynamicResource GscWorkspaceTableMinHeight}">
                        <Grid>
                        <ListBox x:Name="MediaGrid" ItemsSource="{Binding MediaView}" SelectedItem="{Binding SelectedMedia}" SelectionMode="Extended" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="MediaCard" Style="{DynamicResource GscRedesignSubCard}" Padding="12"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="MediaCard" Property="Background" Value="{DynamicResource GscAccentTintBrush}"/><Setter TargetName="MediaCard" Property="BorderBrush" Value="{DynamicResource GscAccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MediaCard" Property="BorderBrush" Value="{DynamicResource GscAccentTintStrongBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="80" Height="56" CornerRadius="10" Background="{DynamicResource GscControlFillBrush}" ClipToBounds="True" ToolTip="{Binding FileName}"><Grid><Image Source="{Binding ArchivePath, Converter={StaticResource MediaThumbnailConverter}, ConverterParameter=96}" Stretch="UniformToFill"/><TextBlock Text="视频" Foreground="{DynamicResource GscOnAccentTextBrush}" Background="{DynamicResource GscInfoBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,2" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding KindDisplay}" Value="录像"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"><Run Text="{Binding CapturedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/><Run Text=" · "/><Run Text="{Binding KindDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SourceDisplay, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Comment, Mode=OneWay, TargetNullValue=无备注}" Foreground="{DynamicResource GscMutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Comment}" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><Border Style="{DynamicResource GscRedesignTableStatusPill}" Background="{DynamicResource GscControlFillBrush}"><TextBlock Text="{Binding CloudStateDisplay, Mode=OneWay}" FontSize="10" HorizontalAlignment="Center"/></Border><TextBlock Text="★ 收藏" Foreground="{DynamicResource GscWarningBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="当前游戏还没有媒体&#xA;导入截图或录像后，它们会显示在这里。" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MediaView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Grid>
                    </Border>
                    <Border x:Name="MediaInspectorFrame" Grid.Row="2" Grid.Column="2" Background="Transparent" BorderThickness="0" ClipToBounds="True" Padding="0">
                    <ScrollViewer x:Name="MediaInspectorScrollViewer" Style="{DynamicResource GscPageScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <Border x:Name="MediaInspectorPanel" Style="{DynamicResource GscReadingCardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="MediaPreviewPanel" Grid.Row="0" Height="178" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource GscControlFillBrush}" Margin="0,0,0,14">
                                <Grid>
                                    <TextBlock Text="选择截图或录像可在此预览" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="14" Foreground="{DynamicResource GscSecondaryTextBrush}"/>
                                    <Image Source="{Binding SelectedMedia.ArchivePath, Converter={StaticResource MediaThumbnailConverter}}" Stretch="UniformToFill"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedMedia.Kind}" Value="{x:Static contracts:MediaKind.Screenshot}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
                                    <MediaElement Source="{Binding SelectedMedia.ArchivePath, Converter={StaticResource MediaVideoSourceConverter}}" LoadedBehavior="Play" UnloadedBehavior="Stop" IsMuted="True" Stretch="UniformToFill" ScrubbingEnabled="True"><MediaElement.Style><Style TargetType="MediaElement"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedMedia.Kind}" Value="{x:Static contracts:MediaKind.VideoClip}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></MediaElement.Style></MediaElement>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" x:Name="MediaMetadataPanel">
                                <TextBlock Text="媒体详情" Style="{DynamicResource GscSectionTitleStyle}"/>
                                <TextBlock Text="{Binding SelectedMedia.FileName, TargetNullValue=未选择媒体}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedMedia.FileName}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding SelectedMedia.ArchivePath}" Foreground="{DynamicResource GscMutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedMedia.ArchivePath}" Margin="0,4,0,0"/>
                                <Separator Margin="0,14,0,12"/>
                                <ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="收藏" OnContent="开" OffContent="关" IsChecked="{Binding MediaFavorite}" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                                <TextBlock Text="备注" Style="{DynamicResource GscCaptionStyle}" Margin="0,0,0,5"/>
                                <TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding MediaComment, UpdateSourceTrigger=PropertyChanged}" ToolTip="为选中媒体添加备注" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True"/>
                                <ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding UpdateMediaMetadataCommand}" Content="保存元数据" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                                <WrapPanel Margin="0,12,0,0"><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding OpenSelectedMediaCommand}" Content="打开" Margin="0,0,8,8"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding RevealSelectedMediaCommand}" Content="打开目录" Margin="0,0,8,8"/></WrapPanel>
                                <TextBlock Text="重新归类到" Style="{DynamicResource GscCaptionStyle}" Margin="0,8,0,5"/>
                                <ComboBox Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding Games}" SelectedItem="{Binding MediaTargetGame}" Margin="0,0,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding ReassignMediaCommand}" Content="移动并归类" HorizontalAlignment="Left"/>
                                <Separator Margin="0,14,0,12"/>
                                <TextBlock Text="批量操作" Style="{DynamicResource GscCaptionStyle}" Margin="0,0,0,7"/>
                                <WrapPanel><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding FavoriteSelectedMediaCommand}" CommandParameter="{Binding SelectedItems, ElementName=MediaGrid}" Content="收藏所选" Margin="0,0,8,8"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding UnfavoriteSelectedMediaCommand}" CommandParameter="{Binding SelectedItems, ElementName=MediaGrid}" Content="取消收藏" Margin="0,0,8,8"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding CommentSelectedMediaCommand}" CommandParameter="{Binding SelectedItems, ElementName=MediaGrid}" Content="应用当前备注" Margin="0,0,8,8"/></WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="来源规则">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ScrollViewer Style="{DynamicResource GscPageScrollViewer}" Grid.Row="0" MaxHeight="190" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                                                <TextBlock Text="添加截图或录像来源" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="共享目录中无法唯一判断所属游戏的文件会进入待归类收件箱。" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                                <UniformGrid x:Name="MediaSourceFields" Columns="2" Margin="0,0,0,4"><StackPanel Margin="0,0,12,10"><TextBlock Text="截图或录像目录" Margin="0,0,0,4"/><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding CustomMediaSourcePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="公共截图、录像或游戏媒体目录"/></StackPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="文件模式" Margin="0,0,0,4"/><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding CustomMediaPattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 *.png 或 *"/></StackPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="目录类型" Margin="0,0,0,4"/><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="共享目录" OnContent="开" OffContent="关" IsChecked="{Binding CustomMediaShared}"/></StackPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="操作" Margin="0,0,0,4"/><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding AddMediaSourceCommand}" Content="添加来源" HorizontalAlignment="Left"/></StackPanel></UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Style="{StaticResource MediaTableFrame}" MinHeight="220" MaxHeight="360" Margin="0,10,0,0"><Grid><ListBox ItemsSource="{Binding MediaSources}" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{DynamicResource GscSharedFocusVisual}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Style="{DynamicResource GscRedesignSubCard}" Padding="12"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource GscAccentTintStrongBrush}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding SourceKindDisplay}" FontWeight="SemiBold"/><TextBlock Text="{Binding RootPath}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}" Margin="0,4,0,0"/></StackPanel><WrapPanel Grid.Column="2" VerticalAlignment="Center"><ui:ToggleSwitch Style="{DynamicResource GscWpfUiToggleSwitch}" Content="启用" IsChecked="{Binding Enabled, Mode=TwoWay}" Command="{Binding DataContext.UpdateMediaSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,10,0"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding DataContext.DeleteMediaSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="移除"/></WrapPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="暂无媒体来源规则&#xA;添加公共截图或录像目录后，来源会显示在这里。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding MediaSources.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
