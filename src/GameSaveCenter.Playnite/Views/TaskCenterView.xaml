<UserControl x:Class="GameSaveCenter.Playnite.Views.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TaskLongTextCell" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="TaskDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="Transparent"/>
                <Setter Property="RowHeight" Value="50"/>
                <Setter Property="MinHeight" Value="220"/>
                <Setter Property="ColumnHeaderHeight" Value="40"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="TaskSurface" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UniformGrid x:Name="TaskSummaryPanel" Grid.Row="0" Columns="3" Margin="0,0,0,12">
            <Border Style="{DynamicResource GscRedesignMetricBorder}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource GscInfoIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" Foreground="{DynamicResource GscInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="任务总数" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Tasks.Count, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></Border>
            <Border Style="{DynamicResource GscRedesignMetricBorder}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource GscAccentIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="云端待处理" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.PendingCloudTasks, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></Border>
            <Border Style="{DynamicResource GscRedesignMetricBorder}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource GscSuccessIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Foreground="{DynamicResource GscSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="当前选中" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding SelectedTask.StateDisplay, Mode=OneWay, TargetNullValue=未选择}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.StateDisplay, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></Border>
        </UniformGrid>
        <Border Grid.Row="1" Style="{DynamicResource GscRedesignSectionCard}" Padding="14" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="任务队列" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="筛选不会取消、重排或重新执行后台任务；选择一项可查看真实错误与可恢复操作。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><WrapPanel x:Name="TaskFiltersPanel" Grid.Row="1" Margin="0,12,0,0"><ComboBox Style="{DynamicResource GscWpfUiComboBox}" Width="150" ItemsSource="{Binding TaskStatusFilterOptions}" SelectedItem="{Binding TaskStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="任务状态" Margin="0,0,8,8"/><ComboBox Style="{DynamicResource GscWpfUiComboBox}" Width="190" ItemsSource="{Binding TaskGameFilterOptions}" SelectedItem="{Binding TaskGameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="游戏筛选" Margin="0,0,8,8"/><ComboBox Style="{DynamicResource GscWpfUiComboBox}" Width="160" ItemsSource="{Binding TaskTypeFilterOptions}" SelectedItem="{Binding TaskTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="任务类型" Margin="0,0,0,8"/></WrapPanel></Grid></Border>
        <Border Grid.Row="2" Style="{DynamicResource GscSurface}">
            <DataGrid Style="{StaticResource TaskDataGrid}" ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask}" RowHeight="46" ColumnHeaderHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="本地时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="128"/>
                    <DataGridTextColumn Header="任务" Binding="{Binding TaskTypeDisplay, Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="游戏" Binding="{Binding GameName, Mode=OneWay}" Width="1.25*" MinWidth="150" ElementStyle="{StaticResource TaskLongTextCell}"/>
                    <DataGridTemplateColumn Header="状态" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Border x:Name="TaskDot" Width="7" Height="7" CornerRadius="4" Background="{DynamicResource GscWarningBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding StateDisplay, Mode=OneWay}" VerticalAlignment="Center"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding State}" Value="Succeeded"><Setter TargetName="TaskDot" Property="Background" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter TargetName="TaskDot" Property="Background" Value="{DynamicResource GscErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Running"><Setter TargetName="TaskDot" Property="Background" Value="{DynamicResource GscInfoBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter TargetName="TaskDot" Property="Background" Value="{DynamicResource GscMutedStatusBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="进度" Width="170" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="68"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><ProgressBar Height="8" MinWidth="68" HorizontalAlignment="Stretch" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="详情" Binding="{Binding DetailMessage, Mode=OneWay}" Width="1.6*" MinWidth="260" ElementStyle="{StaticResource TaskLongTextCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border x:Name="TaskDetailCard" Grid.Row="3" CornerRadius="12" Padding="14" Margin="0,10,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource TaskSurface}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0"><TextBlock FontWeight="SemiBold"><Run Text="{Binding SelectedTask.GameName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedTask.TaskTypeDisplay, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding SelectedTask.DetailMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,12,0"/><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,5,0,0"><Run Text="耗时 "/><Run Text="{Binding SelectedTask.DurationDisplay, Mode=OneWay}"/><Run Text=" · 任务 ID "/><Run Text="{Binding SelectedTask.TaskId, Mode=OneWay}"/></TextBlock></StackPanel><WrapPanel x:Name="TaskDetailActions" Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0"><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding CopyTaskErrorCommand}" Content="复制详情" Margin="0,0,8,0"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding RetryTaskCommand}" Content="安全重试" Margin="0,0,8,0"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding CancelTaskCommand}" Content="取消任务" Margin="0"/></WrapPanel></Grid></Border>
    </Grid>
</UserControl>
