<UserControl x:Class="GameSaveCenter.Playnite.Views.TaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
            </Style>
            <Style x:Key="TaskLongTextCell" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="TaskDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/>
                <Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/>
                <Setter Property="MinHeight" Value="{DynamicResource GscWorkspaceTableMinHeight}"/>
                <Setter Property="ColumnHeaderHeight" Value="{DynamicResource GscTableHeaderHeight}"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/>
            </Style>
            <Style x:Key="TaskTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <Style x:Key="TaskFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter>
            </Style>
            <Style x:Key="TaskLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}">
                <Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter>
            </Style>
            <!-- Metric cards keep the shared 84 DIP compact contract (task book: about 84,
                 never 120-150) and the standard 12px rhythm gap between cards. -->
            <Style x:Key="TaskMetricCard" TargetType="Border" BasedOn="{StaticResource GscRedesignMetricBorder}"><Setter Property="Padding" Value="12,9"/></Style>
            <Style x:Key="TaskInspectorStatusPill" TargetType="Border" BasedOn="{StaticResource GscRedesignTableStatusPill}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Succeeded"><Setter Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Failed"><Setter Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Running"><Setter Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding SelectedTask.State}" Value="Cancelled"><Setter Property="Background" Value="{DynamicResource GscControlFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscMutedStatusBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TaskSurface" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscGlassStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="TaskWorkspaceLayout" Margin="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UniformGrid x:Name="TaskSummaryPanel" Grid.Row="0" Grid.ColumnSpan="3" Columns="3" Margin="0,0,0,8">
            <Border Style="{StaticResource TaskMetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource GscInfoIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" Foreground="{DynamicResource GscInfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/></Border><StackPanel Grid.Column="1"><TextBlock Text="任务总数" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding Tasks.Count, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource TaskMetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource GscAccentIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" Foreground="{DynamicResource GscAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/></Border><StackPanel Grid.Column="1"><TextBlock Text="云端待处理" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding Snapshot.PendingCloudTasks, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource TaskMetricCard}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource GscSuccessIconFillBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Foreground="{DynamicResource GscSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/></Border><StackPanel Grid.Column="1"><TextBlock Text="当前选中" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11"/><TextBlock Text="{Binding SelectedTask.StateDisplay, Mode=OneWay, TargetNullValue=未选择}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.StateDisplay, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Grid></Border>
        </UniformGrid>
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource GscRedesignSectionCard}" Padding="10,8" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="任务队列" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="筛选不会取消、重排或重新执行后台任务；选择一项可查看真实错误与可恢复操作。" Foreground="{DynamicResource GscSecondaryTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="11"/></StackPanel><WrapPanel x:Name="TaskFiltersPanel" Grid.Row="1" Margin="0,8,0,0"><ComboBox Style="{DynamicResource GscWpfUiComboBox}" SelectedIndex="0" MinWidth="120" MaxWidth="180" ItemsSource="{Binding TaskStatusFilterOptions}" SelectedItem="{Binding TaskStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=全部, FallbackValue=全部}" ToolTip="任务状态" Margin="0,0,6,6"/><ComboBox Style="{DynamicResource GscWpfUiComboBox}" SelectedIndex="0" MinWidth="150" MaxWidth="240" ItemsSource="{Binding TaskGameFilterOptions}" SelectedItem="{Binding TaskGameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=全部, FallbackValue=全部}" ToolTip="游戏筛选" Margin="0,0,6,6"/><ComboBox Style="{DynamicResource GscWpfUiComboBox}" SelectedIndex="0" MinWidth="130" MaxWidth="210" ItemsSource="{Binding TaskTypeFilterOptions}" SelectedItem="{Binding TaskTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=全部, FallbackValue=全部}" ToolTip="任务类型" Margin="0,0,0,6"/></WrapPanel></Grid></Border>
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource TaskTableFrame}">
            <Grid>
            <DataGrid Style="{StaticResource TaskDataGrid}" ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask}">
                <DataGrid.Columns>
                    <DataGridTextColumn HeaderStyle="{StaticResource TaskFirstColumnHeader}" Header="本地时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="128"/>
                    <DataGridTextColumn Header="任务" Binding="{Binding TaskTypeDisplay, Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="游戏" Binding="{Binding GameName, Mode=OneWay}" Width="1.25*" MinWidth="140" ElementStyle="{StaticResource TaskLongTextCell}"/>
                    <DataGridTemplateColumn Header="状态" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="TaskStatusPill" Style="{DynamicResource GscRedesignTableStatusPill}"><TextBlock Text="{Binding StateDisplay, Mode=OneWay}" Foreground="{DynamicResource GscPrimaryTextBrush}" HorizontalAlignment="Center"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding State}" Value="Succeeded"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscSuccessIconFillBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscSuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Failed"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Running"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter TargetName="TaskStatusPill" Property="Background" Value="{DynamicResource GscControlFillBrush}"/><Setter TargetName="TaskStatusPill" Property="BorderBrush" Value="{DynamicResource GscMutedStatusBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="进度" Width="160" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="8,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="60"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><ProgressBar Height="8" MinWidth="60" HorizontalAlignment="Stretch" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn HeaderStyle="{StaticResource TaskLastColumnHeader}" Header="详情" Binding="{Binding DetailMessage, Mode=OneWay}" Width="1.6*" MinWidth="240" ElementStyle="{StaticResource TaskLongTextCell}"/>
                </DataGrid.Columns>
            </DataGrid>
                <TextBlock Text="暂无任务记录&#xA;完成备份、媒体同步或维护操作后，任务会显示在这里。"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TasksView.IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <ScrollViewer x:Name="TaskDetailScrollViewer" Style="{DynamicResource GscInspectorScrollViewer}" Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0">
            <Border x:Name="TaskDetailCard" CornerRadius="12" Padding="14"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource TaskSurface}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTask}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0"><TextBlock FontWeight="SemiBold"><Run Text="{Binding SelectedTask.GameName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedTask.TaskTypeDisplay, Mode=OneWay}"/></TextBlock><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="状态" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/><Border Grid.Column="1" Style="{StaticResource TaskInspectorStatusPill}" HorizontalAlignment="Left"><TextBlock Text="{Binding SelectedTask.StateDisplay, Mode=OneWay}" Foreground="{DynamicResource GscPrimaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/></Border><TextBlock Grid.Row="1" Text="开始时间" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.StartedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}, TargetNullValue=未开始}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.StartedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/><TextBlock Grid.Row="2" Text="耗时" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTask.DurationDisplay, Mode=OneWay}" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Text="任务 ID" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,8,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTask.TaskId, Mode=OneWay}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedTask.TaskId, Mode=OneWay}"/></Grid><StackPanel Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="进度" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SelectedTask.ProgressPercent, Mode=OneWay, StringFormat={}{0}%}" FontSize="11" Foreground="{DynamicResource GscSecondaryTextBrush}"/></Grid><ProgressBar Margin="0,6,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding SelectedTask.ProgressPercent, Mode=OneWay}"/></StackPanel><TextBlock Text="完整详情" FontWeight="SemiBold" Margin="0,14,0,0"/><TextBlock Text="{Binding SelectedTask.DetailMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,6,0,0"/><Border x:Name="TaskInspectorErrorCard" Margin="0,12,0,0"><Border.Style><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTask.State}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="失败详情" FontWeight="SemiBold" Foreground="{DynamicResource GscErrorBrush}"/><TextBlock Text="{Binding SelectedTask.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/><TextBlock Text="{Binding SelectedTask.ErrorCode, Mode=OneWay}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border></StackPanel><WrapPanel x:Name="TaskDetailActions" Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0"><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding CopyTaskErrorCommand}" Content="复制详情" Margin="0,0,8,0"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding RetryTaskCommand}" Content="安全重试" Margin="0,0,8,0"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding CancelTaskCommand}" Content="取消任务" Margin="0"/></WrapPanel></Grid></Border>
        </ScrollViewer>
    </Grid>
</UserControl>
