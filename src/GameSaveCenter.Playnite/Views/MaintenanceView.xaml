<UserControl x:Class="GameSaveCenter.Playnite.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GameSaveCenter.Playnite.Controls"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Keep the generated filler header inside the same theme as real columns.  The
                 Playnite host can otherwise supply its default white header for the unused
                 right edge of a DataGrid viewport. -->
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource GscSecondaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
            </Style>
            <Style x:Key="MaintenanceDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource GscTableAlternateRowBrush}"/><Setter Property="RowHeight" Value="{DynamicResource GscTableRowHeight}"/><Setter Property="MinHeight" Value="{DynamicResource GscWorkspaceTableMinHeight}"/><Setter Property="ColumnHeaderHeight" Value="{DynamicResource GscTableHeaderHeight}"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserSortColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="ScrollViewer.VerticalContentAlignment" Value="Top"/><Setter Property="ColumnHeaderStyle" Value="{StaticResource GscDataGridColumnHeaderStyle}"/>
            </Style>
            <Style x:Key="MaintenanceLongText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
            <Style x:Key="MaintenanceTableFrame" TargetType="Border" BasedOn="{StaticResource GscRedesignTableFrame}"/>
            <Style x:Key="MaintenanceFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}"><Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/><Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="MaintenanceLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GscDataGridColumnHeaderStyle}"><Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/><Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/><Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="MaintenanceTabControl" TargetType="TabControl" BasedOn="{StaticResource GscRedesignWorkspaceTabControl}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="MaintenanceTabItem" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="GscTableFrame" TargetType="Border" BasedOn="{StaticResource MaintenanceTableFrame}"/>
            <!-- Keep the alias explicit: Playnite host dictionaries can otherwise win the
                 last-column lookup and restore a white default header during a theme or
                 resize pass. -->
            <Style x:Key="GscLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaintenanceLastColumnHeader}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource GscTableHeaderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GscTableDividerBrush}"/>
            </Style>
            <Style x:Key="GscTabControl" TargetType="TabControl" BasedOn="{StaticResource MaintenanceTabControl}"/>
            <Style x:Key="GscTabItem" TargetType="TabItem" BasedOn="{StaticResource MaintenanceTabItem}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
        <TabControl Grid.Row="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Style="{StaticResource MaintenanceTabControl}">
            <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource MaintenanceTabItem}"/></TabControl.Resources>
            <TabItem Header="诊断">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarPrimaryButton}" Command="{Binding RefreshDiagnosticsCommand}" Content="刷新诊断" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding CopyDiagnosticsCommand}" Content="复制诊断" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding OpenDataDirectoryCommand}" Content="打开数据目录" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding OpenBackupDirectoryCommand}" Content="打开存档目录" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding OpenMediaDirectoryCommand}" Content="打开媒体目录" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding OpenWorkerLogCommand}" Content="Worker 日志" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <UniformGrid x:Name="DiagnosticHealthPanel" Grid.Row="1" Columns="4" Margin="0,4,0,10">
                        <Border Style="{DynamicResource GscRedesignMetricBorder}" Padding="12" Margin="0,0,8,8"><StackPanel><TextBlock Text="Worker" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="12"/><TextBlock Text="{Binding Snapshot.WorkerVersion}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding EffectiveSettings.DataDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveSettings.DataDirectory}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{DynamicResource GscRedesignMetricBorder}" Padding="12" Margin="0,0,8,8"><StackPanel><TextBlock Text="Ludusavi" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="12"/><TextBlock Text="{Binding Snapshot.LudusaviVersion}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding EffectiveSettings.LudusaviExecutable}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveSettings.LudusaviExecutable}" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{DynamicResource GscRedesignMetricBorder}" Padding="12" Margin="0,0,8,8"><StackPanel><TextBlock Text="版本策略" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="12"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"><Run Text="{Binding EffectiveSettings.BackupFormat, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding EffectiveSettings.Compression, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"><Run Text="完整 "/><Run Text="{Binding EffectiveSettings.FullBackupLimit, Mode=OneWay}"/><Run Text=" · 差异 "/><Run Text="{Binding EffectiveSettings.DifferentialBackupLimit, Mode=OneWay}"/></TextBlock></StackPanel></Border>
                        <Border Style="{DynamicResource GscRedesignMetricBorder}" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="需要关注" Foreground="{DynamicResource GscSecondaryTextBrush}" FontSize="12"/><TextBlock Text="{Binding Snapshot.WarningGames, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="路径、工具或校验建议" Foreground="{DynamicResource GscSecondaryTextBrush}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <Grid x:Name="MaintenanceDiagnosticsLayout" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource GscTableFrame}"><Grid><DataGrid x:Name="FindingsGrid" Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}"><DataGrid.Columns><DataGridTemplateColumn Header="等级" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="SeverityPill" Style="{DynamicResource GscRedesignTableStatusPill}"><TextBlock Text="{Binding SeverityDisplay, Mode=OneWay}" Foreground="{DynamicResource GscPrimaryTextBrush}" HorizontalAlignment="Center"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Severity}" Value="Info"><Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/><Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="170"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="190"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" MinWidth="300"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn HeaderStyle="{StaticResource MaintenanceLastColumnHeader}" Header="建议处理" Binding="{Binding SuggestedAction}" Width="0.75*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid><TextBlock Text="当前没有需要处理的诊断项。&#xA;Worker、备份和媒体状态正常时，这里会保持为空。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Findings.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
                        <Expander x:Name="MaintenanceDiagnosticDetails" Grid.Column="2" Style="{DynamicResource GscExpander}" Header="查看完整诊断信息" Margin="0"><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding DiagnosticSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></Expander>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="设备状态">
                <Grid x:Name="MaintenanceDeviceLayout" Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <WrapPanel Grid.ColumnSpan="3"><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SyncDeviceStatesCommand}" Content="刷新设备状态"/></WrapPanel>
                    <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource GscRedesignSubCard}" Margin="0,10,0,0"><StackPanel><TextBlock Text="只读多设备摘要" FontWeight="SemiBold"/><TextBlock Text="{Binding DeviceStateMessage, TargetNullValue=尚未同步设备摘要}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Grid.Row="2" Grid.Column="0" Style="{DynamicResource GscTableFrame}" Margin="0,10,0,0"><Grid><DataGrid x:Name="MaintenanceDeviceGrid" Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding DeviceComparisons}" SelectedItem="{Binding SelectedDeviceComparison}"><DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="150"/><DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="其他设备" Binding="{Binding RemoteDevice}" Width="130"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="原因" Binding="{Binding ReasonDisplay}" Width="260"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="人工决策" Binding="{Binding DecisionDisplay}" Width="130"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn HeaderStyle="{StaticResource MaintenanceLastColumnHeader}" Header="建议" Binding="{Binding SuggestedBackupId}" Width="200"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid><TextBlock Text="暂无设备冲突记录。&#xA;同步设备摘要后，有差异的游戏会显示在这里。" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscEmptyStateText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DeviceComparisons.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
                    <StackPanel x:Name="MaintenanceDeviceInspector" Grid.Row="2" Grid.Column="2" Margin="0,10,0,0"><ScrollViewer x:Name="MaintenanceDeviceDecisionScrollViewer" Style="{DynamicResource GscInspectorScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="150"><Border Style="{DynamicResource GscRedesignSubCard}" Padding="12"><StackPanel><TextBlock Text="人工决策" Style="{DynamicResource GscSectionTitleStyle}"/><ComboBox Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding DeviceDecisionOptions}" SelectedItem="{Binding DeviceDecision}" Margin="0,12,0,8"/><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding DeviceDecisionComment, UpdateSourceTrigger=PropertyChanged}" MinHeight="64" MaxHeight="120" ToolTip="仅记录判断依据"/><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SaveDeviceDecisionCommand}" Content="保存决策" Margin="0,12,0,0"/></StackPanel></Border></ScrollViewer><ScrollViewer x:Name="MaintenanceRemoteRestoreScrollViewer" Style="{DynamicResource GscInspectorScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="210" Margin="0,10,0,0"><Border Style="{DynamicResource GscRedesignSubCard}" Padding="12"><StackPanel><TextBlock Text="受保护的远端恢复" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="{Binding StagedRemoteBackupStatus}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/><Border Style="{DynamicResource GscRedesignInfoBand}" Padding="10" Margin="0,12,0,0"><TextBlock Text="先下载并校验，再创建当前快照并恢复；不会直接覆盖或删除远端。" Foreground="{DynamicResource GscInfoBrush}" TextWrapping="Wrap"/></Border><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding StageRemoteBackupCommand}" Content="1. 下载并校验" Margin="0,12,0,0"/><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding RestoreStagedRemoteBackupCommand}" Content="2. 创建快照并恢复" Margin="0,8,0,0"/></StackPanel></Border></ScrollViewer></StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="保留策略">
                <ScrollViewer Style="{DynamicResource GscPageScrollViewer}" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel MaxWidth="1050" HorizontalAlignment="Left">
                        <Border Style="{DynamicResource GscReadingCardStyle}" Padding="18">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="当前游戏保留策略只读预览" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="只显示 Worker 的安全建议，不执行删除，也不会改变已锁定版本。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                                    <ui:Button Grid.Column="1" Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding PreviewRetentionCommand}" Content="刷新预览"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=尚未选择游戏}" Style="{DynamicResource GscBodyStyle}" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.Name}"/>
                                <Border Style="{DynamicResource GscRedesignInfoBand}" Padding="12" Margin="0,12,0,0"><TextBlock Text="{Binding RetentionSummary, TargetNullValue=尚未生成保留预览。请先选择游戏并刷新。}" Foreground="{DynamicResource GscInfoBrush}" TextWrapping="Wrap"/></Border>
                                <UniformGrid Columns="3" Margin="0,14,0,0">
                                    <Border Style="{DynamicResource GscRedesignSubCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="预计保留" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Text="{Binding LastRetentionPreview.KeepBackupIds.Count, TargetNullValue=—}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="个版本" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Style="{DynamicResource GscRedesignSubCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="候选清理" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Text="{Binding LastRetentionPreview.DeleteCandidateIds.Count, TargetNullValue=—}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="当前仅预览" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Style="{DynamicResource GscRedesignSubCard}"><StackPanel><TextBlock Text="安全边界" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Text="只读" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="不会自动删除" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0"/></StackPanel></Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{DynamicResource GscReadingCardStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="预计保留明细" Style="{DynamicResource GscSectionTitleStyle}"/>
                                    <TextBlock Text="刷新预览后显示建议保留的版本。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0"/>
                                    <ItemsControl ItemsSource="{Binding LastRetentionPreview.KeepBackupIds}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource GscRedesignSubCard}" Padding="10" Margin="0,0,0,6"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="暂无保留明细，点击“刷新预览”生成。" Margin="0,10,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscCaptionStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LastRetentionPreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding LastRetentionPreview.KeepBackupIds.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{DynamicResource GscReadingCardStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="候选清理明细" Style="{DynamicResource GscSectionTitleStyle}"/>
                                    <TextBlock Text="锁定版本永不进入候选清理，预览只读不会执行删除。" Style="{DynamicResource GscCaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding LastRetentionPreview.DeleteCandidateIds}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource GscRedesignSubCard}" Padding="10" Margin="0,0,0,6"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="当前无候选清理。" Margin="0,10,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource GscCaptionStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LastRetentionPreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding LastRetentionPreview.DeleteCandidateIds.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="异常与审计">
                <Grid x:Name="MaintenanceAuditLayout" Margin="0,12,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Column="0" Style="{DynamicResource GscTableFrame}">
                        <DataGrid x:Name="MaintenanceAuditFindingsGrid" Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}">
                            <DataGrid.Columns><DataGridTemplateColumn Header="等级" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="SeverityPill" Style="{DynamicResource GscRedesignTableStatusPill}"><TextBlock Text="{Binding SeverityDisplay, Mode=OneWay}" Foreground="{DynamicResource GscPrimaryTextBrush}" HorizontalAlignment="Center"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Severity}" Value="Info"><Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource GscInfoIconFillBrush}"/><Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource GscInfoBrush}"/></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource GscSafetyFillBrush}"/><Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource GscWarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger><DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter TargetName="SeverityPill" Property="Background" Value="{DynamicResource GscErrorTintBrush}"/><Setter TargetName="SeverityPill" Property="BorderBrush" Value="{DynamicResource GscErrorBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="180"/><DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="190"/><DataGridTextColumn HeaderStyle="{DynamicResource GscLastColumnHeader}" Header="详情" Binding="{Binding Detail}" Width="*" MinWidth="320"/></DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <ScrollViewer x:Name="MaintenanceAuditInspector" Grid.Column="2" Style="{DynamicResource GscInspectorScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{DynamicResource GscRedesignSectionCard}" Padding="14"><StackPanel><TextBlock Text="诊断详情" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="{Binding SelectedFinding.Title, TargetNullValue=选择一条诊断项查看详情}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding SelectedFinding.Detail, TargetNullValue=暂无详细说明}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,10,0,0"/><Border Style="{DynamicResource GscRedesignInfoBand}" Padding="10" Margin="0,12,0,0"><TextBlock Text="{Binding SelectedFinding.SuggestedAction, TargetNullValue=暂无建议处理方式}" Foreground="{DynamicResource GscInfoBrush}" TextWrapping="Wrap"/></Border></StackPanel></Border>
                            <Border Style="{DynamicResource GscRedesignSubCard}" Padding="12" Margin="0,10,0,0" ClipToBounds="True"><StackPanel><TextBlock Text="最近审计" Style="{DynamicResource GscSectionTitleStyle}"/><DataGrid x:Name="MaintenanceAuditLogGrid" Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding Audit}" MinHeight="140" MaxHeight="280" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="112"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100"/><DataGridTextColumn HeaderStyle="{StaticResource MaintenanceLastColumnHeader}" Header="消息" Binding="{Binding Message}" Width="*" MinWidth="170"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="进程映射">
                <Grid x:Name="MaintenanceProcessLayout" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="{StaticResource GscInspectorWidth}"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <WrapPanel x:Name="ProcessMappingEditor" Grid.ColumnSpan="3"><TextBox Style="{DynamicResource GscWpfUiTextBox}" MinWidth="220" Text="{Binding ProcessMappingExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入 EXE 文件名，例如 skse64.exe" Margin="0,0,8,8"/><ComboBox Style="{DynamicResource GscWpfUiComboBox}" MinWidth="220" ItemsSource="{Binding Games}" SelectedItem="{Binding ProcessMappingTargetGame}" Margin="0,0,8,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SaveProcessMappingCommand}" Content="绑定"/></WrapPanel>
                    <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource GscTableFrame}"><DataGrid Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding ProcessMappings}" SelectedItem="{Binding SelectedProcessMapping}"><DataGrid.Columns><DataGridTextColumn Header="EXE" Binding="{Binding ExecutableName}" Width="220"/><DataGridTextColumn Header="目标游戏" Binding="{Binding GameName}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTemplateColumn HeaderStyle="{StaticResource MaintenanceLastColumnHeader}" Header="操作" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding DataContext.DeleteProcessMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="删除"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
                    <Border x:Name="MaintenanceProcessInspector" Grid.Row="1" Grid.Column="2" Style="{DynamicResource GscRedesignSectionCard}" Padding="16"><StackPanel><TextBlock Text="映射详情" Style="{DynamicResource GscSectionTitleStyle}"/><TextBlock Text="进程映射只用于识别未知进程或 MOD 启动器，不会通过 UI 误杀游戏进程。" Style="{DynamicResource GscCaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/><Separator Margin="0,14,0,12"/><TextBlock Text="EXE 文件名" Style="{DynamicResource GscCaptionStyle}"/><TextBlock Text="{Binding SelectedProcessMapping.ExecutableName, TargetNullValue=尚未选择映射}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProcessMapping.ExecutableName}" Margin="0,4,0,0"/><TextBlock Text="目标游戏" Style="{DynamicResource GscCaptionStyle}" Margin="0,14,0,0"/><TextBlock Text="{Binding SelectedProcessMapping.GameName, TargetNullValue=尚未选择游戏}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProcessMapping.GameName}" Margin="0,4,0,0"/><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding DeleteProcessMappingCommand}" CommandParameter="{Binding SelectedProcessMapping}" Content="删除选中映射" Margin="0,18,0,0" HorizontalAlignment="Left"/></StackPanel></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
