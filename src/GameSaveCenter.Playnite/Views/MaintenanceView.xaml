<UserControl x:Class="GameSaveCenter.Playnite.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource GscPrimaryTextBrush}"
             TextElement.Foreground="{DynamicResource GscPrimaryTextBrush}"
             Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/DesignTokens.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/WpfUiProduction.xaml"/>
                <ResourceDictionary Source="/GameSaveCenter.Playnite;component/Themes/Redesign.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MaintenanceDataGrid" TargetType="DataGrid">
                <Setter Property="Foreground" Value="{DynamicResource GscPrimaryTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="Transparent"/><Setter Property="RowHeight" Value="44"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserSortColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="MaintenanceLongText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
            <Style x:Key="MaintenanceTableFrame" TargetType="Border"><Setter Property="Background" Value="{DynamicResource GscGlassFillBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GscControlStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="1"/></Style>
            <Style x:Key="MaintenanceFirstColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Tag"><Setter.Value><CornerRadius>11,0,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="MaintenanceLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Tag"><Setter.Value><CornerRadius>0,11,0,0</CornerRadius></Setter.Value></Setter></Style>
            <Style x:Key="MaintenanceTabControl" TargetType="TabControl" BasedOn="{StaticResource GscRedesignWorkspaceTabControl}"/>
            <Style x:Key="MaintenanceTabItem" TargetType="TabItem" BasedOn="{StaticResource GscRedesignWorkspaceTabItem}"/>
            <Style x:Key="GscTableFrame" TargetType="Border" BasedOn="{StaticResource MaintenanceTableFrame}"/>
            <Style x:Key="GscLastColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaintenanceLastColumnHeader}"/>
            <Style x:Key="GscTabControl" TargetType="TabControl" BasedOn="{StaticResource MaintenanceTabControl}"/>
            <Style x:Key="GscTabItem" TargetType="TabItem" BasedOn="{StaticResource MaintenanceTabItem}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <TabControl Style="{StaticResource MaintenanceTabControl}">
            <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource MaintenanceTabItem}"/></TabControl.Resources>
            <TabItem Header="诊断">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarPrimaryButton}" Command="{Binding RefreshDiagnosticsCommand}" Content="刷新诊断" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding CopyDiagnosticsCommand}" Content="复制诊断" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding OpenDataDirectoryCommand}" Content="打开数据目录" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding OpenBackupDirectoryCommand}" Content="打开存档目录" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding OpenMediaDirectoryCommand}" Content="打开媒体目录" Margin="0,0,8,8"/>
                        <ui:Button Style="{DynamicResource GscWpfUiToolbarButton}" Command="{Binding OpenWorkerLogCommand}" Content="Worker 日志" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <UniformGrid x:Name="DiagnosticHealthPanel" Grid.Row="1" Columns="4" Margin="0,4,0,10">
                        <Border Style="{DynamicResource GscRedesignMetricBorder}" Padding="14" Margin="0,0,8,8"><StackPanel><TextBlock Text="Worker" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.WorkerVersion}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding EffectiveSettings.DataDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveSettings.DataDirectory}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{DynamicResource GscRedesignMetricBorder}" Padding="14" Margin="0,0,8,8"><StackPanel><TextBlock Text="Ludusavi" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.LudusaviVersion}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding EffectiveSettings.LudusaviExecutable}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EffectiveSettings.LudusaviExecutable}" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{DynamicResource GscRedesignMetricBorder}" Padding="14" Margin="0,0,8,8"><StackPanel><TextBlock Text="版本策略" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"><Run Text="{Binding EffectiveSettings.BackupFormat, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding EffectiveSettings.Compression, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"><Run Text="完整 "/><Run Text="{Binding EffectiveSettings.FullBackupLimit, Mode=OneWay}"/><Run Text=" · 差异 "/><Run Text="{Binding EffectiveSettings.DifferentialBackupLimit, Mode=OneWay}"/></TextBlock></StackPanel></Border>
                        <Border Style="{DynamicResource GscRedesignMetricBorder}" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="需要关注" Foreground="{DynamicResource GscSecondaryTextBrush}"/><TextBlock Text="{Binding Snapshot.WarningGames, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="路径、工具或校验建议" Foreground="{DynamicResource GscSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{DynamicResource GscTableFrame}"><DataGrid x:Name="FindingsGrid" Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}"><DataGrid.Columns><DataGridTextColumn Header="等级" Binding="{Binding Severity}" Width="75"/><DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="170"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="190"/><DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" MinWidth="300"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn HeaderStyle="{DynamicResource GscLastColumnHeader}" Header="建议处理" Binding="{Binding SuggestedAction}" Width="1.1*" MinWidth="240"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource MaintenanceLongText}"/></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Border>
                        <Expander Grid.Row="1" Header="查看完整诊断信息" Margin="0,10,0,0"><Border Style="{DynamicResource GscSurface}" Padding="12"><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding DiagnosticSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/></Border></Expander>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="设备状态">
                <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SyncDeviceStatesCommand}" Content="刷新设备状态"/></WrapPanel>
                    <Border Grid.Row="1" Style="{DynamicResource GscSurface}" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="只读多设备摘要" FontWeight="SemiBold"/><TextBlock Text="{Binding DeviceStateMessage, TargetNullValue=尚未同步设备摘要}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                    <Border Grid.Row="2" Style="{DynamicResource GscTableFrame}" Margin="0,10,0,0"><DataGrid Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding DeviceComparisons}" SelectedItem="{Binding SelectedDeviceComparison}"><DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding StateDisplay}" Width="150"/><DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="*" MinWidth="180"/><DataGridTextColumn Header="其他设备" Binding="{Binding RemoteDevice}" Width="130"/><DataGridTextColumn Header="原因" Binding="{Binding ReasonDisplay}" Width="260"/><DataGridTextColumn Header="人工决策" Binding="{Binding DecisionDisplay}" Width="130"/><DataGridTextColumn HeaderStyle="{DynamicResource GscLastColumnHeader}" Header="建议" Binding="{Binding SuggestedBackupId}" Width="200"/></DataGrid.Columns></DataGrid></Border>
                    <Border Grid.Row="3" Style="{DynamicResource GscSurface}" Padding="12" Margin="0,10,0,0"><WrapPanel><TextBlock Text="决策：" VerticalAlignment="Center"/><ComboBox Style="{DynamicResource GscWpfUiComboBox}" ItemsSource="{Binding DeviceDecisionOptions}" SelectedItem="{Binding DeviceDecision}" Width="150" Margin="4,0,8,0"/><TextBox Style="{DynamicResource GscWpfUiTextBox}" Text="{Binding DeviceDecisionComment, UpdateSourceTrigger=PropertyChanged}" MinWidth="260" ToolTip="仅记录判断依据" Margin="0,0,8,0"/><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SaveDeviceDecisionCommand}" Content="保存决策"/></WrapPanel></Border>
                    <Border Grid.Row="4" Style="{DynamicResource GscSurface}" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="受保护的远端恢复" FontWeight="SemiBold"/><TextBlock Text="{Binding StagedRemoteBackupStatus}" TextWrapping="Wrap" Foreground="{DynamicResource GscSecondaryTextBrush}" Margin="0,4,0,10"/><WrapPanel><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding StageRemoteBackupCommand}" Content="1. 下载并校验" Margin="0,0,8,0"/><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding RestoreStagedRemoteBackupCommand}" Content="2. 创建快照并恢复"/></WrapPanel></StackPanel></Border>
                </Grid>
            </TabItem>
            <TabItem Header="异常与审计">
                <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{DynamicResource GscTableFrame}"><DataGrid Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}"><DataGrid.Columns><DataGridTextColumn Header="等级" Binding="{Binding Severity}" Width="75"/><DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="180"/><DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="190"/><DataGridTextColumn HeaderStyle="{DynamicResource GscLastColumnHeader}" Header="详情" Binding="{Binding Detail}" Width="*" MinWidth="320"/></DataGrid.Columns></DataGrid></Border>
                    <Border Grid.Row="1" Style="{DynamicResource GscTableFrame}" Margin="0,10,0,0"><DataGrid Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding Audit}"><DataGrid.Columns><DataGridTextColumn Header="本地时间" Binding="{Binding CreatedLocal, Mode=OneWay, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="128"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="110"/><DataGridTextColumn HeaderStyle="{DynamicResource GscLastColumnHeader}" Header="消息" Binding="{Binding Message}" Width="*" MinWidth="340"/></DataGrid.Columns></DataGrid></Border>
                </Grid>
            </TabItem>
            <TabItem Header="进程映射">
                <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel><TextBox Style="{DynamicResource GscWpfUiTextBox}" MinWidth="220" Text="{Binding ProcessMappingExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入 EXE 文件名，例如 skse64.exe" Margin="0,0,8,8"/><ComboBox Style="{DynamicResource GscWpfUiComboBox}" MinWidth="220" ItemsSource="{Binding Games}" SelectedItem="{Binding ProcessMappingTargetGame}" Margin="0,0,8,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ui:Button Style="{DynamicResource GscWpfUiPrimaryActionButton}" Command="{Binding SaveProcessMappingCommand}" Content="绑定"/></WrapPanel>
                    <Border Grid.Row="1" Style="{DynamicResource GscTableFrame}"><DataGrid Style="{StaticResource MaintenanceDataGrid}" ItemsSource="{Binding ProcessMappings}" SelectedItem="{Binding SelectedProcessMapping}"><DataGrid.Columns><DataGridTextColumn Header="EXE" Binding="{Binding ExecutableName}" Width="220"/><DataGridTextColumn Header="目标游戏" Binding="{Binding GameName}" Width="*"/><DataGridTemplateColumn HeaderStyle="{DynamicResource GscLastColumnHeader}" Header="操作" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Button Style="{DynamicResource GscWpfUiContextButton}" Command="{Binding DataContext.DeleteProcessMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="删除"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
